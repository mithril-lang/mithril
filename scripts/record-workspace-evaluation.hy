"Save bounded coding receipts and an honest aggregate evaluation, not entire repositories or session state."
(import argparse pathlib json shutil statistics)
(setv parser (argparse.ArgumentParser))
(.add-argument parser "--final" :required True)
(.add-argument parser "--pilot" :required True)
(.add-argument parser "--environment" :required True)
(.add-argument parser "--destination" :required True)
(setv args (.parse-args parser) source (pathlib.Path args.final) destination (pathlib.Path args.destination)
      rows (json.loads (.read-text (/ source "runs.json")))
      summary (json.loads (.read-text (/ source "summary.json"))))
(when (!= (len rows) 18) (raise (ValueError "Require all 18 completed final episodes")))
(.mkdir destination :parents True :exist-ok False)
(for [name ["runs.json" "summary.json"]] (shutil.copyfile (/ source name) (/ destination name)))
(for [row rows]
  (setv label (+ (get row "task") "-" (str (get row "repeat")) "-" (get row "mode")))
  (shutil.copyfile (pathlib.Path (get row "receipt")) (/ destination (+ label ".json")))
  (when (= (get row "mode") "clef")
    (shutil.copyfile (/ source label "session/edit-intent.edn") (/ destination (+ label "-edit.edn")))))
(for [[prefix directory] [["pilot" args.pilot] ["environment" args.environment]]]
  (setv pilot-rows (json.loads (.read-text (/ (pathlib.Path directory) "runs.json")))
        selected (lfor r pilot-rows :if (and (= (get r "repeat") 0) (= (get r "mode") "clef")) r))
  (.write-text (/ destination (+ prefix "-runs.json")) (json.dumps selected :indent 2))
  (for [row selected]
    (shutil.copyfile (pathlib.Path (get row "receipt")) (/ destination (+ prefix "-" (get row "task") ".json")))))
(setv metrics {})
(for [mode ["replay" "clef"]]
  (setv rs (lfor r rows :if (= (get r "mode") mode) r)
        successes (lfor r rs :if (get r "success") r)
        timings (lfor r successes (get r "end_to_end_seconds")))
  (setv combined (dict (get (get summary "summaries") mode)))
  (.update combined
    {"successful_median_seconds" (if timings (statistics.median timings) None)
     "successful_min_seconds" (if timings (min timings) None)
     "successful_max_seconds" (if timings (max timings) None)
     "input_tokens_median" (statistics.median (lfor r rs (get r "input_tokens")))
     "model_wall_median_seconds" (statistics.median (lfor r rs (get r "model_wall_seconds")))
     "actual_model_forwards" (sum (lfor r rs (get r "model_turns")))
     "host_singleton_decisions" (sum (lfor r rs (get r "host_singleton_decisions")))})
  (setv (get metrics mode) combined))
(.write-text (/ destination "metrics.json") (json.dumps metrics :indent 2))
(print (json.dumps metrics :indent 2))
