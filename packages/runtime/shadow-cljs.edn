;; @mithril-lang/runtime: the Mithril language as one plain ESM module.
;; build/shadow-src is generated by scripts/build.mjs (.cljk mirrored as .cljc);
;; ../../src and ../../vendor/src supply the namespaces already published as .cljc.
{:source-paths ["src" "build/shadow-src" "../../src" "../../vendor/src"]
 :dependencies []
 :builds
 {:runtime {:target :esm
            :output-dir "build/esm"
            :js-options {:js-provider :import}
            :modules {:runtime {:exports {compileApp mithril.runtime.api/compileApp
                                          appAgentLibrary mithril.runtime.api/appAgentLibrary
                                          version mithril.runtime.api/version
                                          sourceSha mithril.runtime.api/source-sha
                                          runBatch mithril.runtime.system-one/runBatch
                                          runSecurityBatch mithril.runtime.system-one/runSecurityBatch
                                          compileNative mithril.runtime.system-one/compileNative}}}
            ;; :simple like the app Worker it replaces: host objects are reached by name.
            ;; :parallel-build false keeps gensym numbering, and so the bytes, reproducible.
            :compiler-options {:output-feature-set :es2020 :optimizations :simple
                               :parallel-build false}
            :release {:compiler-options {:optimizations :simple}}}}}
