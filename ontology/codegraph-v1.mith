(mithril/ontology
  :id "https://mithril.fund/ontology/codegraph-v1"
  :profile ["https://www.w3.org/TR/rdf11-concepts/" "https://www.w3.org/TR/owl2-profiles/#OWL_2_RL" "https://www.w3.org/TR/shacl/"]
  :graph [
    (owl/class :id "https://mithril.fund/ns/codegraph/v1#File")
    (owl/class :id "https://mithril.fund/ns/codegraph/v1#Definition")
    (owl/class :id "https://mithril.fund/ns/codegraph/v1#Function" :rdfs/sub-class-of "https://mithril.fund/ns/codegraph/v1#Definition")
    (owl/class :id "https://mithril.fund/ns/codegraph/v1#Macro" :rdfs/sub-class-of "https://mithril.fund/ns/codegraph/v1#Definition")
    (owl/class :id "https://mithril.fund/ns/codegraph/v1#Test" :rdfs/sub-class-of "https://mithril.fund/ns/codegraph/v1#Definition")
    (owl/class :id "https://mithril.fund/ns/codegraph/v1#Document" :rdfs/sub-class-of "https://mithril.fund/ns/codegraph/v1#Definition")
    (owl/class :id "https://mithril.fund/ns/codegraph/v1#Section" :rdfs/sub-class-of "https://mithril.fund/ns/codegraph/v1#Document")
    (owl/class :id "https://mithril.fund/ns/codegraph/v1#Entity" :rdfs/sub-class-of "https://mithril.fund/ns/codegraph/v1#Definition")
    (owl/datatype-property :id "https://mithril.fund/ns/codegraph/v1#locationPrecision")
    (owl/class :id "https://mithril.fund/ns/codegraph/v1#Edge")
    (owl/object-property :id "https://mithril.fund/ns/codegraph/v1#source")
    (owl/object-property :id "https://mithril.fund/ns/codegraph/v1#target")
    (owl/object-property :id "https://mithril.fund/ns/codegraph/v1#file")
    (owl/datatype-property :id "https://mithril.fund/ns/codegraph/v1#name")
    (owl/datatype-property :id "https://mithril.fund/ns/codegraph/v1#path")
    (owl/datatype-property :id "https://mithril.fund/ns/codegraph/v1#sourceDigest")
    (owl/datatype-property :id "https://mithril.fund/ns/codegraph/v1#relation")
    (owl/datatype-property :id "https://mithril.fund/ns/codegraph/v1#provenance")
    (owl/datatype-property :id "https://mithril.fund/ns/codegraph/v1#startLine")
    (owl/datatype-property :id "https://mithril.fund/ns/codegraph/v1#startColumn")
    (owl/datatype-property :id "https://mithril.fund/ns/codegraph/v1#endLine")
    (owl/datatype-property :id "https://mithril.fund/ns/codegraph/v1#endColumn")
    (shacl/node-shape :id "https://mithril.fund/ns/codegraph/v1#FileShape" :sh/target-class "https://mithril.fund/ns/codegraph/v1#File" :sh/property [
      (shacl/property-shape :sh/path "https://mithril.fund/ns/codegraph/v1#path" :sh/min-count 1 :sh/max-count 1)
      (shacl/property-shape :sh/path "https://mithril.fund/ns/codegraph/v1#sourceDigest" :sh/min-count 1 :sh/max-count 1)
    ])
    (shacl/node-shape :id "https://mithril.fund/ns/codegraph/v1#DefinitionShape" :sh/target-class "https://mithril.fund/ns/codegraph/v1#Definition" :sh/property [
      (shacl/property-shape :sh/path "https://mithril.fund/ns/codegraph/v1#name" :sh/min-count 1 :sh/max-count 1)
      (shacl/property-shape :sh/path "https://mithril.fund/ns/codegraph/v1#file" :sh/min-count 1 :sh/max-count 1)
      (shacl/property-shape :sh/path "https://mithril.fund/ns/codegraph/v1#startLine" :sh/min-count 1 :sh/max-count 1 :sh/datatype "http://www.w3.org/2001/XMLSchema#integer" :sh/min-inclusive 1)
      (shacl/property-shape :sh/path "https://mithril.fund/ns/codegraph/v1#startColumn" :sh/min-count 1 :sh/max-count 1 :sh/datatype "http://www.w3.org/2001/XMLSchema#integer" :sh/min-inclusive 1)
      (shacl/property-shape :sh/path "https://mithril.fund/ns/codegraph/v1#endLine" :sh/min-count 1 :sh/max-count 1 :sh/datatype "http://www.w3.org/2001/XMLSchema#integer" :sh/min-inclusive 1)
      (shacl/property-shape :sh/path "https://mithril.fund/ns/codegraph/v1#endColumn" :sh/min-count 1 :sh/max-count 1 :sh/datatype "http://www.w3.org/2001/XMLSchema#integer" :sh/min-inclusive 1)
    ])
    (shacl/node-shape :id "https://mithril.fund/ns/codegraph/v1#EdgeShape" :sh/target-class "https://mithril.fund/ns/codegraph/v1#Edge" :sh/property [
      (shacl/property-shape :sh/path "https://mithril.fund/ns/codegraph/v1#source" :sh/min-count 1 :sh/max-count 1)
      (shacl/property-shape :sh/path "https://mithril.fund/ns/codegraph/v1#target" :sh/min-count 1 :sh/max-count 1)
      (shacl/property-shape :sh/path "https://mithril.fund/ns/codegraph/v1#relation" :sh/min-count 1 :sh/max-count 1)
      (shacl/property-shape :sh/path "https://mithril.fund/ns/codegraph/v1#provenance" :sh/min-count 1 :sh/max-count 1)
      (shacl/property-shape :sh/path "https://mithril.fund/ns/codegraph/v1#file" :sh/min-count 1 :sh/max-count 1)
      (shacl/property-shape :sh/path "https://mithril.fund/ns/codegraph/v1#startLine" :sh/min-count 1 :sh/max-count 1 :sh/datatype "http://www.w3.org/2001/XMLSchema#integer" :sh/min-inclusive 1)
      (shacl/property-shape :sh/path "https://mithril.fund/ns/codegraph/v1#startColumn" :sh/min-count 1 :sh/max-count 1 :sh/datatype "http://www.w3.org/2001/XMLSchema#integer" :sh/min-inclusive 1)
      (shacl/property-shape :sh/path "https://mithril.fund/ns/codegraph/v1#endLine" :sh/min-count 1 :sh/max-count 1 :sh/datatype "http://www.w3.org/2001/XMLSchema#integer" :sh/min-inclusive 1)
      (shacl/property-shape :sh/path "https://mithril.fund/ns/codegraph/v1#endColumn" :sh/min-count 1 :sh/max-count 1 :sh/datatype "http://www.w3.org/2001/XMLSchema#integer" :sh/min-inclusive 1)
    ])
  ])
