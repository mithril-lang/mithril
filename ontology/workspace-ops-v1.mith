        :sh/path "https://mithril.fund/ns/workspace-ops/v1#validTo"
        :sh/datatype "http://www.w3.org/2001/XMLSchema#string"
        :sh/pattern "^-?[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        :sh/min-count 0 :sh/max-count 1)
      (shacl/property-shape
        :sh/path "https://mithril.fund/ns/workspace-ops/v1#workspace"
        :sh/class "https://mithril.fund/ns/workspace-ops/v1#Workspace"
        :sh/min-count 1 :sh/max-count 1)])

   ;; ---- Evidence ----
   ;; Subclasses bot-domain:Fact; the Fact `name` field is pinned
   ;; explicitly below (target-class does not climb subclasses).
   ;; evidenceKind + workspace are the added constraints. Evidence
   ;; values are CI/test/production-verification outcomes, never
   ;; secret values.
   (owl/class :id "https://mithril.fund/ns/workspace-ops/v1#Evidence"
     :rdfs/sub-class-of "https://mithril.fund/ns/bot-domain/v1#Fact")
   (owl/datatype-property :id "https://mithril.fund/ns/workspace-ops/v1#evidenceKind"
     :rdfs/domain "https://mithril.fund/ns/workspace-ops/v1#Evidence")
   (shacl/node-shape
     :id "https://mithril.fund/ns/workspace-ops/v1#EvidenceShape"
     :sh/target-class "https://mithril.fund/ns/workspace-ops/v1#Evidence"
     :sh/property
     [(shacl/property-shape
        :sh/path "https://mithril.fund/ns/workspace-ops/v1#name"
        :sh/datatype "http://www.w3.org/2001/XMLSchema#string"
        :sh/min-count 1 :sh/max-count 1)
      (shacl/property-shape
        :sh/path "https://mithril.fund/ns/workspace-ops/v1#evidenceKind"
        :sh/datatype "http://www.w3.org/2001/XMLSchema#string"
        :sh/in [(rdf/literal "ci") (rdf/literal "test") (rdf/literal "production-verification") (rdf/literal "manual-approval")]
        :sh/min-count 1 :sh/max-count 1)
      (shacl/property-shape
        :sh/path "https://mithril.fund/ns/workspace-ops/v1#workspace"
        :sh/class "https://mithril.fund/ns/workspace-ops/v1#Workspace"
        :sh/min-count 1 :sh/max-count 1)])])
