        :sh/min-count 1 :sh/max-count 1)])
   (shacl/node-shape
     :id "https://mithril.fund/ns/workspace-ops/v1#RouteShape"
     :sh/target-class "https://mithril.fund/ns/workspace-ops/v1#Route"
     :sh/property
     [(shacl/property-shape
        :sh/path "https://mithril.fund/ns/workspace-ops/v1#routeHost"
