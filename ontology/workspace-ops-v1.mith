   ;; DriftCheck IS-A bot-domain Run by entailment; its Run-fields
   ;; are pinned explicitly below (see reuse note). This shape adds
   ;; the drift fields.
   (shacl/node-shape
     :id "https://mithril.fund/ns/workspace-ops/v1#DriftCheckShape"
