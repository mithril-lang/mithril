   (owl/object-property :id "https://mithril.fund/ns/workspace-ops/v1#schedule"
     :rdfs/domain "https://mithril.fund/ns/workspace-ops/v1#Automation"
     :rdfs/range "https://mithril.fund/ns/workspace-ops/v1#Schedule")
   (owl/object-property :id "https://mithril.fund/ns/workspace-ops/v1#declaredConfig"
     :rdfs/domain "https://mithril.fund/ns/workspace-ops/v1#DriftCheck"
     :rdfs/range "https://mithril.fund/ns/workspace-ops/v1#DeclaredConfig")
   (owl/object-property :id "https://mithril.fund/ns/workspace-ops/v1#observedState"
     :rdfs/domain "https://mithril.fund/ns/workspace-ops/v1#DriftCheck"
     :rdfs/range "https://mithril.fund/ns/workspace-ops/v1#ObservedState")
   (shacl/node-shape
     :id "https://mithril.fund/ns/workspace-ops/v1#BotShape"
     :sh/target-class "https://mithril.fund/ns/workspace-ops/v1#Bot"
     :sh/property
     [(shacl/property-shape
        :sh/path "https://mithril.fund/ns/workspace-ops/v1#name"
        :sh/datatype "http://www.w3.org/2001/XMLSchema#string"
        :sh/min-count 1 :sh/max-count 1)
      (shacl/property-shape
        :sh/path "https://mithril.fund/ns/workspace-ops/v1#workspace"
        :sh/class "https://mithril.fund/ns/workspace-ops/v1#Workspace"
        :sh/min-count 1 :sh/max-count 1)
      (shacl/property-shape
        :sh/path "https://mithril.fund/ns/workspace-ops/v1#runsAutomation"
        :sh/class "https://mithril.fund/ns/workspace-ops/v1#Automation"
        :sh/min-count 0 :sh/max-count 8192)])
   (shacl/node-shape
     :id "https://mithril.fund/ns/workspace-ops/v1#AutomationShape"
     :sh/target-class "https://mithril.fund/ns/workspace-ops/v1#Automation"
     :sh/property
     [(shacl/property-shape
        :sh/path "https://mithril.fund/ns/workspace-ops/v1#name"
        :sh/datatype "http://www.w3.org/2001/XMLSchema#string"
        :sh/min-count 1 :sh/max-count 1)
      (shacl/property-shape
        :sh/path "https://mithril.fund/ns/workspace-ops/v1#workspace"
        :sh/class "https://mithril.fund/ns/workspace-ops/v1#Workspace"
        :sh/min-count 1 :sh/max-count 1)
      (shacl/property-shape
        :sh/path "https://mithril.fund/ns/workspace-ops/v1#automationEnabled"
        :sh/datatype "http://www.w3.org/2001/XMLSchema#boolean"
        :sh/min-count 0 :sh/max-count 1)
      (shacl/property-shape
        :sh/path "https://mithril.fund/ns/workspace-ops/v1#schedule"
