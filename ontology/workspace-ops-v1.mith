   (shacl/node-shape
     :id "https://mithril.fund/ns/workspace-ops/v1#SecretRefShape"
     :sh/target-class "https://mithril.fund/ns/workspace-ops/v1#SecretRef"
     :sh/closed true
     :sh/ignored-properties ["http://www.w3.org/1999/02/22-rdf-syntax-ns#type"]
