          :condition (mithril/local :name "cached")
          :then (mithril/local :name "cached")
          :else (mithril/if
           :condition (mithril/host-method
            :object (mithril/host-import :name "Array")
            :key (mithril/literal :datatype "js-value" :value "isArray")
            :args [(mithril/local :name "source")]
