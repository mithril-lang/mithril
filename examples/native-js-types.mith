        :condition (mithril/host-method
         :object (mithril/host-import :name "ArrayBuffer")
         :key (mithril/literal :datatype "js-value" :value "isView")
         :args [(mithril/local :name "source")]
        )
        :then (mithril/host-method
         :object (mithril/host-get
          :object (mithril/local :name "source")
          :key (mithril/literal :datatype "js-value" :value "buffer")
         )
         :key (mithril/literal :datatype "js-value" :value "slice")
         :args [
          (mithril/host-get
           :object (mithril/local :name "source")
           :key (mithril/literal :datatype "js-value" :value "byteOffset")
          )
          (mithril/host-binary
           :operator "+"
           :left (mithril/host-get
            :object (mithril/local :name "source")
            :key (mithril/literal :datatype "js-value" :value "byteOffset")
           )
           :right (mithril/host-get
            :object (mithril/local :name "source")
            :key (mithril/literal :datatype "js-value" :value "byteLength")
           )
          )
         ]
        )
        :else (mithril/let
         :bindings [
          (rdf/node
           :name "cached"
           :value (mithril/host-method
            :object (mithril/local :name "refs")
            :key (mithril/literal :datatype "js-value" :value "get")
            :args [(mithril/local :name "source")]
