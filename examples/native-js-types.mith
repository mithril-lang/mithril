              (mithril/host-method
               :object (mithril/local :name "source")
               :key (mithril/literal :datatype "js-value" :value "forEach")
               :args [
                (mithril/native-lambda
                 :params ["value" "index"]
                 :body (mithril/sequence
                  :expressions [
                   (mithril/host-set
                    :object (mithril/local :name "result")
                    :key (mithril/local :name "index")
                    :value (mithril/host-method
                     :object (mithril/host-import :name "Reflect")
                     :key (mithril/literal :datatype "js-value" :value "apply")
