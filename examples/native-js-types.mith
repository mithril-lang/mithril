     :else (mithril/host-method
      :object (mithril/host-method
       :object (mithril/host-import :name "Array")
       :key (mithril/literal :datatype "js-value" :value "from")
       :args [
        (mithril/host-construct
         :constructor (mithril/host-import :name "Uint8Array")
