     ]
    )
    :else (mithril/host-method
     :object (mithril/host-import :name "Uint8Array")
     :key (mithril/literal :datatype "js-value" :value "from")
     :args [
      (mithril/host-invoke
       :function (mithril/host-import :name "atob")
       :args [(mithril/local :name "source")]
      )
      (mithril/native-lambda
       :params ["c"]
       :body (mithril/host-method
        :object (mithril/local :name "c")
        :key (mithril/literal :datatype "js-value" :value "charCodeAt")
        :args [(mithril/literal :datatype "js-value" :value 0)]
       )
      )
     ]
    )
   )
  )
  (mithril/function
   :name "toHex"
   :params [(rdf/node :name "source" :datatype "js-value")]
   :returns "js-value"
   :body (mithril/let
    :bindings [
     (rdf/node
      :name "source"
      :value (mithril/call :name "fromSource" :args [(mithril/local :name "source")])
     )
    ]
    :body (mithril/if
     :condition (mithril/host-binary
      :operator "!=="
      :left (mithril/host-unary :operator "typeof" :value (mithril/host-import :name "Buffer"))
      :right (mithril/literal :datatype "js-value" :value "undefined")
