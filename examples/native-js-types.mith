      :key (mithril/literal :datatype "js-value" :value "toString")
      :args [(mithril/literal :datatype "js-value" :value "base64")]
     )
     :else (mithril/let
      :bindings [
       (rdf/node :name "binary" :value (mithril/literal :datatype "js-value" :value "") :mutable true)
       (rdf/node
        :name "bytes"
        :value (mithril/host-construct
         :constructor (mithril/host-import :name "Uint8Array")
         :args [(mithril/local :name "source")]
        )
        :mutable true
       )
       (rdf/node :name "i" :value (mithril/literal :datatype "js-value" :value 0) :mutable true)
      ]
      :body (mithril/host-while
       :condition (mithril/host-binary
        :operator "<"
        :left (mithril/local :name "i")
        :right (mithril/host-get
         :object (mithril/local :name "bytes")
         :key (mithril/literal :datatype "js-value" :value "byteLength")
        )
       )
       :body (mithril/sequence
        :expressions [
         (mithril/local-set
          :name "binary"
          :value (mithril/host-binary
           :operator "+"
           :left (mithril/local :name "binary")
           :right (mithril/host-method
            :object (mithril/host-import :name "String")
            :key (mithril/literal :datatype "js-value" :value "fromCharCode")
            :args [(mithril/host-get :object (mithril/local :name "bytes") :key (mithril/local :name "i"))]
           )
