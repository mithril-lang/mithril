  (mithril/function
   :name "deepEqual"
   :params [
    (rdf/node :name "a" :datatype "js-value")
    (rdf/node :name "b" :datatype "js-value")
    (rdf/node :name "strict" :datatype "js-value")
   ]
   :returns "js-value"
   :body (mithril/let
