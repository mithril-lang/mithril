          :right (mithril/literal :datatype "js-value" :value 2)
         )
         :right (mithril/literal :datatype "js-value" :value 0)
        )
        :then (mithril/local :name "source")
        :else (mithril/host-method
         :object (mithril/local :name "source")
         :key (mithril/literal :datatype "js-value" :value "slice")
         :args [
          (mithril/literal :datatype "js-value" :value 0)
          (mithril/host-binary
           :operator "-"
           :left (mithril/host-get
            :object (mithril/local :name "source")
            :key (mithril/literal :datatype "js-value" :value "length")
           )
           :right (mithril/literal :datatype "js-value" :value 1)
          )
         ]
        )
       )
       :mutable true
      )
      (rdf/node :name "buffer" :value (mithril/host-array :items []) :mutable true)
      (rdf/node :name "i" :value (mithril/literal :datatype "js-value" :value 0) :mutable true)
     ]
     :body (mithril/host-while
      :condition (mithril/host-binary
       :operator "<"
       :left (mithril/local :name "i")
       :right (mithril/host-get
        :object (mithril/local :name "hex")
        :key (mithril/literal :datatype "js-value" :value "length")
       )
      )
      :body (mithril/sequence
       :expressions [
        (mithril/host-method
         :object (mithril/local :name "buffer")
         :key (mithril/literal :datatype "js-value" :value "push")
         :args [
          (mithril/host-invoke
