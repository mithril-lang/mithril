           :then (mithril/let
            :bindings [(rdf/node :name "result" :value (mithril/host-array :items []))]
            :body (mithril/sequence
             :expressions [
              (mithril/host-method
               :object (mithril/local :name "refs")
               :key (mithril/literal :datatype "js-value" :value "set")
               :args [(mithril/local :name "source") (mithril/local :name "result")]
