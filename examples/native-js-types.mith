       :condition (mithril/call :name "isArrayBufferLike" :args [(mithril/local :name "source")])
       :then (mithril/host-method
        :object (mithril/local :name "source")
        :key (mithril/literal :datatype "js-value" :value "slice")
        :args [(mithril/literal :datatype "js-value" :value 0)]
