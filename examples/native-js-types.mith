; CosmoKit types.ts whole runtime, expressed in Mithril native JS host forms.
(mithril/native-js-module
 :name "cosmokit.types"
 :imports [
  "globalThis"
  "Object"
  "ArrayBuffer"
  "Uint8Array"
  "Buffer"
  "String"
  "btoa"
  "atob"
  "parseInt"
  "Date"
  "RegExp"
  "Map"
  "Array"
  "Reflect"
  "Set"
  "isNullable"
  "isVolatile"
 ]
 :functions [
  (mithril/function
   :name "is"
   :params [(rdf/node :name "type" :datatype "js-value") (rdf/node :name "value" :datatype "js-value")]
   :returns "js-value"
   :body (mithril/if
    :condition (mithril/host-binary
     :operator "==="
     :left (mithril/host-arguments-length )
     :right (mithril/literal :datatype "js-value" :value 1)
    )
    :then (mithril/native-lambda
     :params ["value"]
     :body (mithril/call :name "is" :args [(mithril/local :name "type") (mithril/local :name "value")])
    )
    :else (mithril/host-logical
     :operator "||"
     :left (mithril/host-logical
      :operator "&&"
      :left (mithril/host-binary
       :operator "in"
       :left (mithril/local :name "type")
       :right (mithril/host-import :name "globalThis")
      )
      :right (mithril/host-binary
       :operator "instanceof"
       :left (mithril/local :name "value")
       :right (mithril/host-get :object (mithril/host-import :name "globalThis") :key (mithril/local :name "type"))
      )
     )
     :right (mithril/host-binary
      :operator "==="
      :left (mithril/host-method
       :object (mithril/host-method
        :object (mithril/host-get
         :object (mithril/host-get
          :object (mithril/host-import :name "Object")
          :key (mithril/literal :datatype "js-value" :value "prototype")
         )
         :key (mithril/literal :datatype "js-value" :value "toString")
        )
        :key (mithril/literal :datatype "js-value" :value "call")
        :args [(mithril/local :name "value")]
       )
       :key (mithril/literal :datatype "js-value" :value "slice")
       :args [(mithril/literal :datatype "js-value" :value 8) (mithril/literal :datatype "js-value" :value -1)]
      )
      :right (mithril/local :name "type")
     )
    )
   )
  )
  (mithril/function
   :name "isArrayBufferLike"
   :params [(rdf/node :name "value" :datatype "js-value")]
   :returns "js-value"
   :body (mithril/host-logical
    :operator "||"
    :left (mithril/call
     :name "is"
     :args [(mithril/literal :datatype "js-value" :value "ArrayBuffer") (mithril/local :name "value")]
    )
    :right (mithril/call
     :name "is"
     :args [(mithril/literal :datatype "js-value" :value "SharedArrayBuffer") (mithril/local :name "value")]
    )
   )
  )
  (mithril/function
   :name "isArrayBufferSource"
   :params [(rdf/node :name "value" :datatype "js-value")]
   :returns "js-value"
   :body (mithril/host-logical
    :operator "||"
    :left (mithril/call :name "isArrayBufferLike" :args [(mithril/local :name "value")])
    :right (mithril/host-method
     :object (mithril/host-import :name "ArrayBuffer")
     :key (mithril/literal :datatype "js-value" :value "isView")
     :args [(mithril/local :name "value")]
    )
   )
  )
  (mithril/function
   :name "fromSource"
   :params [(rdf/node :name "source" :datatype "js-value")]
   :returns "js-value"
   :body (mithril/if
    :condition (mithril/host-method
     :object (mithril/host-import :name "ArrayBuffer")
     :key (mithril/literal :datatype "js-value" :value "isView")
     :args [(mithril/local :name "source")]
    )
    :then (mithril/host-method
     :object (mithril/host-get
      :object (mithril/local :name "source")
      :key (mithril/literal :datatype "js-value" :value "buffer")
     )
     :key (mithril/literal :datatype "js-value" :value "slice")
     :args [
      (mithril/host-get
       :object (mithril/local :name "source")
       :key (mithril/literal :datatype "js-value" :value "byteOffset")
      )
      (mithril/host-binary
       :operator "+"
       :left (mithril/host-get
        :object (mithril/local :name "source")
        :key (mithril/literal :datatype "js-value" :value "byteOffset")
       )
       :right (mithril/host-get
        :object (mithril/local :name "source")
        :key (mithril/literal :datatype "js-value" :value "byteLength")
       )
      )
     ]
    )
    :else (mithril/local :name "source")
   )
  )
  (mithril/function
   :name "toBase64"
   :params [(rdf/node :name "source" :datatype "js-value")]
   :returns "js-value"
   :body (mithril/let
    :bindings [
     (rdf/node
      :name "source"
      :value (mithril/call :name "fromSource" :args [(mithril/local :name "source")])
     )
    ]
    :body (mithril/if
     :condition (mithril/host-binary
      :operator "!=="
      :left (mithril/host-unary :operator "typeof" :value (mithril/host-import :name "Buffer"))
      :right (mithril/literal :datatype "js-value" :value "undefined")
     )
     :then (mithril/host-method
      :object (mithril/host-method
       :object (mithril/host-import :name "Buffer")
       :key (mithril/literal :datatype "js-value" :value "from")
       :args [(mithril/local :name "source")]
