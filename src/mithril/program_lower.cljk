(ns mithril.program-lower
  "Lower JSON-LD Mithril Programs for Amu's native selfhost compiler."
  (:require [clojure.string :as str]
            [mithril.compiler :as compiler]
            [mithril.module-lower :as module-lower]))

(defn lower-native-program-text
  "Compile a JSON-LD Mithril Program to an Amu-native OaK transaction module.

  The checked transaction crosses the native boundary as inert EDN text."
  [path text]
  (let [artifact (compiler/compile-text path text)
        transaction (:transaction artifact)
        transaction-edn (pr-str transaction)
        literal (pr-str transaction-edn)
        module-text (str
                     "(mithril/module :name \"mithril.oak_program\" "
                     ":exports [\"transaction_edn\"] :functions ["
                     "(mithril/function :name \"transaction_edn\" :params [] "
                     ":returns \"string\" :body (mithril/literal "
                     ":datatype \"string\" :value " literal "))])")
        lowered (module-lower/lower-native-text module-text)
        source (:source lowered)
        header-end (str/index-of source "\n")
        header (subs source 0 (inc header-end))
        body (subs source (inc header-end))
        source (str (str/replace header
                                 "(:export [__mithril_f0])"
                                 "(:export [__mithril_f0 __mithril_admit_edn])")
                    body
                    "(defn __mithril_admit_edn [__mithril_input :string] :bool "
                    "(let [__mithril_tx (document-edn-read __mithril_input) "
                    "__mithril_version (option-value-of [:option :document] "
                    "(document-vector-at __mithril_tx 0) (document-null))] "
                    "(and (= (document-count __mithril_tx) 4) "
                    "(document-equal? __mithril_version "
                    "(document-keyword :oak.transaction/v1)))))\n")
        runtime-cases [{:export "admit_edn" :args [transaction-edn] :expected 1}
                       {:export "admit_edn"
                        :args [(pr-str (assoc transaction 0 :oak.transaction/v2))]
                        :expected 0}
                       {:export "admit_edn" :args [(pr-str (subvec transaction 0 3))]
                        :expected 0}]]
    (assoc lowered
           :source source
           :exports (conj (:exports lowered)
                          {:name "admit_edn" :symbol "__mithril_admit_edn"})
           :abi (conj (:abi lowered)
                      {:name "admit_edn" :symbol "__mithril_admit_edn"
                       :params [:string] :returns :bool})
           :format :mithril.program/amu-native-source-v1
           :source-kind :mithril/program
           :program-format (:format artifact)
           :transaction-edn transaction-edn
           :native-execution-cases runtime-cases
           :graph-digest (:graph-digest artifact))))

