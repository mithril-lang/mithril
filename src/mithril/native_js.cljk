(ns mithril.native-js
  "Checked inert Mithril source with explicit host imports and native JS values.
   This backend preserves host call/iterator/closure semantics; it has no guest
   word ABI or runtime fuel ledger and is not the restricted Amu guest profile."
  (:require [clojure.string :as str]
            [mithril.form :as form]
            [mithril.module :as module]))

(def ^:private reserved
  #{"await" "break" "case" "catch" "class" "const" "continue" "debugger"
    "default" "delete" "do" "else" "enum" "export" "extends" "false" "finally"
    "for" "function" "if" "implements" "import" "in" "instanceof" "interface"
    "let" "new" "null" "package" "private" "protected" "public" "return"
    "static" "super" "switch" "this" "throw" "true" "try" "typeof" "var"
    "void" "while" "with" "yield" "arguments" "eval"})
(defn- fail! [code detail]
  (throw (ex-info detail {:mithril/error code :detail detail})))
(defn- shape! [value fields]
  (when-not (and (map? value) (= (set fields) (set (keys value))))
    (fail! :mithril.native-js/shape "Unexpected or missing native JS module fields")))
(defn- optional-flag! [value required flag]
  (shape! value (if (contains? value flag) (conj (vec required) flag) required))
  (when (and (contains? value flag) (not (boolean? (get value flag))))
    (fail! :mithril.native-js/shape "Optional native declaration flags must be boolean")))
(defn- optional-flags! [value required flags]
  (shape! value (into (vec required) (filter #(contains? value %) flags)))
  (doseq [flag flags :when (contains? value flag)]
    (when-not (boolean? (get value flag))
      (fail! :mithril.native-js/shape "Optional native function flags must be boolean"))))
(defn- vector! [value bound]
  (when-not (vector? value) (fail! :mithril.native-js/shape "Expected a vector"))
  (when (> (count value) bound)
    (fail! :mithril.native-js/budget "Native JS source collection exceeds its budget")))
(defn- name! [name]
  (when-not (and (string? name) (re-matches #"[A-Za-z_][A-Za-z0-9_]*" name))
    (fail! :mithril.native-js/name "Invalid native JS identifier"))
  name)
(defn- unique! [names]
  (when-not (= (count names) (count (set names)))
    (fail! :mithril.native-js/duplicate "Duplicate native JS declaration")))
;; Binding patterns are inert data. Their keys/defaults become checked expressions
;; only after the complete lexical/parameter environment has been established.
(defn- binding-names [slot] (if (string? slot) [slot] (:names slot)))
(defn- binding-pattern! [raw]
  (let [budget (atom 0)]
  (letfn [(walk [p depth]
            (when (or (> depth 64) (> (swap! budget inc) 4096)) (fail! :mithril.native-js/budget "Binding pattern depth/node budget exceeded"))
            (let [child #(walk % (inc depth))]
              (cond
                (string? p) {:op :binding-name :name (name! p) :names [p]}
                (not (map? p)) (fail! :mithril.native-js/shape "Expected a binding pattern")
                (contains? p "binding")
                (do (shape! p ["binding" "default"])
                    (let [target (child (get p "binding"))]
                      {:op :binding-default :target target :raw-default (get p "default") :names (:names target)}))
                (contains? p "array")
                (do (shape! p (cond-> ["array"] (contains? p "rest") (conj "rest")))
                    (vector! (get p "array") 64)
                    (let [items (mapv #(when (some? %) (child %)) (get p "array"))
                          rest (when (contains? p "rest") (child (get p "rest")))]
                      (when (= :binding-default (:op rest)) (fail! :mithril.native-js/shape "Rest cannot have a default"))
                      {:op :binding-array :items items :rest rest
                       :names (vec (concat (mapcat :names items) (:names rest)))}))
                (contains? p "object")
                (do (shape! p (cond-> ["object"] (contains? p "rest") (conj "rest")))
                    (vector! (get p "object") 64)
                    (let [properties (mapv (fn [entry]
                                             (optional-flag! entry ["key" "pattern"] "computed")
                                             {:raw-key (get entry "key") :computed (get entry "computed") :target (child (get entry "pattern"))}) (get p "object"))
                          rest (when (contains? p "rest") (child (get p "rest")))]
                      (when (and rest (not= :binding-name (:op rest)))
                        (fail! :mithril.native-js/shape "Object rest requires a binding identifier"))
                      {:op :binding-object :properties properties :rest rest
                       :names (vec (concat (mapcat #(get-in % [:target :names]) properties) (:names rest)))}))
                :else (fail! :mithril.native-js/shape "Unknown binding pattern"))))]
    (let [pattern (walk raw 0)]
      (vector! (:names pattern) 64) (unique! (:names pattern)) pattern))))
(defn- params! [params]
  (vector! params 64)
  (let [names (mapv (fn [p]
                     (optional-flag! p (cond-> [(if (contains? p "pattern") "pattern" "name") "datatype"] (contains? p "default") (conj "default")) "mutable")
                     (when-not (= "js-value" (get p "datatype"))
                       (fail! :mithril.native-js/type "Native JS parameters use js-value"))
                     (if (contains? p "pattern")
                       (let [pattern (binding-pattern! (get p "pattern"))]
                         (when (and (= :binding-default (:op pattern)) (contains? p "default"))
                           (fail! :mithril.native-js/shape "Duplicate parameter default")) pattern)
                       (name! (get p "name")))) params)]
    (unique! (mapcat binding-names names)) names))
(defn- parameter-env [locals params names rest-name]
  (cond-> (into locals (mapcat (fn [p slot] (map #(vector % (true? (get p "mutable"))) (binding-names slot))) params names))
    (some? rest-name) (assoc rest-name false)))
(defn- literal! [value]
  (when-not (or (nil? value) (string? value) (boolean? value)
                (and (number? value) (js/Number.isFinite value)))
    (fail! :mithril.native-js/literal "Native literals must be finite JSON primitives"))
  value)
(defn- pattern! [p]
  (if (string? p)
    {:op :name :names [(name! p)]}
    (let [array? (contains? p "array")
          fields (if array? ["array"] ["name"])]
      (optional-flag! p (cond-> fields (contains? p "default") (conj "default")) "mutable")
      (if array?
        (let [names (get p "array")]
          (vector! names 64)
          (cond-> {:op :array :names (mapv name! names)}
            (contains? p "mutable") (assoc :mutable (get p "mutable"))))
        (cond-> {:op :name :names [(name! (get p "name"))]}
          (contains? p "mutable") (assoc :mutable (get p "mutable")))))))

(defn- regexp! [pattern flags]
  (when-not (and (string? pattern) (string? flags))
    (fail! :mithril.native-js/shape "Native regex pattern and flags must be strings"))
  (when (> (count pattern) 4096)
    (fail! :mithril.native-js/budget "Native regex pattern exceeds its source budget"))
  ;; The compiler validates and canonicalizes data. Runtime output remains a
  ;; literal: fresh current-realm intrinsic value with no constructor grant.
  (try
    (let [regex (js/RegExp. pattern flags)]
      {:op :regexp :source (.-source regex) :flags (.-flags regex)})
    (catch :default _
      (fail! :mithril.native-js/regexp "Invalid native regex pattern or flags"))))

(defn- context? [context flag]
  (if (map? context) (true? (get context flag))
      (and (true? context) (contains? #{:function :this :new-target} flag))))
(defn- value-context [context]
  (if (map? context) (assoc context :statement false) context))
(defn- suspension-context [context async? generator?]
  (assoc (if (map? context) context
             (if (true? context) {:function true :this true :new-target true} {}))
         :await (true? async?) :yield (true? generator?)))
(defn- coroutine-bindings! [names context]
  (when (and (or (context? context :await) (context? context :yield))
             (some #{"await" "yield"} names))
    (fail! :mithril.native-js/name "Reserved coroutine binding")))
(defn- body-context [context statements? return?]
  (if statements?
    (assoc (if (map? context) context
               (if (true? context) {:function true :this true :new-target true} {}))
           :statement true :source-return return? :loop false :switch false)
    (value-context context)))
(defn- loop-context [context]
  (if (context? context :statement) (assoc context :loop true) (value-context context)))
(declare expression!)
(defn- check-binding-pattern [pattern imports functions env depth nodes context]
  (when (or (> depth 64) (> (swap! nodes inc) 4096))
    (fail! :mithril.native-js/budget "Binding pattern budget exceeded"))
  (let [child #(check-binding-pattern % imports functions env (inc depth) nodes context)
        value #(expression! % imports functions env (inc depth) nodes (value-context context))]
    (case (:op pattern)
      :binding-name pattern
      :binding-default (-> pattern (dissoc :raw-default)
                           (assoc :target (child (:target pattern)) :default (value (:raw-default pattern))))
      :binding-array (assoc pattern :items (mapv #(when % (child %)) (:items pattern))
                                   :rest (when (:rest pattern) (child (:rest pattern))))
      :binding-object (assoc pattern :properties (mapv (fn [p] (let [key (value (:raw-key p))
                                                                     literal-key? (and (= :literal (:op key)) (or (string? (:value key)) (number? (:value key))))
                                                                     computed (if (some? (:computed p)) (:computed p) (not literal-key?))]
                                                                 (when (and (not computed) (not literal-key?)) (fail! :mithril.native-js/shape "Static pattern key must be a literal string or number"))
                                                                 {:key key :computed computed :target (child (:target p))})) (:properties pattern))
                                    :rest (when (:rest pattern) (child (:rest pattern)))))))
(defn- check-parameter-patterns [slots imports functions env depth nodes context]
  (mapv #(if (string? %) % (check-binding-pattern % imports functions env depth nodes (suspension-context context false false))) slots))
(defn- class-signature! [member imports functions locals depth nodes context]
  (let [params (get member "params") names (params! params) rest-name (get member "rest")]
    (when (some? rest-name)
      (name! rest-name)
      (when (contains? reserved rest-name) (fail! :mithril.native-js/name "Reserved rest binding")))
    (let [names-with-rest (cond-> (vec (mapcat binding-names names)) (some? rest-name) (conj rest-name))
          _ (unique! names-with-rest)
          _ (coroutine-bindings! names-with-rest context)
          env (parameter-env locals params names rest-name)
          defaults (into {} (keep-indexed
                            (fn [i p] (when (contains? p "default")
                                        [i (expression! (get p "default") imports functions env (inc depth) nodes (suspension-context context false false))])) params))]
      (cond-> {:params (check-parameter-patterns names imports functions env (inc depth) nodes context) :rest rest-name
               :body (expression! (get member "body") imports functions env (inc depth) nodes (body-context context (get member "statements") true))}
        (seq defaults) (assoc :defaults defaults)
        (contains? member "statements") (assoc :statements (get member "statements"))
        (contains? member "async") (assoc :async (get member "async"))
        (contains? member "generator") (assoc :generator (get member "generator"))))))
(defn- class-items! [items imports functions locals depth nodes context]
  (vector! items 64)
  (mapv (fn [item]
          (let [kind (cond
                       (and (map? item) (= #{"value"} (set (keys item)))) :value
                       (and (map? item) (= #{"spread"} (set (keys item)))) :spread
                       :else (fail! :mithril.native-js/shape "Super call item requires value or spread"))]
            {:kind kind :value (expression! (get item (name kind)) imports functions locals (inc depth) nodes (value-context context))})) items))

(defn- expression! [expr imports functions locals depth nodes args-length]
  (when (or (> depth 64) (> (swap! nodes inc) 4096))
    (fail! :mithril.native-js/budget "Native JS expression budget exceeded"))
  (when-not (map? expr) (fail! :mithril.native-js/shape "Expected a native expression"))
  ;; Expression-only statement forms use an ordinary compiler arrow. Suspension
  ;; cannot cross that frame: refuse it rather than change timing with a coroutine
  ;; helper. Direct source statement bodies keep their own coroutine context.
  (let [args-length (if (or (= "LocalFunction" (get expr "@type"))
                           (and (not (context? args-length :statement))
                                (contains? #{"Let" "HostWhile" "HostDoWhile" "HostForOf" "HostForIn" "HostSwitch" "HostFor" "HostBindingLet" "HostThrow" "HostTryCatch" "HostTryFinally"} (get expr "@type"))))
                      (suspension-context args-length false false) args-length)
        check #(expression! % imports functions locals (inc depth) nodes (value-context args-length))
        body-check #(expression! % imports functions locals (inc depth) nodes args-length)
        args! (fn [args]
                (vector! args 64)
                (mapv check args))]
    (case (get expr "@type")
      "Literal"
      (do (shape! expr ["@type" "datatype" "value"])
          (when-not (= "js-value" (get expr "datatype"))
            (fail! :mithril.native-js/type "Native literals use js-value"))
          {:op :literal :value (literal! (get expr "value"))})
      "HostImportMeta"
      (do (shape! expr ["@type"])
          {:op :import-meta})
      "HostDynamicImport"
      (do (shape! expr (cond-> ["@type" "source"] (contains? expr "options") (conj "options")))
          (cond-> {:op :dynamic-import :source (check (get expr "source"))}
            (contains? expr "options") (assoc :options (check (get expr "options")))))
      "Local"
      (do (shape! expr ["@type" "name"])
          (let [name (name! (get expr "name"))]
            (when-not (contains? locals name)
              (fail! :mithril.native-js/local "Unknown native JS local"))
            {:op :local :name name}))
      "HostImport"
      (do (shape! expr ["@type" "name"])
          (let [name (name! (get expr "name"))]
            (when-not (contains? imports name)
              (fail! :mithril.native-js/import "Undeclared host import"))
            {:op :import :name name}))
      "FunctionRef"
      (do (shape! expr ["@type" "name"])
          (let [name (name! (get expr "name"))]
            (when-not (contains? functions name)
              (fail! :mithril.native-js/function "Unknown native function"))
            {:op :function-ref :name name}))
      "FunctionSet"
      (do (shape! expr ["@type" "name" "value"])
          (let [name (name! (get expr "name"))]
            (when-not (true? (get functions name))
              (fail! :mithril.native-js/function "FunctionSet requires an explicitly mutable module function"))
            (when (contains? locals name)
              (fail! :mithril.native-js/scope "FunctionSet target is shadowed by a local or native self binding"))
            {:op :function-set :name name :value (check (get expr "value"))}))
      "Call"
      (do (shape! expr ["@type" "name" "args"])
          (let [name (name! (get expr "name")) args (args! (get expr "args"))]
            (when-not (contains? functions name)
              (fail! :mithril.native-js/function "Unknown native function"))
            ;; Native calls keep JS missing/extra argument behavior. Runtime
            ;; function values are neither inspected nor prevalidated.
            {:op :call :name name :args args}))
      "HostOptionalGet"
      (do (shape! expr ["@type" "object" "key"])
          {:op :optional-get :object (check (get expr "object")) :key (check (get expr "key"))})
      "HostOptionalChain"
      (do (shape! expr ["@type" "base" "steps"])
          (let [steps (get expr "steps")]
            (vector! steps 64)
            (when (or (empty? steps) (not-any? #(true? (get % "optional")) steps))
              (fail! :mithril.native-js/shape "Optional chain requires a nonempty chain with an optional step"))
            {:op :optional-chain :base (check (get expr "base"))
             :steps (mapv (fn [step]
                            (when-not (boolean? (get step "optional"))
                              (fail! :mithril.native-js/shape "Optional chain step flag must be boolean"))
                            (case (get step "kind")
                              "get" (do (shape! step ["kind" "optional" "key"])
                                        {:kind :get :optional (get step "optional") :key (check (get step "key"))})
                              "call" (do (shape! step ["kind" "optional" "items"])
                                         {:kind :call :optional (get step "optional")
                                          :items (class-items! (get step "items") imports functions locals depth nodes args-length)})
                              (fail! :mithril.native-js/shape "Unknown optional chain step"))) steps)}))
      "HostGet"
      (do (shape! expr ["@type" "object" "key"])
          {:op :get :object (check (get expr "object")) :key (check (get expr "key"))})
      "HostInvoke"
      (do (shape! expr ["@type" "function" "args"])
          {:op :invoke :function (check (get expr "function")) :args (args! (get expr "args"))})
      "HostOptionalInvoke"
      (do (shape! expr ["@type" "function" "args"])
          {:op :optional-invoke :function (check (get expr "function")) :args (args! (get expr "args"))})
      "HostInvokeItems"
      (do (shape! expr ["@type" "function" "items"])
          (vector! (get expr "items") 64)
          {:op :invoke-items :function (check (get expr "function"))
           :items (class-items! (get expr "items") imports functions locals depth nodes args-length)})
      "HostOptionalInvokeItems"
      (do (shape! expr ["@type" "function" "items"])
          (vector! (get expr "items") 64)
          {:op :optional-invoke-items :function (check (get expr "function"))
           :items (class-items! (get expr "items") imports functions locals depth nodes args-length)})
      "HostMethod"
      (do (shape! expr ["@type" "object" "key" "args"])
          {:op :method :object (check (get expr "object")) :key (check (get expr "key"))
           :args (args! (get expr "args"))})
      "HostRegExp"
      (do (shape! expr ["@type" "pattern" "flags"])
          (regexp! (get expr "pattern") (get expr "flags")))
      "HostMethodItems"
      (do (shape! expr ["@type" "object" "key" "items"])
          (let [items (get expr "items")]
            (vector! items 64)
            {:op :method-items :object (check (get expr "object"))
             :key (check (get expr "key"))
             :items (mapv (fn [item]
                            (cond
                              (and (map? item) (= #{"value"} (set (keys item))))
                              {:kind :value :value (check (get item "value"))}
                              (and (map? item) (= #{"spread"} (set (keys item))))
                              {:kind :spread :value (check (get item "spread"))}
                              :else (fail! :mithril.native-js/shape
                                           "HostMethodItems entries need exactly value or spread"))) items)}))
      "HostUndefined"
      (do (shape! expr ["@type"]) {:op :undefined})
      "HostArguments"
      (do (shape! expr ["@type"])
          (when-not (context? args-length :function)
            (fail! :mithril.native-js/scope "HostArguments requires a source normal function context"))
          {:op :arguments})
      "HostArgumentsLength"
      (do (shape! expr ["@type"])
          (when-not (context? args-length :function)
            (fail! :mithril.native-js/scope "HostArgumentsLength requires a source normal function context"))
          {:op :arguments-length})
      "HostThis"
      (do (shape! expr ["@type"])
          (when-not (context? args-length :this)
            (fail! :mithril.native-js/scope "HostThis requires a source normal function context"))
          {:op :this})
      "HostNewTarget"
      (do (shape! expr ["@type"])
          (when-not (context? args-length :new-target)
            (fail! :mithril.native-js/scope "HostNewTarget requires a source normal function context"))
          {:op :new-target})
      "HostSuperCall"
      (do (shape! expr ["@type" "items"])
          (when-not (context? args-length :super-call)
            (fail! :mithril.native-js/scope "Super call requires a derived class constructor"))
          {:op :super-call :items (class-items! (get expr "items") imports functions locals depth nodes args-length)})
      "HostSuperGet"
      (do (shape! expr ["@type" "key"])
          (when-not (context? args-length :super-property)
            (fail! :mithril.native-js/scope "Super property requires a class member context"))
          {:op :super-get :key (check (get expr "key"))})
      "HostSuperSet"
      (do (shape! expr ["@type" "key" "value"])
          (when-not (context? args-length :super-property)
            (fail! :mithril.native-js/scope "Super property requires a class member context"))
          {:op :super-set :key (check (get expr "key")) :value (check (get expr "value"))})
      "HostSuperMethod"
      (do (shape! expr ["@type" "key" "items"])
          (when-not (context? args-length :super-property)
            (fail! :mithril.native-js/scope "Super method requires a class member context"))
          {:op :super-method :key (check (get expr "key"))
           :items (class-items! (get expr "items") imports functions locals depth nodes args-length)})
      "HostUnary"
      (do (shape! expr ["@type" "operator" "value"])
          (let [operator (get expr "operator")]
            (when-not (contains? #{"!" "typeof" "+" "-" "~" "void"} operator)
              (fail! :mithril.native-js/operator "Unsupported native unary operator"))
            {:op :unary :operator operator :value (check (get expr "value"))}))
      "HostBinary"
      (do (shape! expr ["@type" "operator" "left" "right"])
          (let [operator (get expr "operator")]
            (when-not (contains? #{"==" "!=" "===" "!==" ">=" ">" "in" "instanceof" "+" "-" "%" "<" "<=" "*" "/" "<<" ">>" ">>>" "&" "|" "^"} operator)
              (fail! :mithril.native-js/operator "Unsupported native binary operator"))
            {:op :binary :operator operator :left (check (get expr "left"))
             :right (check (get expr "right"))}))
      "HostConstruct"
      (do (shape! expr ["@type" "constructor" "args"])
          {:op :construct :constructor (check (get expr "constructor"))
           :args (args! (get expr "args"))})
      "HostArrayItems"
      (do (shape! expr ["@type" "items"])
          (let [items (get expr "items")]
            (vector! items 4096)
            {:op :array-items :items (mapv (fn [item]
                                            (cond
                                              (and (map? item) (= #{"value"} (set (keys item))))
                                              {:kind :value :value (check (get item "value"))}
                                              (and (map? item) (= #{"spread"} (set (keys item))))
                                              {:kind :spread :value (check (get item "spread"))}
                                              :else (fail! :mithril.native-js/shape
                                                            "HostArrayItems entries need exactly value or spread"))) items)}))
      "HostOptionalMethod"
      (do (shape! expr ["@type" "object" "key" "args"])
          {:op :optional-method :object (check (get expr "object")) :key (check (get expr "key"))
           :args (args! (get expr "args"))})
      "HostLogical"
      (do (shape! expr ["@type" "operator" "left" "right"])
          (let [operator (get expr "operator")]
            (when-not (contains? #{"&&" "||" "??"} operator)
              (fail! :mithril.native-js/operator "Unsupported native logical operator"))
            {:op :logical :operator operator :left (check (get expr "left"))
             :right (check (get expr "right"))}))
      "HostCompoundAssign"
      (do (shape! expr ["@type" "object" "key" "value" "operator"])
          (when-not (contains? #{"+=" "-=" "*=" "/=" "%=" "**=" "<<=" ">>=" ">>>=" "&=" "|=" "^="} (get expr "operator"))
            (fail! :mithril.native-js/operator "Unsupported native property compound assignment"))
          {:op :compound-assign :object (check (get expr "object")) :key (check (get expr "key"))
           :value (check (get expr "value")) :operator (get expr "operator")})
      "HostLogicalAssign"
      (do (shape! expr ["@type" "object" "key" "value" "operator"])
          (when-not (contains? #{"??=" "&&=" "||="} (get expr "operator"))
            (fail! :mithril.native-js/operator "Unsupported native property logical assignment"))
          {:op :logical-assign :object (check (get expr "object")) :key (check (get expr "key"))
           :value (check (get expr "value")) :operator (get expr "operator")})
      "HostObject"
      (do (shape! expr ["@type" "entries"])
          (let [entries (get expr "entries")]
            (vector! entries 4096)
            {:op :object :entries (mapv (fn [entry]
                                       (if (contains? entry "kind")
                                         (do
                                           (optional-flags! entry ["kind" "key" "params" "rest" "body"] ["statements" "async" "generator"])
                                           (when-not (= "method" (get entry "kind"))
                                             (fail! :mithril.native-js/shape "Object method entry requires method kind"))
                                           (let [key (check (get entry "key"))
                                                 context (suspension-context {:function true :this true :new-target true :super-property true}
                                                                             (get entry "async") (get entry "generator"))]
                                             (assoc (class-signature! entry imports functions locals (inc depth) nodes context)
                                                    :kind :method :key key)))
                                         (do
                                           (optional-flag! entry ["key" "value"] "infer_name")
                                           (let [value (check (get entry "value"))]
                                             (when (and (contains? entry "infer_name") (not (contains? #{:lambda :native-function :native-class} (:op value))))
                                               (fail! :mithril.native-js/shape "Name inference requires a native function or class initializer"))
                                             {:key (check (get entry "key"))
                                              :value (cond-> value (true? (get entry "infer_name"))
                                                       (assoc :infer-name true))})))) entries)}))
      "HostSpread"
      (do (shape! expr ["@type" "value"])
          {:op :spread :value (check (get expr "value"))})
      "HostObjectSpreads"
      (do (shape! expr ["@type" "values"])
          (let [values (get expr "values")]
            (vector! values 4096)
            {:op :object-spreads :values (mapv check values)}))
      "HostUpdate"
      (do (shape! expr ["@type" "object" "key" "operator" "prefix"])
          (when-not (and (contains? #{"++" "--"} (get expr "operator")) (boolean? (get expr "prefix")))
            (fail! :mithril.native-js/shape "Invalid native property update"))
          {:op :update :object (check (get expr "object")) :key (check (get expr "key"))
           :operator (get expr "operator") :prefix (get expr "prefix")})
      "HostSet"
      (do (shape! expr ["@type" "object" "key" "value"])
          {:op :set :object (check (get expr "object")) :key (check (get expr "key"))
           :value (check (get expr "value"))})
      "HostDelete"
      (do (shape! expr ["@type" "object" "key"])
          {:op :delete :object (check (get expr "object")) :key (check (get expr "key"))})
      ("HostForOf" "HostForIn")
      (let [for-in? (= "HostForIn" (get expr "@type"))
            field (if for-in? "object" "iterable")]
        (shape! expr ["@type" field "binding" "body" "result"])
        (let [raw (get expr "binding")
              binding (if (string? raw) (name! raw)
                          (do (shape! raw ["array"]) (pattern! raw)))
              names (if (string? binding) [binding] (:names binding))]
          (unique! names)
          (coroutine-bindings! names args-length)
          (when (some #(contains? locals %) names)
            (fail! :mithril.native-js/duplicate "Loop binding must be fresh"))
          {:op (if for-in? :for-in :for-of) :binding binding :iterable (check (get expr field))
           :body (expression! (get expr "body") imports functions (into locals (zipmap names (repeat false)))
                              (inc depth) nodes (loop-context args-length))
           :result (body-check (get expr "result"))}))
      "HostFor"
      (do (shape! expr ["@type" "initializer" "condition" "update" "body" "result"])
          (let [init (get expr "initializer")
                bindings (when (and (some? init) (contains? init "bindings"))
                           (shape! init ["bindings"])
                           (let [bs (get init "bindings")]
                             (vector! bs 64)
                             (when (empty? bs) (fail! :mithril.native-js/shape "Empty for declaration list"))
                             (mapv (fn [b]
                                     (optional-flag! b ["name" "value"] "mutable")
                                     {:name (name! (get b "name")) :mutable (true? (get b "mutable")) :raw (get b "value")}) bs)))
                _ (when (and (some? init) (nil? bindings)) (shape! init ["expression"]))
                names (mapv :name bindings)
                _ (unique! names)
                _ (coroutine-bindings! names args-length)
                _ (when (some #(contains? locals %) names)
                    (fail! :mithril.native-js/duplicate "For bindings must be fresh"))
                _ (when (> (count (set (map :mutable bindings))) 1)
                    (fail! :mithril.native-js/shape "For declarations must share let or const kind"))
                scope (into locals (map (juxt :name :mutable) bindings))
                scoped #(expression! % imports functions scope (inc depth) nodes (value-context args-length))
                context (if (context? args-length :statement)
                          (assoc args-length :loop true)
                          (assoc (suspension-context args-length false false)
                                 :statement true :source-return false :loop true :switch false))]
            {:op :for :initializer (cond
                                    bindings {:bindings (mapv (fn [b] (-> b (dissoc :raw) (assoc :value (scoped (:raw b))))) bindings)}
                                    (some? init) {:expression (check (get init "expression"))}
                                    :else nil)
             :condition (when (some? (get expr "condition")) (scoped (get expr "condition")))
             :update (when (some? (get expr "update")) (scoped (get expr "update")))
             :body (expression! (get expr "body") imports functions scope (inc depth) nodes context)
             :result (body-check (get expr "result"))}))
      "HostSwitch"
      (do (shape! expr ["@type" "value" "clauses" "result"])
          (let [clauses (get expr "clauses")
                _ (vector! clauses 128)
                raw (mapcat (fn [clause]
                              (if (contains? clause "default")
                                (do (shape! clause ["default" "statements"])
                                    (when-not (true? (get clause "default"))
                                      (fail! :mithril.native-js/shape "Switch default must be true")))
                                (shape! clause ["test" "statements"]))
                              (vector! (get clause "statements") 128)
                              (get clause "statements")) clauses)
                _ (when (> (count (filter #(contains? % "default") clauses)) 1)
                    (fail! :mithril.native-js/duplicate "Duplicate switch default"))
                _ (when (> (count raw) 4096)
                    (fail! :mithril.native-js/budget "Switch statement budget exceeded"))
                declarations (keep (fn [statement]
                                     (if (contains? statement "binding")
                                       (do (shape! statement ["binding"])
                                           (let [binding (get statement "binding")]
                                             (optional-flag! binding ["name" "value"] "mutable")
                                             {:name (name! (get binding "name"))
                                              :mutable (true? (get binding "mutable"))}))
                                       (do (shape! statement ["expression"]) nil))) raw)
                _ (when (> (count declarations) 128)
                    (fail! :mithril.native-js/budget "Switch lexical binding budget exceeded"))
                names (mapv :name declarations)
                _ (unique! names)
                _ (coroutine-bindings! names args-length)
                _ (when (some #(contains? locals %) names)
                    (fail! :mithril.native-js/duplicate "Switch bindings must be fresh"))
                scope (into locals (map (juxt :name :mutable) declarations))
                context (if (context? args-length :statement)
                          (assoc args-length :switch true)
                          (assoc (suspension-context args-length false false)
                                 :statement true :source-return false :loop false :switch true))
                scoped #(expression! % imports functions scope (inc depth) nodes %2)]
            {:op :switch :value (check (get expr "value")) :bindings (vec declarations)
             :clauses (mapv (fn [clause]
                              (cond-> {:statements
                                       (mapv (fn [statement]
                                               (if-let [binding (get statement "binding")]
                                                 {:binding {:name (get binding "name")
                                                            :mutable (true? (get binding "mutable"))
                                                            :value (scoped (get binding "value") (value-context context))}}
                                                 {:expression (scoped (get statement "expression") context)}))
                                             (get clause "statements"))}
                                (contains? clause "default") (assoc :default true)
                                (contains? clause "test") (assoc :test (scoped (get clause "test") (value-context context))))) clauses)
             :result (body-check (get expr "result"))}))
      "HostWhile"
      (do (shape! expr ["@type" "condition" "body" "result"])
          {:op :while :condition (check (get expr "condition"))
           :body (expression! (get expr "body") imports functions locals (inc depth) nodes (loop-context args-length))
           :result (body-check (get expr "result"))})
      "HostDoWhile"
      (do (shape! expr ["@type" "condition" "body" "result"])
          {:op :do-while :condition (check (get expr "condition"))
           :body (expression! (get expr "body") imports functions locals (inc depth) nodes (loop-context args-length))
           :result (body-check (get expr "result"))})
      "HostToString"
      (do (shape! expr ["@type" "value"])
          {:op :to-string :value (check (get expr "value"))})
      "HostArray"
      (do (shape! expr ["@type" "items"])
          (let [items (get expr "items")]
            (vector! items 4096) {:op :array :items (mapv check items)}))
      "NativeLambda"
      (do (optional-flags! expr (cond-> ["@type" "params" "body"] (contains? expr "rest") (conj "rest")) ["statements" "async"])
          (let [params (get expr "params") rest-name (get expr "rest")]
            (vector! params 64)
            (when (some? rest-name)
              (name! rest-name)
              (when (contains? reserved rest-name) (fail! :mithril.native-js/name "Reserved arrow rest binding")))
            (let [patterns (mapv (fn [p]
                                  (if (and (map? p) (contains? p "pattern"))
                                    (do (optional-flag! p (cond-> ["pattern"] (contains? p "default") (conj "default")) "mutable")
                                        (cond-> (let [pattern (binding-pattern! (get p "pattern"))]
                                                  (when (and (= :binding-default (:op pattern)) (contains? p "default"))
                                                    (fail! :mithril.native-js/shape "Duplicate parameter default")) pattern)
                                          (contains? p "mutable") (assoc :mutable (get p "mutable"))))
                                    (pattern! p))) params)
                  names (cond-> (vec (mapcat :names patterns)) (some? rest-name) (conj rest-name))
                  env (cond-> (into locals (mapcat (fn [pattern] (map #(vector % (true? (:mutable pattern))) (:names pattern))) patterns))
                        (some? rest-name) (assoc rest-name false))
                  patterns (mapv (fn [pattern p]
                                   (let [pattern (if (contains? #{:binding-name :binding-default :binding-array :binding-object} (:op pattern))
                                                   (check-binding-pattern pattern imports functions env (inc depth) nodes (suspension-context args-length false false)) pattern)]
                                   (if (and (map? p) (contains? p "default"))
                                     (assoc pattern (if (contains? p "pattern") :parameter-default :default) (expression! (get p "default") imports functions env (inc depth) nodes (value-context (suspension-context args-length false false))))
                                     pattern))) patterns params)]
              (unique! names)
              (coroutine-bindings! names (suspension-context args-length (get expr "async") false))
              (cond-> {:op :lambda :params patterns
                        :body (expression! (get expr "body") imports functions env (inc depth) nodes (body-context (suspension-context args-length (get expr "async") false) (get expr "statements") true))}
                (contains? expr "rest") (assoc :rest rest-name)
                (contains? expr "statements") (assoc :statements (get expr "statements"))
                (contains? expr "async") (assoc :async (get expr "async"))))))
      "NativeFunction"
      (do (optional-flags! expr ["@type" "name" "params" "rest" "body"] ["async" "generator" "statements"])
          (let [name (get expr "name") params (get expr "params") rest-name (get expr "rest")]
            (doseq [n [name rest-name] :when (some? n)]
              (name! n)
              (when (contains? reserved n)
                (fail! :mithril.native-js/name "Reserved native function binding")))
            (let [names (params! params)
                  all-names (cond-> (vec (mapcat binding-names names)) (some? rest-name) (conj rest-name))
                  _ (unique! all-names)
                  _ (coroutine-bindings! all-names (suspension-context true (get expr "async") (get expr "generator")))
                  self-env (cond-> locals (some? name) (assoc name false))
                  body-env (parameter-env self-env params names rest-name)
                  defaults (into {} (keep-indexed
                                      (fn [i p]
                                        (when (contains? p "default")
                                          [i (expression! (get p "default") imports functions body-env (inc depth) nodes true)])) params))]
              (cond-> {:op :native-function :name name :params (check-parameter-patterns names imports functions body-env (inc depth) nodes true) :rest rest-name
                       :body (expression! (get expr "body") imports functions body-env (inc depth) nodes (body-context (suspension-context true (get expr "async") (get expr "generator")) (get expr "statements") true))}
                (seq defaults) (assoc :defaults defaults)
                (contains? expr "async") (assoc :async (get expr "async"))
                (contains? expr "generator") (assoc :generator (get expr "generator"))
                (contains? expr "statements") (assoc :statements (get expr "statements"))))))
      "NativeClass"
      (do (shape! expr ["@type" "name" "extends" "constructor" "members"])
          (let [name (get expr "name") heritage (get expr "extends") ctor (get expr "constructor") members (get expr "members")]
            (when (some? name)
              (name! name)
              (when (contains? reserved name) (fail! :mithril.native-js/name "Reserved class name")))
            (vector! members 128)
            (let [self-env (cond-> locals (some? name) (assoc name false))
                  method-context {:function true :this true :new-target true :super-property true}
                  field-context {:this true :new-target true :super-property true}
                  constructor-context (assoc method-context :super-call (some? heritage))
                  base (when (some? heritage) (expression! heritage imports functions self-env (inc depth) nodes (value-context args-length)))
                  constructor (when (some? ctor)
                                (optional-flag! ctor ["params" "rest" "body"] "statements")
                                (class-signature! ctor imports functions self-env (inc depth) nodes constructor-context))
                  checked-members
                  (mapv (fn [m]
                          (if (= "static-block" (get m "kind"))
                            (do (shape! m ["kind" "body"])
                                {:kind :static-block :body (expression! (get m "body") imports functions self-env (inc depth) nodes (body-context field-context true false))})
                            (do
                          (when-not (boolean? (get m "static")) (fail! :mithril.native-js/shape "Class static flag must be boolean"))
                              (let [kind (get m "kind") key (expression! (get m "key") imports functions self-env (inc depth) nodes (value-context args-length))]
                                (if (= kind "field")
                                  (do (shape! m ["kind" "key" "static" "value"])
                                      {:kind :field :key key :static (get m "static")
                                       :value (expression! (get m "value") imports functions self-env (inc depth) nodes field-context)})
                                  (do
                                    (when-not (contains? #{"method" "get" "set"} kind) (fail! :mithril.native-js/shape "Unknown class member kind"))
                                    (optional-flags! m ["kind" "key" "static" "params" "rest" "body"] ["statements" "async" "generator"])
                                    (when (and (not= kind "method") (or (true? (get m "async")) (true? (get m "generator"))))
                                      (fail! :mithril.native-js/shape "Accessors cannot be async or generator methods"))
                                    (let [signature (class-signature! m imports functions self-env (inc depth) nodes (suspension-context method-context (get m "async") (get m "generator")))]
                                      (when (or (and (= kind "get") (or (seq (:params signature)) (some? (:rest signature))))
                                                (and (= kind "set") (or (not= 1 (count (:params signature))) (some? (:rest signature)))))
                                        (fail! :mithril.native-js/shape "Invalid accessor parameter list"))
                                      (assoc signature :kind (keyword kind) :key key :static (get m "static"))))))))) members)]
              {:op :native-class :name name :extends base :constructor constructor :members checked-members})))
      "HostBindingLet"
      (do (shape! expr ["@type" "bindings" "body"])
          (let [bindings (get expr "bindings")
                _ (vector! bindings 64)
                raw (mapv (fn [b]
                            (optional-flag! b ["pattern" "value"] "mutable")
                            (let [pattern (binding-pattern! (get b "pattern"))]
                              (when (= :binding-default (:op pattern)) (fail! :mithril.native-js/shape "Lexical pattern cannot have an outer default"))
                              {:pattern pattern :raw-value (get b "value") :mutable (true? (get b "mutable"))})) bindings)
                names (vec (mapcat #(get-in % [:pattern :names]) raw))
                _ (vector! names 128) _ (unique! names) _ (coroutine-bindings! names args-length)
                env (into locals (mapcat (fn [b] (map #(vector % (:mutable b)) (get-in b [:pattern :names]))) raw))]
            {:op :binding-let
             :bindings (mapv (fn [b] {:pattern (check-binding-pattern (:pattern b) imports functions env (inc depth) nodes args-length)
                                      :value (expression! (:raw-value b) imports functions env (inc depth) nodes (value-context args-length))
                                      :mutable (:mutable b)}) raw)
             :body (expression! (get expr "body") imports functions env (inc depth) nodes args-length)}))
      "Let"
      (do (shape! expr ["@type" "bindings" "body"])
          (let [bindings (get expr "bindings")]
            (vector! bindings 4096)
            (loop [todo (seq bindings) env locals checked []]
              (if-let [binding (first todo)]
                (do (optional-flags! binding ["name" "value"] ["mutable" "recursive"])
                    (let [name (name! (get binding "name"))
                          _ (coroutine-bindings! [name] args-length)
                          init-env (if (true? (get binding "recursive")) (assoc env name (true? (get binding "mutable"))) env)
                          value (expression! (get binding "value") imports functions init-env (inc depth) nodes (value-context args-length))
                          checked-binding (cond-> {:name name :value value}
                                            (contains? binding "mutable") (assoc :mutable (get binding "mutable"))
                                            (contains? binding "recursive") (assoc :recursive (get binding "recursive")))]
                      (recur (next todo) (assoc env name (true? (get binding "mutable")))
                             (conj checked checked-binding))))
                {:op :let :bindings checked
                 :body (expression! (get expr "body") imports functions env (inc depth) nodes args-length)}))))
      "HostLocalUpdate"
      (do (shape! expr ["@type" "name" "operator" "prefix"])
          (let [name (name! (get expr "name"))]
            (when-not (true? (get locals name))
              (fail! :mithril.native-js/local "Local update requires an explicitly mutable local"))
            (when-not (and (contains? #{"++" "--"} (get expr "operator")) (boolean? (get expr "prefix")))
              (fail! :mithril.native-js/shape "Invalid native local update"))
            {:op :local-update :name name :operator (get expr "operator") :prefix (get expr "prefix")}))
      "LocalSet"
      (do (shape! expr ["@type" "name" "value"])
          (let [name (name! (get expr "name"))]
            (when-not (true? (get locals name))
              (fail! :mithril.native-js/local "LocalSet requires an explicitly mutable local"))
            {:op :local-set :name name :value (check (get expr "value"))}))
      "HostAwait"
      (do (shape! expr ["@type" "value"])
          (when-not (context? args-length :await)
            (fail! :mithril.native-js/scope "Await requires its own async source body"))
          {:op :await :value (check (get expr "value"))})
      "HostYield"
      (do (optional-flag! expr ["@type" "value"] "delegate")
          (when-not (context? args-length :yield)
            (fail! :mithril.native-js/scope "Yield requires its own generator source body"))
          (cond-> {:op :yield :value (check (get expr "value"))}
            (contains? expr "delegate") (assoc :delegate (get expr "delegate"))))
      "HostReturn"
      (do (shape! expr ["@type" "value"])
          (when-not (and (context? args-length :statement) (context? args-length :source-return))
            (fail! :mithril.native-js/scope "Return requires a source function statement position"))
          {:op :return :value (check (get expr "value"))})
      "HostContinue"
      (do (shape! expr ["@type"])
          (when-not (and (context? args-length :statement) (context? args-length :loop))
            (fail! :mithril.native-js/scope "Continue requires a source loop statement position"))
          {:op :continue})
      "HostBreak"
      (do (shape! expr ["@type"])
          (when-not (and (context? args-length :statement) (or (context? args-length :loop) (context? args-length :switch)))
            (fail! :mithril.native-js/scope "Break requires a source loop or switch statement position"))
          {:op :break})
      "HostThrow"
      (do (shape! expr ["@type" "value"])
          {:op :throw :value (check (get expr "value"))})
      "HostTryCatch"
      (do (shape! expr ["@type" "body" "binding" "handler"])
          (let [binding (name! (get expr "binding"))]
            (coroutine-bindings! [binding] args-length)
            {:op :try-catch :binding binding :body (body-check (get expr "body"))
             :handler (expression! (get expr "handler") imports functions (assoc locals binding false)
                                   (inc depth) nodes args-length)}))
      "HostTryFinally"
      (do (shape! expr ["@type" "body" "finally"])
          {:op :try-finally :body (body-check (get expr "body")) :finally (body-check (get expr "finally"))})
      "LocalFunction"
      (do (shape! expr ["@type" "name" "params" "body" "result"])
          (let [name (name! (get expr "name")) params (get expr "params")]
            (when (contains? reserved name)
              (fail! :mithril.native-js/name "Reserved native local function name"))
            (when (contains? locals name)
              (fail! :mithril.native-js/duplicate "LocalFunction binding must be fresh"))
            (vector! params 64)
            (let [raw-params (mapv #(if (string? %) {"name" % "datatype" "js-value"} %) params)
                  params (params! raw-params)
                  self-env (assoc locals name false)
                  body-env (parameter-env self-env raw-params params nil)
                  defaults (into {} (keep-indexed (fn [i p] (when (contains? p "default")
                                                            [i (expression! (get p "default") imports functions body-env (inc depth) nodes true)])) raw-params))]
              {:op :local-function :name name :params (check-parameter-patterns params imports functions body-env (inc depth) nodes true) :defaults defaults
               :body (expression! (get expr "body") imports functions body-env (inc depth) nodes true)
               :result (expression! (get expr "result") imports functions self-env (inc depth) nodes (value-context args-length))})))
      "Sequence"
      (do (shape! expr ["@type" "expressions"])
          (let [expressions (get expr "expressions")]
            (vector! expressions 4096)
            (when (empty? expressions) (fail! :mithril.native-js/shape "Sequence requires a result"))
            {:op :sequence :expressions (mapv body-check expressions)}))
      "If"
      (do (shape! expr ["@type" "condition" "then" "else"])
          {:op :if :condition (check (get expr "condition"))
           :then (body-check (get expr "then")) :else (body-check (get expr "else"))})
      (fail! :mithril.native-js/expression "Unsupported native JS expression"))))

(defn- ambient-scope! [value ambient shadows]
  (cond
    (map? value)
    (let [self (when (contains? #{:native-function :native-class :local-function} (:op value)) (:name value))
          shadows (cond-> shadows (some? self) (conj self))]
      (when (and (= :import (:op value)) (contains? ambient (:name value))
                 (contains? shadows (:name value)))
        (fail! :mithril.native-js/scope "Native self binding shadows an ambient import"))
      (doseq [v (vals value)] (ambient-scope! v ambient shadows)))
    (coll? value) (doseq [v value] (ambient-scope! v ambient shadows))))

(defn check-document
  "Check a separate native JS context; imports are an explicit host capability list."
  [doc]
  (optional-flag! doc (cond-> ["@context" "@type" "name" "imports" "functions" "exports"]
                       (contains? doc "bindings") (conj "bindings")
                       (contains? doc "ambient_imports") (conj "ambient_imports")) "lexical_bindings")
  (when-not (and (= "NativeJsModule" (get doc "@type"))
                (= "https://mithril.fund/context/native-js-module/v1" (get doc "@context")))
    (fail! :mithril.native-js/context "Expected the native JS module context"))
  (let [name (get doc "name") imports (get doc "imports")
        functions (get doc "functions") exports (get doc "exports")]
    (when-not (and (string? name) (re-matches #"[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*" name))
      (fail! :mithril.native-js/name "Invalid native JS module name"))
    (vector! imports 128) (vector! functions 128) (vector! exports 128)
    (doseq [import imports] (name! import)) (unique! imports)
    (when (contains? doc "ambient_imports")
      (let [ambient (get doc "ambient_imports")]
        (vector! ambient 128) (unique! ambient)
        (doseq [name ambient]
          (name! name)
          (when (or (contains? reserved name) (not (some #{name} imports)))
            (fail! :mithril.native-js/import "Ambient imports must be declared nonreserved identifiers")))))
    (let [declarations (mapv (fn [f]
                              (optional-flags! f ["@type" "name" "params" "returns" "body"] ["statements" "mutable"])
                              (when-not (and (= "Function" (get f "@type"))
                                            (= "js-value" (get f "returns")))
                                (fail! :mithril.native-js/type "Expected a js-value native function"))
                              (let [name (name! (get f "name"))]
                                (when (contains? reserved name)
                                  (fail! :mithril.native-js/name "Reserved native JS function name"))
                                (cond-> {:name name :params (params! (get f "params"))}
                                  (contains? f "statements") (assoc :statements (get f "statements"))
                                  (contains? f "mutable") (assoc :mutable (get f "mutable"))))) functions)
          names (mapv :name declarations)
          _ (unique! names)
          targets (into {} (map #(vector (:name %) (true? (:mutable %))) declarations))
          nodes (atom 0)]
      (let [bindings (if (contains? doc "bindings") (get doc "bindings") [])
            _ (vector! bindings 128)
            binding-names (mapv (fn [b]
                                  (optional-flag! b ["name" "value"] "mutable")
                                  (name! (get b "name"))) bindings)
            _ (unique! binding-names)
            _ (when (some (into (set imports) (keys targets)) binding-names)
                (fail! :mithril.native-js/duplicate "Module bindings must be disjoint from imports/functions"))
            lexical-env (if (get doc "lexical_bindings")
                          (into {} (map #(vector (get % "name") (true? (get % "mutable"))) bindings)) {})
            checked-bindings (loop [todo (seq bindings) env lexical-env checked []]
                               (if-let [b (first todo)]
                                 (let [name (get b "name")
                                       ;; Explicit lexical mode exposes the complete scope, preserving
                                       ;; native TDZ at runtime; legacy mode admits only earlier bindings.
                                       value (expression! (get b "value") (set imports) targets env 1 nodes false)
                                       cb (cond-> {:name name :value value}
                                            (contains? b "mutable") (assoc :mutable (get b "mutable")))]
                                   (recur (next todo) (assoc env name (true? (get b "mutable"))) (conj checked cb)))
                                 {:env env :bindings checked}))
            module-env (:env checked-bindings)
            checked-functions
            (mapv (fn [f d]
                    (let [env (parameter-env module-env (get f "params") (:params d) nil)
                          defaults (into {} (keep-indexed
                                             (fn [i p]
                                               (when (contains? p "default")
                                                 [i (expression! (get p "default") (set imports) targets env 1 nodes true)]))
                                             (get f "params")))]
                      (cond-> (assoc d :params (check-parameter-patterns (:params d) (set imports) targets env 1 nodes true) :body (expression! (get f "body") (set imports) targets env 1 nodes (body-context true (get f "statements") true)))
                        (seq defaults) (assoc :defaults defaults)))) functions declarations)
            public (mapv (fn [e]
                           (let [e (if (string? e) {"name" e "function" e} e)]
                             (shape! e (if (contains? e "value") ["name" "value"] ["name" "function"]))
                             (let [name (name! (get e "name"))]
                               (if (contains? e "value")
                                 {:name name :value (expression! (get e "value") (set imports) targets module-env 1 nodes false)}
                                 (let [target (name! (get e "function"))]
                                   (when-not (contains? targets target)
                                     (fail! :mithril.native-js/export "Unknown native JS export"))
                                   {:name name :target target}))))) exports)
            _ (unique! (mapv :name public))
            ambient (set (get doc "ambient_imports" []))
            _ (when (some ambient names)
                (fail! :mithril.native-js/scope "Module declaration shadows an ambient import"))
            _ (ambient-scope! [checked-functions (:bindings checked-bindings) public] ambient #{})]
        (cond-> {:format :mithril.native-js/checked-v1 :name name :imports imports :exports public
                 :functions checked-functions}
          (contains? doc "lexical_bindings") (assoc :lexical-bindings (get doc "lexical_bindings"))
          (contains? doc "ambient_imports") (assoc :ambient-imports (get doc "ambient_imports"))
          (contains? doc "bindings") (assoc :bindings (:bindings checked-bindings)))))))

(defn check-text [text]
  (module/check-source-text! text)
  (check-document (form/parse text)))
(defn- quoted [s] (js/JSON.stringify s))
(defn- fresh [counter prefix] (str prefix "v" (swap! counter inc)))
(defn- emit-loop-binding [binding env counter prefix]
  (if (string? binding)
    (let [symbol (fresh counter prefix)]
      {:source symbol :env (assoc env binding symbol)})
    (let [names (:names binding) symbols (mapv (fn [_] (fresh counter prefix)) names)]
      {:source (str "[" (str/join "," symbols) "]")
       :env (into env (zipmap names symbols))})))

(declare emit-expression emit-body)
(defn- emit-binding-value [value binding-name imports functions env counter prefix context]
  ;; Native NamedEvaluation uses the source binding label, not its hygienic symbol.
  ;; A computed property keeps an inferred anonymous function anonymous internally.
  (if (and binding-name (contains? #{:lambda :native-function :native-class} (:op value)) (nil? (:name value)))
    (str "({[" (quoted binding-name) "]:" (emit-expression (assoc value :infer-name true) imports functions env counter prefix context) "})[" (quoted binding-name) "]")
    (emit-expression value imports functions env counter prefix context)))
(defn- emit-binding-pattern [pattern imports functions env counter prefix context]
  (let [child #(emit-binding-pattern % imports functions env counter prefix context)]
    (case (:op pattern)
      :binding-name (get env (:name pattern))
      :binding-default (str (child (:target pattern)) "="
                            (emit-binding-value (:default pattern) (when (= :binding-name (:op (:target pattern))) (:name (:target pattern))) imports functions env counter prefix context))
      :binding-array (let [items (:items pattern) rest (:rest pattern)]
                       (str "[" (str/join "," (map #(if % (child %) "") items))
                            (when (and (seq items) (nil? (last items)) (nil? rest)) ",")
                            (when rest (str (when (seq items) ",") "..." (child rest))) "]"))
      :binding-object (str "{" (str/join "," (concat
                              (map #(str (if (:computed %)
                                              (str "[" (emit-expression (:key %) imports functions env counter prefix context) "]")
                                              (quoted (str (:value (:key %))))) ":" (child (:target %))) (:properties pattern))
                              (when (:rest pattern) [(str "..." (child (:rest pattern)))]))) "}"))))
(defn- emit-parameters [signature imports functions env counter prefix context]
  (let [slots (:params signature) names (vec (mapcat binding-names slots))
        symbols (mapv (fn [_] (fresh counter prefix)) names)
        rest-symbol (when (some? (:rest signature)) (fresh counter prefix))
        body-env (cond-> (into env (zipmap names symbols)) rest-symbol (assoc (:rest signature) rest-symbol))
        source (map-indexed (fn [i slot]
                              (str (if (string? slot) (get body-env slot) (emit-binding-pattern slot imports functions body-env counter prefix context))
                                   (when (contains? (:defaults signature) i)
                                     (str "=" (if (and (map? slot) (= :binding-name (:op slot)))
                                                  (emit-binding-value (get (:defaults signature) i) (:name slot) imports functions body-env counter prefix context)
                                                  (emit-expression (get (:defaults signature) i) imports functions body-env counter prefix context)))))) slots)]
    {:env body-env :source (cond-> (vec source) rest-symbol (conj (str "..." rest-symbol)))}))
(defn- emit-binding-block [expr imports functions env counter prefix context result?]
  (let [names (mapcat #(get-in % [:pattern :names]) (:bindings expr))
        scope (into env (map #(vector % (fresh counter prefix)) names))]
    (str (apply str (map (fn [b]
                          (str (if (:mutable b) "let " "const ") (emit-binding-pattern (:pattern b) imports functions scope counter prefix context) "="
                               (emit-binding-value (:value b) (when (= :binding-name (:op (:pattern b))) (:name (:pattern b))) imports functions scope counter prefix context) ";")) (:bindings expr)))
         (emit-body (:body expr) imports functions scope counter prefix context result?))))
(defn- emit-class-signature [signature imports functions env counter prefix context]
  (let [{body-env :env param-source :source} (emit-parameters signature imports functions env counter prefix context)]
    (str "(" (str/join "," param-source) "){"
         (if (:statements signature)
           (emit-body (:body signature) imports functions body-env counter prefix context true)
           (str "return " (emit-expression (:body signature) imports functions body-env counter prefix context) ";")) "}")))

(defn- emit-expression [expr imports functions env counter prefix args-length]
  (let [emit #(emit-expression % imports functions env counter prefix args-length)
        args #(str/join "," (map emit %))]
    (case (:op expr)
      :literal (if (and (number? (:value expr)) (js/Object.is (:value expr) (js/Number "-0"))) "(-0)" (quoted (:value expr)))
      :import-meta "import.meta"
      :dynamic-import (str "(import(" (emit (:source expr))
                           (when (contains? expr :options) (str "," (emit (:options expr)))) "))")
      :local (get env (:name expr))
      :import (get imports (:name expr))
      :function-ref (get functions (:name expr))
      :function-set (str "(" (get functions (:name expr)) "=" (emit (:value expr)) ")")
      :call (str (get functions (:name expr)) "(" (args (:args expr)) ")")
      :optional-get (str "(" (emit (:object expr)) ")?.[" (emit (:key expr)) "]")
      :optional-chain
      (str "((0," (emit (:base expr)) ")"
           (apply str (map (fn [step]
                             (case (:kind step)
                               :get (str (if (:optional step) "?.[" "[") (emit (:key step)) "]")
                               :call (str (when (:optional step) "?.") "("
                                          (str/join "," (map #(str (when (= :spread (:kind %)) "...") (emit (:value %))) (:items step))) ")"))) (:steps expr))) ")")
      :get (str "(" (emit (:object expr)) ")[" (emit (:key expr)) "]")
      ;; The comma expression makes a value call, never a Reference call with
      ;; an accidental receiver (e.g. when the callee is a HostGet).
      :invoke (str "(0," (emit (:function expr)) ")(" (args (:args expr)) ")")
      :optional-invoke (str "(0," (emit (:function expr)) ")?.(" (args (:args expr)) ")")
      :invoke-items (str "(0," (emit (:function expr)) ")(" (str/join "," (map #(str (when (= :spread (:kind %)) "...") (emit (:value %))) (:items expr))) ")")
      :optional-invoke-items (str "(0," (emit (:function expr)) ")?.(" (str/join "," (map #(str (when (= :spread (:kind %)) "...") (emit (:value %))) (:items expr))) ")")
      :method (str "(" (emit (:object expr)) ")[" (emit (:key expr)) "](" (args (:args expr)) ")")
      :regexp (str "(/" (:source expr) "/" (:flags expr) ")")
      :method-items (str "(" (emit (:object expr)) ")[" (emit (:key expr)) "]("
                         (str/join "," (map (fn [item]
                                              (if (= :spread (:kind item))
                                                (str "..." (emit (:value item)))
                                                (emit (:value item)))) (:items expr))) ")")
      :undefined "(void 0)"
      :await (str "(await " (emit (:value expr)) ")")
      :yield (str "(yield" (when (:delegate expr) "*") " " (emit (:value expr)) ")")
      :arguments "arguments"
      :arguments-length "arguments.length"
      :this "this"
      :new-target "new.target"
      :super-get (str "super[" (emit (:key expr)) "]")
      :super-set (str "(super[" (emit (:key expr)) "]=" (emit (:value expr)) ")")
      :super-call (str "super(" (str/join "," (map #(str (when (= :spread (:kind %)) "...") (emit (:value %))) (:items expr))) ")")
      :super-method (str "super[" (emit (:key expr)) "](" (str/join "," (map #(str (when (= :spread (:kind %)) "...") (emit (:value %))) (:items expr))) ")")
      :unary (str "(" (:operator expr) " " (emit (:value expr)) ")")
      :binary (str "(" (emit (:left expr))
                   (if (contains? #{"in" "instanceof" "+" "-" "%" "<" "<=" "*" "/"} (:operator expr))
                     (str " " (:operator expr) " ") (:operator expr))
                   (emit (:right expr)) ")")
      :logical (str "(" (emit (:left expr)) (:operator expr) (emit (:right expr)) ")")
      :compound-assign (str "((" (emit (:object expr)) ")[" (emit (:key expr)) "]" (:operator expr) (emit (:value expr)) ")")
      :logical-assign (str "((" (emit (:object expr)) ")[" (emit (:key expr)) "]" (:operator expr) (emit (:value expr)) ")")
      ;; Computed properties avoid the special object-literal __proto__ setter.
      :object (str "({" (str/join "," (map (fn [entry]
                                             (let [key (emit (:key entry))]
                                               (if (= :method (:kind entry))
                                                 (str (when (:async entry) "async ") (when (:generator entry) "*") "[" key "]"
                                                      (emit-class-signature entry imports functions env counter prefix
                                                                            {:function true :this true :new-target true :super-property true}))
                                                 (str "[" key "]:" (emit (:value entry))))))
                                           (:entries expr))) "})")
      :spread (str "({..." (emit (:value expr)) "})")
      :object-spreads (str "({" (str/join "," (map #(str "..." (emit %)) (:values expr))) "})")
      :update (str "(" (when (:prefix expr) (:operator expr)) "(" (emit (:object expr)) ")[" (emit (:key expr)) "]" (when-not (:prefix expr) (:operator expr)) ")")
      :set (str "((" (emit (:object expr)) ")[" (emit (:key expr)) "]=" (emit (:value expr)) ")")
      :delete (str "(delete (" (emit (:object expr)) ")[" (emit (:key expr)) "])")
      (:for-of :for-in) (let [binding (emit-loop-binding (:binding expr) env counter prefix)
                    body-env (:env binding)]
                ;; Preserve native iteration/enumeration and per-iteration lexical scope.
                (str "(()=>{for(const " (:source binding) (if (= :for-in (:op expr)) " in " " of ") (emit (:iterable expr)) "){"
                     (emit-expression (:body expr) imports functions body-env counter prefix args-length)
                     ";}return " (emit (:result expr)) ";})()"))
      :for (str "(()=>{" (emit-body expr imports functions env counter prefix args-length true) "})()")
      :switch (str "(()=>{" (emit-body expr imports functions env counter prefix args-length true) "})()")
      :while (str "(()=>{while(" (emit (:condition expr)) "){"
               (emit (:body expr)) ";}return " (emit (:result expr)) ";})()")
      :do-while (str "(()=>{do{" (emit (:body expr)) ";}while(" (emit (:condition expr)) ");return " (emit (:result expr)) ";})()")
      :to-string (str "`${" (emit (:value expr)) "}`")
      :array (str "[" (args (:items expr)) "]")
      :construct (str "new (" (emit (:constructor expr)) ")(" (args (:args expr)) ")")
      :array-items (str "[" (str/join "," (map (fn [item]
                                                 (if (= :spread (:kind item))
                                                   (str "..." (emit (:value item)))
                                                   (emit (:value item)))) (:items expr))) "]")
      :optional-method (str "(" (emit (:object expr)) ")?.[" (emit (:key expr)) "](" (args (:args expr)) ")")
      :lambda (let [patterns (:params expr)
                    names (vec (mapcat :names patterns))
                    symbols (mapv (fn [_] (fresh counter prefix)) names)
                    rest-symbol (when (some? (:rest expr)) (fresh counter prefix))
                    env (cond-> (into env (map vector names symbols)) rest-symbol (assoc (:rest expr) rest-symbol))
                    pattern-source (map (fn [p]
                                          (let [s (map #(get env %) (:names p))
                                                source (if (contains? #{:binding-name :binding-default :binding-array :binding-object} (:op p))
                                                         (emit-binding-pattern p imports functions env counter prefix args-length)
                                                         (if (= :array (:op p)) (str "[" (str/join "," s) "]") (first s)))]
                                            (str source (cond
                                                          (contains? p :parameter-default) (str "=" (emit-binding-value (:parameter-default p) (when (= :binding-name (:op p)) (:name p)) imports functions env counter prefix args-length))
                                                          (and (not (contains? #{:binding-name :binding-default :binding-array :binding-object} (:op p))) (contains? p :default)) (str "=" (emit-expression (:default p) imports functions env counter prefix args-length)))))) patterns)
                    pattern-source (cond-> (vec pattern-source) rest-symbol (conj (str "..." rest-symbol)))]
                ;; Always anonymous, including Let initializers; native arrow
                ;; arity, nonconstructibility and iterator binding are retained.
                (str (if (:infer-name expr) "(" "(0,(") (when (:async expr) "async ") "("
                     (str/join "," pattern-source) ")=>"
                     (if (:statements expr)
                       (str "{" (emit-body (:body expr) imports functions env counter prefix args-length true) "}")
                       (emit-expression (:body expr) imports functions env counter prefix args-length))
                     (if (:infer-name expr) ")" "))")))
      :native-function
      (let [self-env (cond-> env (some? (:name expr)) (assoc (:name expr) (:name expr)))
            {body-env :env param-source :source} (emit-parameters expr imports functions self-env counter prefix true)
            source (str (when (:async expr) "async ") "function" (when (:generator expr) "*")
                        (when (some? (:name expr)) (str " " (:name expr)))
                        "(" (str/join "," param-source) "){"
                        (if (:statements expr)
                          (emit-body (:body expr) imports functions body-env counter prefix true true)
                          (str "return " (emit-expression (:body expr) imports functions body-env counter prefix true) ";")) "}")]
        ;; Suppress incidental helper-variable name inference. Explicit computed
        ;; property inference retains the native SetFunctionName operation.
        (str (if (:infer-name expr) "(" "(0,(") source (if (:infer-name expr) ")" "))")))
      :native-class
      (let [self-env (cond-> env (some? (:name expr)) (assoc (:name expr) (:name expr)))
            method-context {:function true :this true :new-target true :super-property true}
            field-context {:this true :new-target true :super-property true}
            ctor-context (assoc method-context :super-call (some? (:extends expr)))
            header (str "class" (when (some? (:name expr)) (str " " (:name expr)))
                        (when (some? (:extends expr)) (str " extends " (emit-expression (:extends expr) imports functions self-env counter prefix args-length))))
            ctor (when (:constructor expr) (str "constructor" (emit-class-signature (:constructor expr) imports functions self-env counter prefix ctor-context)))
            members (mapv (fn [m]
                          (if (= :static-block (:kind m))
                            (str "static{" (emit-body (:body m) imports functions self-env counter prefix field-context false) "}")
                            (let [key (emit-expression (:key m) imports functions self-env counter prefix args-length)
                                  member-prefix (str (when (:static m) "static ") (when (:async m) "async ") (when (:generator m) "*") (when (contains? #{:get :set} (:kind m)) (str (name (:kind m)) " ")) "[" key "]")]
                              (if (= :field (:kind m))
                                (str member-prefix "=" (emit-expression (:value m) imports functions self-env counter prefix field-context) ";")
                                (str member-prefix (emit-class-signature m imports functions self-env counter prefix method-context)))))) (:members expr))
            source (str header "{" ctor (apply str members) "}")]
        (str (if (:infer-name expr) "(" "(0,(") source (if (:infer-name expr) ")" "))")))
      :binding-let (str "(()=>{" (emit-binding-block expr imports functions env counter prefix args-length true) "})()")
      :let (loop [todo (:bindings expr) env env statements []]
             (if-let [b (first todo)]
               (let [early-symbol (when (:recursive b) (fresh counter prefix))
                     init-env (if early-symbol (assoc env (:name b) early-symbol) env)
                     value (emit-expression (:value b) imports functions init-env counter prefix args-length)
                     symbol (or early-symbol (fresh counter prefix))]
                 (recur (next todo) (assoc env (:name b) symbol)
                        (conj statements (str (if (:mutable b) "let " "const ") symbol "=" value ";"))))
               (str "(()=>{" (apply str statements) "return "
                    (emit-expression (:body expr) imports functions env counter prefix args-length) ";})()")))
      :local-update (str "(" (when (:prefix expr) (:operator expr)) (get env (:name expr))
                         (when-not (:prefix expr) (:operator expr)) ")")
      :local-set (str "(" (get env (:name expr)) "=" (emit (:value expr)) ")")
      :throw (str "(()=>{throw " (emit (:value expr)) ";})()")
      :try-catch (let [symbol (fresh counter prefix)
                       handler-env (assoc env (:binding expr) symbol)]
                   (str "(()=>{try{return " (emit (:body expr)) ";}catch(" symbol "){return "
                        (emit-expression (:handler expr) imports functions handler-env counter prefix args-length) ";}})()"))
      :try-finally (str "(()=>{try{return " (emit (:body expr)) ";}finally{"
                        (emit (:finally expr)) ";}})()")
      :local-function (let [symbol (fresh counter prefix)
                            self-env (assoc env (:name expr) symbol)
                            {body-env :env params :source} (emit-parameters expr imports functions self-env counter prefix true)]
                        (str "(()=>{const " symbol "=function " (:name expr) "(" (str/join "," params) "){return "
                             (emit-expression (:body expr) imports functions body-env counter prefix true)
                             ";};return " (emit-expression (:result expr) imports functions self-env counter prefix args-length) ";})()"))
      :sequence (str "(" (args (:expressions expr)) ")")
      :if (str "(" (emit (:condition expr)) "?" (emit (:then expr)) ":" (emit (:else expr)) ")"))))

;; Explicit function statement bodies preserve call-site stack depth for source
;; contracts such as Cordis composeError. Expression operands still use the
;; existing expression emitter; old functions/artifact bytes are unchanged.
(defn- emit-body [expr imports functions env counter prefix context result?]
  (let [emit #(emit-expression % imports functions env counter prefix context)
        body (fn [x e result] (emit-body x imports functions e counter prefix context result))]
    (case (:op expr)
      :binding-let (str "{" (emit-binding-block expr imports functions env counter prefix context result?) "}")
      :let
      (loop [todo (:bindings expr) e env statements []]
        (if-let [b (first todo)]
          (let [early-symbol (when (:recursive b) (fresh counter prefix))
                init-env (if early-symbol (assoc e (:name b) early-symbol) e)
                value (emit-expression (:value b) imports functions init-env counter prefix context)
                symbol (or early-symbol (fresh counter prefix))]
            (recur (next todo) (assoc e (:name b) symbol)
                   (conj statements (str (if (:mutable b) "let " "const ") symbol "=" value ";"))))
          (str "{" (apply str statements) (body (:body expr) e result?) "}")))
      :sequence
      (str (apply str (map #(body % env false) (butlast (:expressions expr))))
           (body (last (:expressions expr)) env result?))
      :if (str "if(" (emit (:condition expr)) "){" (body (:then expr) env result?)
               "}else{" (body (:else expr) env result?) "}")
      :return (str "return " (emit (:value expr)) ";")
      :continue "continue;"
      :break "break;"
      :throw (str "throw " (emit (:value expr)) ";")
      :try-catch
      (let [symbol (fresh counter prefix)]
        (str "try{" (body (:body expr) env result?) "}catch(" symbol "){"
             (body (:handler expr) (assoc env (:binding expr) symbol) result?) "}"))
      :try-finally (str "try{" (body (:body expr) env result?) "}finally{"
                        (body (:finally expr) env false) "}")
      :for
      (let [init (:initializer expr) bindings (:bindings init)
            scope (reduce (fn [e b] (assoc e (:name b) (fresh counter prefix))) env bindings)
            scoped #(emit-expression % imports functions scope counter prefix context)
            head (cond
                   (seq bindings) (str (if (:mutable (first bindings)) "let " "const ")
                                       (str/join "," (map #(str (get scope (:name %)) "=" (scoped (:value %))) bindings)))
                   (:expression init) (emit (:expression init))
                   :else "")]
        (str "for(" head ";" (when (:condition expr) (scoped (:condition expr))) ";"
             (when (:update expr) (scoped (:update expr))) "){" (body (:body expr) scope false) "}"
             (body (:result expr) env result?)))
      :switch
      (let [scope (reduce (fn [e binding] (assoc e (:name binding) (fresh counter prefix))) env (:bindings expr))
            scoped #(emit-expression % imports functions scope counter prefix context)]
        (str "switch(" (emit (:value expr)) "){"
             (apply str (map (fn [clause]
                               (str (if (:default clause) "default:" (str "case " (scoped (:test clause)) ":"))
                                    (apply str (map (fn [statement]
                                                      (if-let [binding (:binding statement)]
                                                        (str (if (:mutable binding) "let " "const ")
                                                             (get scope (:name binding)) "=" (scoped (:value binding)) ";")
                                                        (body (:expression statement) scope false))) (:statements clause))))) (:clauses expr)))
             "}" (body (:result expr) env result?)))
      :while (str "while(" (emit (:condition expr)) "){" (body (:body expr) env false) "}"
                  (body (:result expr) env result?))
      :do-while (str "do{" (body (:body expr) env false) "}while(" (emit (:condition expr)) ");"
                     (body (:result expr) env result?))
      (:for-of :for-in)
      (let [binding (emit-loop-binding (:binding expr) env counter prefix)]
        (str "for(const " (:source binding) (if (= :for-in (:op expr)) " in " " of ") (emit (:iterable expr)) "){"
             (body (:body expr) (:env binding) false) "}"
             (body (:result expr) env result?)))
      (str (when result? "return ") (emit expr) ";"))))

(defn- emit-checked [checked factory public? check-grants?]
  (when (and (not public?) (some #{factory} (:ambient-imports checked)))
    (fail! :mithril.native-js/scope "Native factory binding shadows an ambient import"))
  (let [named-functions (concat (:functions checked)
                                (map #(hash-map :name %) (:ambient-imports checked))
                                (filter #(and (map? %) (string? (:name %)) (contains? #{:local-function :native-function :native-class} (:op %)))
                                        (tree-seq coll? seq checked)))
        prefix (loop [p "__mithril_native_"]
                 (if (some #(str/starts-with? (:name %) p) named-functions)
                   (recur (str p "_")) p))
        counter (atom 0) grants (str prefix "grants")
        ambient (set (:ambient-imports checked))
        alias-factory? (and public? (contains? ambient factory))
        factory-symbol (if alias-factory? (str prefix "factory") factory)
        grant-imports (vec (remove ambient (:imports checked)))
        imports (into {} (map #(vector % (if (contains? ambient %) % (str grants "[" (quoted %) "]"))) (:imports checked)))
        functions (zipmap (map :name (:functions checked)) (map #(str prefix "f" %) (range)))
        lexical-symbols (if (:lexical-bindings checked)
                          (into {} (map #(vector (:name %) (fresh counter prefix)) (:bindings checked))) {})
        module-bindings (loop [todo (:bindings checked) env lexical-symbols statements []]
                          (if-let [b (first todo)]
                            (let [value (emit-expression (:value b) imports functions env counter prefix false)
                                  symbol (or (get lexical-symbols (:name b)) (fresh counter prefix))]
                              (recur (next todo) (assoc env (:name b) symbol)
                                     (conj statements (str (if (:mutable b) "let " "const ") symbol "=" value ";\n"))))
                            {:env env :source (apply str statements)}))
        initialize-functions-first? (some #(#{:function-ref :function-set :call} (:op %))
                                          (tree-seq coll? seq (:bindings checked)))
        function-source (apply str
                      (map (fn [f]
                             (let [{env :env param-source :source} (emit-parameters f imports functions (:env module-bindings) counter prefix true)]
                               (str (if (:mutable f) "let " "const ") (get functions (:name f)) "=function " (:name f) "(" (str/join "," param-source) "){"
                                    (if (:statements f)
                                      (emit-body (:body f) imports functions env counter prefix true true)
                                      (str "return " (emit-expression (:body f) imports functions env counter prefix true) ";")) "};\n"))) (:functions checked)))
        source (str "// Mithril native JS host module; explicit grants; native runtime semantics.\n"
                    (if alias-factory?
                      (str "const " factory-symbol "={[" (quoted factory) "]:function(")
                      (str (if public? "export " "") "function " factory "(")) grants "){\n"
                    (when check-grants?
                      (str
                    "if(" grants "===null||typeof " grants "!=='object')throw new Error('host-grant-mismatch');\n"
                    "const " prefix "keys=Reflect.ownKeys(" grants ");\n"
                    "if(" prefix "keys.length!==" (count grant-imports) "||"
                    prefix "keys.some(k=>!" (quoted (clj->js grant-imports)) ".includes(k)))throw new Error('host-grant-mismatch');\n"))
                    (if initialize-functions-first? function-source "")
                    (:source module-bindings)
                    (if initialize-functions-first? "" function-source)
                    "return {" (str/join "," (map (fn [e]
                                                   (if (:target e)
                                                     (str "[" (quoted (:name e)) "]:" (get functions (:target e)))
                                                     (str "[" (quoted (:name e)) "]:" (emit-expression (:value e) imports functions (:env module-bindings) counter prefix false)))) (:exports checked))) "};\n}"
                    (if alias-factory? (str "}[" (quoted factory) "];\nexport {" factory-symbol " as " factory "};\n") "\n"))]
    (cond-> {:format :mithril.native-js/artifact-v1 :module (:name checked)
             :required-imports grant-imports :exports (mapv :name (:exports checked))
             :runtime :native-js :source source}
      (seq ambient) (assoc :required-ambient-imports (:ambient-imports checked)))))

(defn compile-document [doc] (emit-checked (check-document doc) "instantiateMithrilNative" true true))
(defn compile-text [text] (emit-checked (check-text text) "instantiateMithrilNative" true true))

(defn compile-package-factory-document
  "Private package factory: the checked linker supplies every declared grant.
   Ordinary standalone artifacts retain their exact runtime grant validation."
  [doc factory]
  (name! factory)
  (when (contains? reserved factory)
    (fail! :mithril.native-js/name "Reserved package factory identifier"))
  (emit-checked (check-document doc) factory false false))

(defn compile-esm-document
  "Emit a checked native module with real named/namespace ESM imports and exports. Link paths
   are inert generated local basenames or explicitly declared external specifiers;
   declarations remain engine-owned."
  ([doc links dependencies] (compile-esm-document doc links dependencies []))
  ([doc links dependencies external-specifiers]
  (let [checked (check-document doc)
        _ (vector! links 128) _ (vector! dependencies 64)
        _ (vector! external-specifiers 64) _ (unique! external-specifiers)
        _ (doseq [specifier external-specifiers]
            (when-not (and (string? specifier) (<= 1 (count specifier) 512)
                           (or (re-matches #"node:[a-z][a-z0-9_]*(?:/[a-z][a-z0-9_]*)*" specifier)
                               (re-matches #"(?:@[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)*/)?[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)*)*" specifier)))
             (fail! :mithril.native-js/link "Invalid external module specifier")))
        path! (fn [path]
                (when-not (and (string? path) (or (re-matches #"\./module-[0-9]+\.mjs" path) (some #{path} external-specifiers)))
                  (fail! :mithril.native-js/link "Expected a generated local ESM module basename")))
        _ (doseq [path dependencies] (path! path)) _ (unique! dependencies)
        _ (doseq [link links]
            (shape! link ["import" "source" "export"])
            (name! (get link "import")) (when-not (= "*" (get link "export")) (name! (get link "export"))) (path! (get link "source"))
            (when-not (and (some #{(get link "import")} (:imports checked))
                           (some #{(get link "source")} dependencies))
              (fail! :mithril.native-js/link "Unknown linked import or unordered dependency")))
        _ (unique! (mapv #(get % "import") links))
        _ (when (some (set (:ambient-imports checked)) (map #(get % "import") links))
            (fail! :mithril.native-js/link "Ambient imports cannot also be linked ESM imports"))
        declared-names (concat (map #(get % "import") links)
                               (map :name (:functions checked)) (map :name (:bindings checked)))
        _ (unique! declared-names)
        _ (doseq [name (concat declared-names (mapcat #(mapcat binding-names (:params %)) (:functions checked)))]
            (when (contains? reserved name)
              (fail! :mithril.native-js/name "Reserved native ESM declaration binding")))
        ;; All compiler-owned names avoid native self bindings and source function
        ;; declarations, including names nested in keys/defaults/initializers.
        _ (letfn [(walk [x shadows]
                    (cond
                      (map? x)
                      (let [self (when (contains? #{:native-function :native-class} (:op x)) (:name x))
                            shadows (cond-> shadows (some? self) (conj self))]
                        (when (and (contains? shadows (:name x))
                                   (or (and (= :import (:op x)) (some #(= (:name x) (get % "import")) links))
                                       (contains? #{:function-ref :function-set :call} (:op x))))
                          (fail! :mithril.native-js/scope "Native ESM self binding shadows an explicit module reference"))
                        (doseq [v (vals x)] (walk v shadows)))
                      (coll? x) (doseq [v x] (walk v shadows))))]
            (walk checked #{}))
        names (concat (:ambient-imports checked) (map :name (:functions checked))
                      (keep :name (filter map? (tree-seq coll? seq checked))))
        prefix (loop [p "__mithril_esm_"]
                 (if (some #(and (string? %) (str/starts-with? % p)) names)
                   (recur (str p "_")) p))
        counter (atom 0)
        globals (str prefix "globals")
        link-symbols (into {} (map #(vector (get % "import") (get % "import")) links))
        ambient (set (:ambient-imports checked))
        imports (into {} (map #(vector % (if (contains? ambient %) % (or (get link-symbols %) (str globals "[" (quoted %) "]")))) (:imports checked)))
        functions (into {} (map #(vector (:name %) (:name %)) (:functions checked)))
        env (into {} (map #(vector (:name %) (:name %)) (:bindings checked)))
        dependency-source (apply str
                             (map (fn [path]
                                    (let [imports (filter #(= path (get % "source")) links)
                                          named (remove #(= "*" (get % "export")) imports)
                                          namespaces (filter #(= "*" (get % "export")) imports)]
                                      (if (seq imports)
                                        (str (when (seq named)
                                               (str "import {" (str/join "," (map #(str (quoted (get % "export")) " as " (get link-symbols (get % "import"))) named)) "} from " (quoted path) ";\n"))
                                             (apply str (map #(str "import * as " (get link-symbols (get % "import")) " from " (quoted path) ";\n") namespaces)))
                                        (str "import " (quoted path) ";\n")))) dependencies))
        function-source (apply str
                           (map (fn [f]
                                  (let [{body-env :env signature :source} (emit-parameters f imports functions env counter prefix true)]
                                    (str "function " (:name f) "(" (str/join "," signature) "){"
                                         (if (:statements f)
                                           (emit-body (:body f) imports functions body-env counter prefix true true)
                                           (str "return " (emit-expression (:body f) imports functions body-env counter prefix true) ";")) "}\n"))) (:functions checked)))
        binding-source (apply str
                          (map (fn [b]
                                 (str (if (:mutable b) "let " "const ") (get env (:name b)) "="
                                      (emit-expression (:value b) imports functions env counter prefix false) ";\n")) (:bindings checked)))
        export-source (apply str
                         (map (fn [e]
                                (let [value (:value e)
                                      live (or (get functions (:target e))
                                               (case (:op value)
                                                 :local (get env (:name value))
                                                 :function-ref (get functions (:name value))
                                                 :import (get link-symbols (:name value))
                                                 nil))
                                      symbol (or live (fresh counter prefix))]
                                  (str (when-not live
                                         (str "const " symbol "=" (emit-expression value imports functions env counter prefix false) ";\n"))
                                       "export {" symbol " as " (quoted (:name e)) "};\n"))) (:exports checked)))]
    (cond-> {:format :mithril.native-esm/module-v1 :runtime :native-js :module (:name checked)
     :required-imports (vec (remove #(or (contains? link-symbols %) (contains? ambient %)) (:imports checked)))
     :exports (mapv :name (:exports checked))
     :source (str "// Checked Mithril native ESM; engine-owned live bindings and initialization.\n"
                  ;; Pure host adapter initializes before a source back edge can
                  ;; call this module's hoisted declaration using a capability.
                  (when (some #(and (not (contains? link-symbols %)) (not (contains? ambient %))) (:imports checked))
                    (str "import {globals as " globals "} from './host-globals.mjs';\n"))
                  dependency-source function-source binding-source export-source)}
      (seq ambient) (assoc :required-ambient-imports (:ambient-imports checked))))))
