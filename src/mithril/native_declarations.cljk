(ns mithril.native-declarations
 "Admission of inert native declaration AST: syntax, scope, arity, surface and budgets."
 (:require [clojure.string :as str] [mithril.form :as form] [mithril.module :as module]))
(def ^:private reserved #{"break" "case" "catch" "class" "const" "continue" "debugger" "default" "delete" "do" "else" "enum" "export" "extends" "false" "finally" "for" "function" "if" "import" "in" "instanceof" "let" "new" "null" "return" "super" "switch" "this" "throw" "true" "try" "var" "void" "while" "with" "yield" "await"})
(defn- fail! [code text] (throw (ex-info text {:mithril/error code})))
(defn- shape! [x fields]
 (when-not (and (map? x) (= (set fields) (set (keys x)))) (fail! :mithril.native-declarations/shape "Unexpected declaration fields")))
(defn- vector! [x n]
 (when-not (and (vector? x) (<= (count x) n)) (fail! :mithril.native-declarations/budget "Declaration collection budget")))
(defn- unique! [xs]
 (when-not (= (count xs) (count (set xs))) (fail! :mithril.native-declarations/duplicate "Duplicate declaration")))
(defn- identifier! [s]
 (when-not (and (string? s) (<= (count s) 128) (re-matches #"[A-Za-z_][A-Za-z0-9_]*" s) (not (contains? reserved s)))
  (fail! :mithril.native-declarations/name "Invalid declaration identifier")) s)
(defn- type-identifier! [s]
 (identifier! s)
 (when (contains? #{"any" "unknown" "never" "string" "number" "boolean" "object" "symbol" "undefined"} s) (fail! :mithril.native-declarations/name "Type keyword is not a type binding")) s)
(defn- qualified! [s]
 (when-not (and (string? s) (<= (count s) 256) (seq s)) (fail! :mithril.native-declarations/name "Invalid qualified name"))
 (doseq [p (str/split s #"\." -1)] (identifier! p)) s)
(defn- flag! [x] (when-not (boolean? x) (fail! :mithril.native-declarations/shape "Expected boolean flag")))
(defn- text! [s] (when-not (and (string? s) (<= (count s) 4096)) (fail! :mithril.native-declarations/budget "Expected bounded text data")))
(defn- nullable-type! [v]
 (when-not (or (nil? v) (map? v)) (fail! :mithril.native-declarations/type "Optional type must be nil or a structured node")))
(defn- source! [s]
 (when-not (and (string? s) (re-matches #"[A-Za-z0-9][A-Za-z0-9_-]*\.mith" s)) (fail! :mithril.native-declarations/source "Expected local runtime Mithril basename")))
(defn- charge! [budget depth]
 (when (or (> depth 64) (> (swap! budget inc) 16384)) (fail! :mithril.native-declarations/budget "Declaration node/depth budget")))
(defn parse-text [text] (module/check-source-text! text) (form/parse text))
(defn runtime-basename [text]
 (let [doc (parse-text text)]
  (shape! doc ["@context" "@type" "name" "runtime-source" "ambient-types" "ambient-values" "declarations"])
  (when-not (and (= "NativeJsDeclarations" (get doc "@type")) (= "https://mithril.fund/context/native-js-declarations/v1" (get doc "@context")))
   (fail! :mithril.native-declarations/context "Expected native declaration context"))
  (source! (get doc "runtime-source")) (get doc "runtime-source")))
(defn- arity [params]
 (vector! params 32)
 (doseq [p params] (shape! p ["name" "constraint" "default"]) (type-identifier! (get p "name")) (nullable-type! (get p "constraint")) (nullable-type! (get p "default")))
 (unique! (mapv #(get % "name") params))
 (let [required (count (take-while #(nil? (get % "default")) params))]
  (when (some #(nil? (get % "default")) (drop required params)) (fail! :mithril.native-declarations/arity "Required generic after default"))
  {:min required :max (count params)}))
(defn- class-params! [params]
 (vector! params 32)
 (doseq [p params]
  (shape! p ["name" "constraint" "default" "variance"])
  (when-not (contains? #{nil "in" "out" "in-out"} (get p "variance"))
   (fail! :mithril.native-declarations/type "Invalid class variance")))
 (let [plain (mapv #(dissoc % "variance") params)] (arity plain) plain))
(defn- class-key! [key]
 (case (get key "kind")
  "name" (do (shape! key ["kind" "name"]) (text! (get key "name")))
  "computed" (do (shape! key ["kind" "name"]) (qualified! (get key "name")))
  (fail! :mithril.native-declarations/type "Unknown class member key")))
(defn- visibility! [v]
 (when-not (contains? #{"public" "protected" "private"} v)
  (fail! :mithril.native-declarations/type "Unknown class visibility")))
(defn- class-member-shape! [m]
 (visibility! (get m "visibility"))
 (case (get m "kind")
  "constructor" (shape! m ["kind" "visibility" "params"])
  "property" (shape! m ["kind" "key" "visibility" "static" "readonly" "optional" "datatype"])
  "opaque" (do (shape! m ["kind" "key" "visibility" "static"])
    (when-not (and (= "private" (get m "visibility")) (= "name" (get-in m ["key" "kind"])))
     (fail! :mithril.native-declarations/type "Only named private members may omit their type")))
  "method" (shape! m ["kind" "key" "visibility" "static" "abstract" "optional" "type-params" "params" "returns"])
  "getter" (shape! m ["kind" "key" "visibility" "static" "datatype"])
  (fail! :mithril.native-declarations/type "Unknown class member"))
 (when-not (= "constructor" (get m "kind"))
  (class-key! (get m "key")) (flag! (get m "static")))
 (when (contains? m "optional") (flag! (get m "optional")))
 (when (contains? m "readonly") (flag! (get m "readonly")))
 (when (contains? m "abstract") (flag! (get m "abstract"))))
(defn- add! [registry space name value]
 (when (contains? (get @registry space) name) (fail! :mithril.native-declarations/duplicate "Duplicate declaration symbol"))
 (swap! registry assoc-in [space name] value))
(defn- declaration-shape! [d]
 (case (get d "kind")
  "function" (shape! d ["kind" "name" "exported" "type-params" "params" "returns"])
  "const" (shape! d ["kind" "name" "exported" "datatype"])
  "alias" (shape! d ["kind" "name" "exported" "type-params" "datatype"])
  "interface" (do (shape! d (cond-> ["kind" "name" "exported" "type-params" "members"] (contains? d "extends") (conj "extends")))
                  (when (contains? d "extends") (vector! (get d "extends") 32)))
  "namespace" (shape! d ["kind" "name" "exported" "declarations"])
  "class" (do (shape! d ["kind" "name" "exported" "abstract" "type-params" "extends" "implements" "members"]) (flag! (get d "abstract")) (class-params! (get d "type-params")) (nullable-type! (get d "extends")) (vector! (get d "implements") 32) (vector! (get d "members") 256) (doseq [m (get d "members")] (class-member-shape! m)))
  "export-alias" (shape! d ["kind" "name" "target"])
  (fail! :mithril.native-declarations/declaration "Unknown declaration kind"))
 (identifier! (get d "name"))
 (when-not (= "export-alias" (get d "kind")) (flag! (get d "exported"))))
(declare namespace-value? register!)
(defn- merged-params! [ds]
 (let [lists (mapv #(if (= "class" (get % "kind")) (class-params! (get % "type-params")) (get % "type-params")) ds)
       size (apply max (map count lists))
       params (mapv (fn [index]
         (let [slots (keep #(get % index) lists) names (set (map #(get % "name") slots))
               constraints (set (keep #(get % "constraint") slots)) defaults (set (keep #(get % "default") slots))]
          (when (or (not= 1 (count names)) (> (count constraints) 1) (> (count defaults) 1)
                    (and (< (count slots) (count lists)) (empty? defaults)))
           (fail! :mithril.native-declarations/duplicate "Incompatible merged type parameters"))
          {"name" (first names) "constraint" (first constraints) "default" (first defaults)})) (range size))]
  (arity params) params))
(defn- member-identity [m]
 (if (contains? #{"call" "construct"} (get m "kind")) [(get m "kind")]
  [(if (str/starts-with? (get m "kind" "") "computed-") "computed" "name") (get m "name")]))
(defn- merged-members! [interfaces klass]
 (let [members (vec (mapcat #(get % "members") interfaces))]
  (vector! members 256)
  (doseq [[_ ms] (group-by member-identity members) :when (> (count ms) 1)]
   (when-not (or (apply = ms)
                 (and (every? #(contains? #{"method" "computed-method" "call" "construct"} (get % "kind")) ms)
                      (= 1 (count (set (map #(select-keys % ["kind" "optional"]) ms))))))
    (fail! :mithril.native-declarations/duplicate "Incompatible merged interface member")))
  (when klass
   (doseq [m (get klass "members") :when (and (not (get m "static")) (not= "constructor" (get m "kind")))
           im members :when (= [(get-in m ["key" "kind"]) (get-in m ["key" "name"])] (member-identity im))]
    (let [method? (= "method" (get m "kind"))
          compatible (if method?
                       (and (contains? #{"method" "computed-method"} (get im "kind")) (= (get m "optional") (get im "optional")))
                       (and (contains? #{"property" "getter"} (get m "kind")) (contains? #{"property" "computed-property"} (get im "kind"))
                            (if (= "getter" (get m "kind"))
                             (and (not (get im "optional")) (not (get im "readonly")) (= (get m "datatype") (get im "datatype")))
                             (= (select-keys m ["optional" "readonly" "datatype"]) (select-keys im ["optional" "readonly" "datatype"])))))]
     (when-not (and (= "public" (get m "visibility")) compatible)
      (fail! :mithril.native-declarations/duplicate "Class/interface member or visibility collision"))))) members))
(defn- group-info! [ds]
 (doseq [d ds] (declaration-shape! d))
 (let [by-kind (group-by #(get % "kind") ds) kinds (set (keys by-kind))
       klass (first (get by-kind "class")) aliases (get by-kind "alias") interfaces (get by-kind "interface")
       types (filterv #(contains? #{"class" "interface" "alias"} (get % "kind")) ds)
       values (filterv #(or (contains? #{"class" "function" "const"} (get % "kind")) (and (= "namespace" (get % "kind")) (namespace-value? %))) ds)
       namespaces (get by-kind "namespace")]
  (when (or (> (count aliases) 1) (> (count (get by-kind "class")) 1) (> (count (get by-kind "const")) 1)
            (and aliases (or klass (seq interfaces)))
            (and (contains? kinds "const") (or klass (contains? kinds "function") (some namespace-value? namespaces)))
            (and (contains? kinds "export-alias") (> (count ds) 1)))
   (fail! :mithril.native-declarations/duplicate "Incompatible declaration merge"))
  (doseq [space [types values namespaces] :when (seq space)]
   (when (> (count (set (map #(get % "exported") space))) 1)
    (fail! :mithril.native-declarations/duplicate "Inconsistent merged space visibility")))
  (doseq [d ds :when (contains? #{"function" "alias" "interface"} (get d "kind"))] (arity (get d "type-params")))
  (merged-members! interfaces klass)
  (let [bases (vec (distinct (mapcat #(get % "extends") interfaces)))]
   (vector! bases 32)
   {:kinds kinds :klass klass :interfaces interfaces :bases bases :types types :namespaces namespaces
    :params (when (seq types) (merged-params! types))})))
(defn- block-view [registry id]
 (let [root (or (:public registry) registry)]
  (if id
   (let [r (block-view root (first id)) private (get-in root [:blocks id])]
    (assoc (reduce (fn [r space] (update r space merge (get private space))) r [:types :values :namespaces])
           :public root :context-id id)) root)))
(defn- definition-view [registry metadata] (block-view registry (:context metadata)))
(defn- block-overlay [registry scope index] (block-view registry [(:context-id registry) scope index]))
(defn- register!
 ([decls prefix registry depth] (register! decls prefix registry depth (repeat (count decls) nil)))
 ([decls prefix registry depth contexts] (register! decls prefix registry depth contexts (range (count decls))))
 ([decls prefix registry depth contexts positions]
 (when (> depth 8) (fail! :mithril.native-declarations/budget "Namespace depth budget"))
 (vector! decls 256)
 (doseq [[name entries] (group-by #(get (first %) "name") (map vector decls contexts positions))]
  (let [ds (mapv first entries) {:keys [kinds klass types namespaces params]} (group-info! ds) n (str prefix name)
        type-entry (or (first (filter #(= "class" (get (first %) "kind")) entries)) (first (filter #(contains? #{"interface" "alias"} (get (first %) "kind")) entries)))
        class-context (second (first (filter #(= "class" (get (first %) "kind")) entries)))
        heritage (vec (distinct (mapcat (fn [[d c]] (case (get d "kind")
                               "class" (when-let [base (get d "extends")] [{:node base :context c}])
                               "interface" (map #(hash-map :node % :context c) (get d "extends")) [])) entries)))]
   (vector! heritage 32)
   (when (seq types)
    (type-identifier! name)
    (add! registry :types n (assoc (arity params) :params params :kind (if klass "class" (get (first types) "kind"))
                                 :base (get klass "extends") :heritage heritage :context (second type-entry)
                                 :scope prefix :exported (get (first types) "exported"))))
   (when-let [[v context] (or (first (filter #(= "class" (get (first %) "kind")) entries))
                            (first (filter #(contains? #{"function" "const"} (get (first %) "kind")) entries)))]
    (add! registry :values n (cond-> {:kind (get v "kind") :context context :scope prefix :exported (get v "exported")}
                             klass (assoc :class-name n)
                             (= "const" (get v "kind")) (assoc :datatype (get v "datatype")))))
   (when klass
    (doseq [[key ms] (group-by #(get-in % ["key" "name"]) (filter #(and (get % "static") (= "name" (get-in % ["key" "kind"]))) (get klass "members")))]
     (identifier! key)
     (let [m (first ms)]
      (add! registry :values (str n "." key) {:kind (get m "kind") :scope prefix :context class-context :exported (get klass "exported") :owner n :visibility (get m "visibility") :datatype (get m "datatype")}))))
   (when (seq namespaces)
    (add! registry :namespaces n {:value? (boolean (some namespace-value? namespaces)) :scope prefix :exported (get (first namespaces) "exported")})
    (let [child-prefix (str n ".") blocks (filter #(= "namespace" (get (first %) "kind")) entries)
          public (vec (mapcat (fn [[d c index]] (let [id [c prefix index]] (keep-indexed (fn [i child] (when (get child "exported") [child id i])) (get d "declarations")))) blocks))]
     (register! (mapv first public) child-prefix registry (inc depth) (mapv second public) (mapv #(nth % 2) public))
     (doseq [[d c index] blocks]
      (let [id [c prefix index] children (get d "declarations") private (vec (keep-indexed (fn [i child] (when-not (get child "exported") [child i])) children))
            local (atom {:types {} :values {} :namespaces {} :blocks {}})]
       (vector! children 256)
       (doseq [[_ group] (group-by #(get % "name") children)] (group-info! group))
       (register! (mapv first private) child-prefix local (inc depth) (repeat (count private) id) (mapv second private))
       (swap! local (fn [r] (reduce (fn [r space] (update r space #(into {} (map (fn [[k v]] [k (assoc v :lexical true)]) %)))) r [:types :values :namespaces])))
       (swap! registry update :blocks merge (:blocks @local))
       (swap! registry assoc-in [:blocks id] (dissoc @local :blocks))))))
   (when (and (contains? kinds "export-alias") (pos? depth))
    (fail! :mithril.native-declarations/declaration "Export aliases are top-level"))))))
(defn- accessible? [metadata scope]
 (or (nil? (:scope metadata)) (empty? (:scope metadata)) (:exported metadata) (str/starts-with? scope (:scope metadata))))
(defn- resolve-entry [registry space scope n]
 (some (fn [prefix]
  (let [candidate (str prefix n) qualified? (str/includes? n ".") receiver (str prefix (first (str/split n #"\.")))
        ns (when qualified? (get-in registry [:namespaces receiver]))
        lookup (if (and ns (not (:lexical ns))) (or (:public registry) registry) registry)
        metadata (get-in lookup [space candidate]) parts (str/split candidate #"\.")
        parents (map #(str/join "." (take % parts)) (range 1 (count parts)))]
   (when (and metadata (accessible? metadata scope)
              (or (not ns) (:owner metadata) (:exported metadata))
              (every? #(let [p (get-in lookup [:namespaces %])]
                         (and (accessible? p scope)
                              (or (not ns) (not (str/starts-with? % (str receiver "."))) (:exported p)))) parents))
    ;; Return metadata from the chosen public/lexical view, even when a private
    ;; same-name binding shadows it in the current namespace block.
    [candidate metadata])))
  (let [parts (vec (remove str/blank? (str/split scope #"\.")))]
   (map #(when (pos? %) (str (str/join "." (take % parts)) ".")) (range (count parts) -1 -1)))))
(defn- value-metadata [registry scope name depth]
 (when (> depth 32) (fail! :mithril.native-declarations/budget "Value member query depth"))
 (if-let [entry (resolve-entry registry :values scope name)]
  (second entry)
  (let [parts (str/split name #"\.") field (last parts) parent (str/join "." (butlast parts))]
   (when (seq parent)
    (when-let [base (value-metadata registry scope parent (inc depth))]
     (if (= "class" (:kind base))
      (let [r (definition-view registry base) class-name (:class-name base) t (get-in r [:types class-name])
            member (get-in r [:values (str class-name "." field)])]
       (or (when (or (= class-name (:owner member))
                     (and (:exported member) (= (str class-name ".") (:scope member)))) member)
           (when-let [parent-type (:base t)]
            (value-metadata r (:scope t) (str (get parent-type "name") "." field) (inc depth)))))
      (let [datatype (loop [t (:datatype base) depth depth]
                      (when (> depth 32) (fail! :mithril.native-declarations/budget "Value type query cycle/depth"))
                      (if (= "typeof" (get t "op"))
                       (recur (:datatype (value-metadata registry scope (get t "name") (inc depth))) (inc depth)) t))
            member (when (= "object" (get datatype "op"))
                     (first (filter #(= field (get % "name")) (get datatype "members"))))]
       (when (= "property" (get member "kind")) (assoc base :datatype (get member "datatype"))))))))))

(defn- type-identity [entry] [(first entry) (:context (second entry))])
(defn- subclass-of? [registry name owner]
 (loop [entry [name (get-in registry [:types name])] seen #{}]
  (cond
   (= (type-identity entry) owner) true
   (or (nil? (first entry)) (contains? seen (type-identity entry))) false
   :else (let [t (second entry) base (:base t) r (definition-view registry t)]
           (recur (when base (resolve-entry r :types (:scope t) (get base "name"))) (conj seen (type-identity entry)))))))
(defn- value-known? [registry scope env values name]
 (when (and (str/includes? name ".") (contains? values (first (str/split name #"\."))))
  (fail! :mithril.native-declarations/scope "Qualified query cannot borrow a shadowed outer value"))
 (or (contains? values name)
     (when-let [v (value-metadata registry scope name 0)]
      (when (and (contains? #{"private" "protected"} (:visibility v))
                 (not (let [owner [(:owner v) (:context v)] current [(:class (meta env)) (:context (get-in registry [:types (:class (meta env))]))]]
                        (if (= "protected" (:visibility v)) (subclass-of? registry (:class (meta env)) owner) (= owner current)))))
       (fail! :mithril.native-declarations/scope "Non-public static class member")) true)
     (let [entry (resolve-entry registry :namespaces scope name)] (true? (:value? (second entry))))))
(declare check-type! check-members!)
(defn- generic-env! [params env values mode depth budget registry scope]
 (arity params)
 (let [all (into env (map #(get % "name") params))]
  (loop [xs params previous env]
   (when-let [p (first xs)]
    (when-let [c (get p "constraint")] (check-type! c all values :normal (inc depth) budget registry scope nil))
    (when-let [d (get p "default")] (check-type! d previous values :normal (inc depth) budget registry scope nil))
    (recur (next xs) (conj previous (get p "name"))))) all))
(defn- signature! [x env values mode depth budget registry scope constructor?]
 (let [tenv (generic-env! (get x "type-params") env values mode depth budget registry scope)
       params (get x "params")]
  (vector! params 64)
  (doseq [[index p] (map-indexed vector params)]
   (shape! p ["name" "optional" "rest" "datatype"]) (flag! (get p "optional")) (flag! (get p "rest"))
   (if (= "this" (get p "name"))
    (when (or constructor? (pos? index) (get p "optional") (get p "rest"))
     (fail! :mithril.native-declarations/params "Receiver must be first, required, non-rest and non-constructor"))
    (identifier! (get p "name"))))
  (unique! (mapv #(get % "name") params))
  (when (or (some #(get % "rest") (butlast params)) (some #(and (get % "optional") (get % "rest")) params))
   (fail! :mithril.native-declarations/params "Rest parameter must be final and required"))
  (loop [xs params optional? false]
   (when-let [p (first xs)]
    (when (and optional? (not (get p "optional")) (not (get p "rest"))) (fail! :mithril.native-declarations/params "Required parameter after optional"))
    (recur (next xs) (or optional? (get p "optional")))))
  (let [names (set (map #(get % "name") params)) venv (into values names)
        binds (reduce into #{} (map #(check-type! (get % "datatype") tenv venv mode (inc depth) budget registry scope nil) params))
        ret (check-type! (get x "returns") tenv venv mode (inc depth) budget registry scope (when-not constructor? (cond-> names (:this? (meta env)) (conj "this"))))]
   (into binds ret))))
(defn- check-tuple! [items env values mode depth budget registry scope]
 (vector! items 128)
 (loop [xs items optional? false binds #{}]
  (if-let [item (first xs)]
   (let [named? (= "named-tuple-item" (get item "op"))
         opt? (and named? (get item "optional"))]
    (when named?
     (charge! budget (inc depth))
     (shape! item ["op" "name" "optional" "datatype"])
     (identifier! (get item "name")) (flag! (get item "optional")))
    (when (and optional? (not opt?))
     (fail! :mithril.native-declarations/tuple "Required tuple element after optional"))
    (recur (next xs) (or optional? opt?)
           (into binds (check-type! (if named? (get item "datatype") item) env values mode (if named? (+ depth 2) (inc depth)) budget registry scope nil))))
   binds)))
(defn- check-type! [x env values mode depth budget registry scope predicate-names]
 (charge! budget depth)
 (when-not (map? x) (fail! :mithril.native-declarations/type "Expected structured type"))
 (let [op (get x "op") child-mode (if (= :unique mode) :normal mode) check #(check-type! % env values child-mode (inc depth) budget registry scope nil)
       normal #(check-type! % env values :normal (inc depth) budget registry scope nil)
       items! (fn [items] (vector! items 128) (when (empty? items) (fail! :mithril.native-declarations/type "Empty type collection")) (reduce into #{} (map check items)))]
  (case op
   "this" (do (shape! x ["op"]) (when-not (:this? (meta env)) (fail! :mithril.native-declarations/scope "This type requires instance class/interface scope")) #{})
   "unique-symbol" (do (shape! x ["op"]) (when-not (= :unique mode) (fail! :mithril.native-declarations/type "Unique symbol requires const or readonly static class property")) #{})
   "keyword" (do (shape! x ["op" "name"]) (when-not (contains? #{"any" "unknown" "never" "string" "number" "boolean" "void" "undefined" "object" "symbol"} (get x "name")) (fail! :mithril.native-declarations/type "Unknown type keyword")) #{})
   "name" (do (shape! x ["op" "name" "args"]) (qualified! (get x "name")) (vector! (get x "args") 32)
    (let [n (get x "name") local? (contains? env n) a (if local? {:min 0 :max 0} (second (resolve-entry registry :types scope n)))]
     (when-not (and a (<= (:min a) (count (get x "args")) (:max a))) (fail! :mithril.native-declarations/arity "Unknown type name or wrong generic arity"))
     (reduce into #{} (map check (get x "args")))))
   "literal" (do (shape! x ["op" "value"]) (when-not (and (not (identical? js/undefined (get x "value"))) (or (nil? (get x "value")) (string? (get x "value")) (boolean? (get x "value")) (and (number? (get x "value")) (js/Number.isFinite (get x "value"))))) (fail! :mithril.native-declarations/type "Expected finite type literal")) (when (string? (get x "value")) (text! (get x "value"))) #{})
   "array" (do (shape! x ["op" "item"]) (check (get x "item")))
   "tuple" (do (shape! x ["op" "items"]) (check-tuple! (get x "items") env values child-mode depth budget registry scope))
   ("union" "intersection") (do (shape! x ["op" "items"]) (items! (get x "items")))
   "keyof" (do (shape! x ["op" "datatype"]) (check (get x "datatype")))
   "readonly" (do (shape! x ["op" "datatype"]) (when-not (contains? #{"array" "tuple"} (get-in x ["datatype" "op"])) (fail! :mithril.native-declarations/type "Readonly type requires array or tuple")) (check (get x "datatype")))
   "typeof" (do (shape! x ["op" "name"]) (qualified! (get x "name"))
    (when-not (value-known? registry scope env values (get x "name")) (fail! :mithril.native-declarations/scope "Unknown value in type query")) #{})
   "index" (do (shape! x ["op" "object" "key"]) (into (check (get x "object")) (check (get x "key"))))
   "conditional" (do (shape! x ["op" "test" "extends" "then" "else"])
    (normal (get x "test"))
    (let [inferred (check-type! (get x "extends") env values :pattern (inc depth) budget registry scope nil)]
     (check-type! (get x "then") (into env inferred) values :normal (inc depth) budget registry scope nil)
     (normal (get x "else"))) #{})
   "infer" (do (shape! x ["op" "name" "constraint"]) (identifier! (get x "name"))
    (when-not (= :pattern mode) (fail! :mithril.native-declarations/scope "Infer is confined to conditional extends patterns"))
    (nullable-type! (get x "constraint")) (when-let [c (get x "constraint")] (normal c)) #{(get x "name")})
   ("function" "constructor") (do (shape! x ["op" "abstract" "type-params" "params" "returns"]) (flag! (get x "abstract"))
    (when (and (= op "function") (get x "abstract")) (fail! :mithril.native-declarations/type "Abstract flag is constructor-only"))
    (signature! x env values child-mode depth budget registry scope (= op "constructor")))
   "predicate" (do (shape! x ["op" "name" "datatype"]) (when-not (= "this" (get x "name")) (identifier! (get x "name")))
    (when-not (contains? predicate-names (get x "name")) (fail! :mithril.native-declarations/scope "Predicate must refine its own parameter")) (normal (get x "datatype")) #{})
   "object" (do (shape! x ["op" "members"]) (check-members! (get x "members") env values child-mode depth budget registry scope))
   "mapped" (do (shape! x ["op" "name" "keys" "remap" "readonly" "optional" "value"]) (identifier! (get x "name")) (flag! (get x "readonly")) (flag! (get x "optional")) (nullable-type! (get x "remap"))
    (let [binds (check (get x "keys")) e (conj env (get x "name"))]
     (when-let [r (get x "remap")] (check-type! r e values child-mode (inc depth) budget registry scope nil))
     (into binds (check-type! (get x "value") e values child-mode (inc depth) budget registry scope nil))))
   "template" (do (shape! x ["op" "head" "spans"]) (text! (get x "head")) (vector! (get x "spans") 128)
    (reduce into #{} (map #(do (shape! % ["datatype" "tail"]) (text! (get % "tail")) (check (get % "datatype"))) (get x "spans"))))
   (fail! :mithril.native-declarations/type "Unknown type operation"))))
(defn- check-members! [members env values mode depth budget registry scope]
 (vector! members 256)
 (doseq [[_ ms] (group-by #(if (contains? #{"call" "construct"} (get % "kind")) [(get % "kind")]
                            [(if (str/starts-with? (get % "kind" "") "computed-") "computed" "name") (get % "name")]) members)
         :when (> (count ms) 1)]
  (when-not (and (every? #(contains? #{"method" "computed-method" "call" "construct"} (get % "kind")) ms)
                 (= 1 (count (set (map #(select-keys % ["kind" "optional"]) ms)))))
   (fail! :mithril.native-declarations/duplicate "Interface/object overload or member collision")))
 (reduce into #{} (map (fn [m]
  (charge! budget (inc depth))
  (when-not (contains? #{"call" "construct"} (get m "kind"))
   (text! (get m "name")) (flag! (get m "optional")))
  (when (contains? #{"computed-property" "computed-method"} (get m "kind"))
   (qualified! (get m "name"))
   (when-not (value-known? registry scope env values (get m "name"))
    (fail! :mithril.native-declarations/scope "Unknown computed type member value")))
  (case (get m "kind")
   ("property" "computed-property") (do (shape! m ["kind" "name" "optional" "readonly" "datatype"]) (flag! (get m "readonly")) (check-type! (get m "datatype") env values mode (inc depth) budget registry scope nil))
   ("method" "computed-method") (do (shape! m ["kind" "name" "optional" "type-params" "params" "returns"]) (signature! m env values mode (inc depth) budget registry scope false))
   ("call" "construct") (do (shape! m ["kind" "type-params" "params" "returns"]) (signature! m env values mode (inc depth) budget registry scope (= "construct" (get m "kind"))))
   (fail! :mithril.native-declarations/type "Unknown type member"))) members)))
(defn- class-env [env class-name instance?]
 (with-meta env {:class class-name :this? instance?}))
(defn- check-class! [d env values depth budget registry scope]
 (let [name (str scope (get d "name"))
       e (generic-env! (class-params! (get d "type-params")) env values :normal depth budget registry scope)
       members (get d "members") groups (group-by #(if (= "constructor" (get % "kind")) :constructor [(get % "static") (get % "key")]) members)]
  (when-let [base (get d "extends")]
   (when-not (= "name" (get base "op")) (fail! :mithril.native-declarations/type "Class base requires named constructor type"))
   (check-type! base e values :normal (inc depth) budget registry scope nil)
   (let [v (value-metadata registry scope (get base "name") 0)]
    (when-not (or (= "class" (:kind v)) (= "ambient" v)) (fail! :mithril.native-declarations/type "Class base requires declared constructor value"))))
  (doseq [t (get d "implements")]
   (when-not (= "name" (get t "op")) (fail! :mithril.native-declarations/type "Implements requires named type"))
   (check-type! t e values :normal (inc depth) budget registry scope nil))
  (doseq [[_ ms] groups :when (> (count ms) 1)]
   (when-not (and (or (every? #(= "constructor" (get % "kind")) ms) (every? #(= "method" (get % "kind")) ms))
                 (= 1 (count (set (map #(select-keys % ["visibility" "abstract" "optional"]) ms)))))
    (fail! :mithril.native-declarations/duplicate "Class overload/member collision")))
  (doseq [m members]
   (charge! budget (inc depth))
   (let [kind (get m "kind") instance? (and (not (get m "static")) (not= kind "constructor"))
         menv (class-env (if (get m "static") env e) name instance?)]
    (when-not (= kind "constructor") (charge! budget (+ depth 2)))
    (when (= "computed" (get-in m ["key" "kind"]))
     (when-not (value-known? registry scope menv values (get-in m ["key" "name"]))
      (fail! :mithril.native-declarations/scope "Unknown computed class member value")))
    (case kind
     "opaque" nil
     "property" (check-type! (get m "datatype") menv values (if (and (get m "static") (get m "readonly") (not (get m "optional"))) :unique :normal) (+ depth 2) budget registry scope nil)
     "getter" (check-type! (get m "datatype") menv values :normal (+ depth 2) budget registry scope nil)
     "constructor" (signature! {"type-params" [] "params" (get m "params") "returns" {"op" "keyword" "name" "void"}} menv values :normal (inc depth) budget registry scope true)
     "method" (do
       (when (and (get m "abstract") (or (not (get d "abstract")) (get m "static") (= "private" (get m "visibility"))))
        (fail! :mithril.native-declarations/type "Abstract method requires abstract instance class and non-private visibility"))
       (signature! m menv values :normal (inc depth) budget registry scope false)))))))
(defn- class-inheritance! [registry]
 (doseq [[name t] (:types registry) :when (= "class" (:kind t))]
  (loop [entry [name t] seen #{}]
   (when (contains? seen (type-identity entry)) (fail! :mithril.native-declarations/type "Cyclic class inheritance"))
   (let [t (second entry) base (:base t) r (definition-view registry t)]
    (when (and (= "class" (:kind t)) base)
     (when-let [next (resolve-entry r :types (:scope t) (get base "name"))]
      (recur next (conj seen (type-identity entry)))))))))
(defn- interface-inheritance! [registry]
 (let [heights (atom {})]
  (letfn [(visit [entry path depth]
           (when (> depth 64) (fail! :mithril.native-declarations/budget "Heritage depth budget"))
           (let [id (type-identity entry)]
            (when (contains? path id) (fail! :mithril.native-declarations/type "Cyclic interface/class heritage"))
            (let [height (if (contains? @heights id) (get @heights id)
                          (let [t (second entry)
                                children (keep (fn [{:keys [node context]}]
                                                (resolve-entry (block-view registry context) :types (:scope t) (get node "name"))) (:heritage t))
                                height (if (seq children) (inc (apply max (map #(visit % (conj path id) (inc depth)) children))) 0)]
                           (swap! heights assoc id height) height))]
             (when (> (+ depth height) 64) (fail! :mithril.native-declarations/budget "Heritage depth budget")) height)))]
   (doseq [[name t] (:types registry) :when (seq (:heritage t))] (visit [name t] #{} 0)))))
(defn- check-declarations! [decls env values budget registry scope depth]
 (doseq [[index d] (map-indexed vector decls)]
  (charge! budget depth)
  (let [kind (get d "kind")]
   (case kind
    "function" (signature! d env values :normal depth budget registry scope false)
    "const" (check-type! (get d "datatype") env values :unique (inc depth) budget registry scope nil)
    "alias" (let [e (generic-env! (get d "type-params") env values :normal depth budget registry scope)] (check-type! (get d "datatype") e values :normal (inc depth) budget registry scope nil))
    "interface" (let [e (generic-env! (get d "type-params") env values :normal depth budget registry scope)]
                  (doseq [base (get d "extends")]
                   (when (or (not= "name" (get base "op")) (contains? e (get base "name")))
                    (fail! :mithril.native-declarations/type "Interface heritage requires declared named type"))
                   (check-type! base e values :normal (inc depth) budget registry scope nil))
                  (check-members! (get d "members") (with-meta e {:this? true}) values :normal depth budget registry scope))
    "class" (check-class! d env values depth budget registry scope)
    "namespace" (let [r (block-overlay registry scope index)] (class-inheritance! r) (interface-inheritance! r)
                  (check-declarations! (get d "declarations") env values budget r (str scope (get d "name") ".") (inc depth)))
    "export-alias" (do (identifier! (get d "target")) (when-not (or (contains? (:values registry) (get d "target")) (contains? (:types registry) (get d "target"))) (fail! :mithril.native-declarations/export "Unknown alias target")))))))
(defn- namespace-value? [d]
 (some #(or (contains? #{"function" "const" "class"} (get % "kind")) (and (= "namespace" (get % "kind")) (namespace-value? %))) (get d "declarations")))
(defn check-document [doc runtime]
 (shape! doc ["@context" "@type" "name" "runtime-source" "ambient-types" "ambient-values" "declarations"])
 (when-not (and (= "NativeJsDeclarations" (get doc "@type")) (= "https://mithril.fund/context/native-js-declarations/v1" (get doc "@context"))) (fail! :mithril.native-declarations/context "Expected declaration context"))
 (qualified! (get doc "name")) (source! (get doc "runtime-source"))
 (when-not (and (contains? #{:mithril.native-package/checked-v1 :mithril.native-esm/checked-v1} (:format runtime)) (= (get doc "name") (:name runtime)))
  (fail! :mithril.native-declarations/runtime "Matching checked runtime package required"))
 (let [ambient (get doc "ambient-types") values (get doc "ambient-values") registry (atom {:types {} :values {} :namespaces {}})]
  (vector! ambient 64) (vector! values 64)
  (doseq [a ambient]
   (shape! a ["name" "min" "max"]) (type-identifier! (get a "name"))
   (when-not (and (integer? (get a "min")) (integer? (get a "max")) (<= 0 (get a "min") (get a "max") 32)) (fail! :mithril.native-declarations/arity "Invalid ambient type arity"))
   (add! registry :types (get a "name") {:min (get a "min") :max (get a "max")}))
  (doseq [v values] (qualified! v) (add! registry :values v "ambient"))
  (register! (get doc "declarations") "" registry 0)
  (doseq [d (get doc "declarations") :when (= "export-alias" (get d "kind"))]
   (let [target (get d "target") n (get d "name")]
    (when-let [t (get-in @registry [:types target])] (add! registry :types n t))
    (when-let [v (get-in @registry [:values target])] (add! registry :values n v))))
  (class-inheritance! @registry)
  (interface-inheritance! @registry)
  (check-declarations! (get doc "declarations") #{} #{} (atom 0) @registry "" 0)
  (let [decls (get doc "declarations")
        public? #(or (get % "exported") (= "export-alias" (get % "kind")))
        exports (vec (distinct (map #(get % "name") (filter #(and (public? %) (or (or (contains? #{"function" "const" "class"} (get % "kind")) (and (= "export-alias" (get % "kind")) (contains? (:values @registry) (get % "name")))) (and (= "namespace" (get % "kind")) (namespace-value? %)))) decls))))
        types (vec (distinct (map #(get % "name") (filter #(and (public? %) (or (contains? #{"alias" "interface" "class"} (get % "kind")) (and (= "export-alias" (get % "kind")) (contains? (:types @registry) (get % "name"))))) decls))))]
   (when-not (= (set exports) (set (map :name (:exports runtime)))) (fail! :mithril.native-declarations/surface "Public runtime declaration surface mismatch"))
   {:format :mithril.native-declarations/checked-v1 :name (get doc "name") :runtime-source (get doc "runtime-source")
    :declarations decls :exports exports :type-exports types})))
(defn check-text [text runtime] (check-document (parse-text text) runtime))
