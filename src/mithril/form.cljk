(ns mithril.form
  "Fail-closed Kotoba-shaped S-expression surface for Mithril.

  Forms are inert data. They lower to the same pinned JSON-LD document used by
  the compatibility reader; no form is evaluated and no host namespace is
  resolved."
  (:require [cljs.reader :as reader]
            [clojure.string :as str]))

(def media-type "application/vnd.mithril.form")

(def ^:private top-level-tags
  {'mithril/program "Program"
   'mithril/library "Library"
   'mithril/web-application "WebApplication"
   'mithril/synthesize-web-application "SynthesizeWebApplication"
   'mithril/synthesize-web-pipeline-application "SynthesizeWebPipelineApplication"
   'mithril/graph-agent "GraphAgentApplication"
   'mithril/app-agent "AppAgentApplication"
   'mithril/bot-profile "BotProfile"
   'mithril/bot-checkpoint "BotCheckpoint"
   'mithril/bot-checkpoint-semantic "BotCheckpoint"
   'mithril/growth-profile "GrowthProfile"
   'mithril/growth-decision "GrowthDecision"
   'mithril/jev-decision "JevDecision"
   'mithril/hermes-profile "HermesProfile"
   'mithril/hermes-bpmn-scheduler-contract "HermesBpmnSchedulerContract"
   'mithril/hermes-bpmn-coding-scheduler-contract "HermesBpmnCodingSchedulerContract"
   'mithril/edit-proposal "EditProposal"
   'mithril/repair-search "RepairSearch"
   'mithril/desktop-application "DesktopApplication"
   'mithril/ontology "Ontology"
   'mithril/twin-document "TwinDocument"
   'mithril/twin-service "TwinService"
   'mithril/component "Component"
   'mithril/assembly "Assembly"
   'mithril/stack "Stack"
   'mithril/twin-run "TwinRun"
   'mithril/cluster "Cluster"})

(def ^:private nested-tags
  #{'mithril/choice 'mithril/export 'mithril/import 'mithril/route
    'mithril/source 'mithril/loop 'mithril/app 'mithril/page
    'mithril/agent-loop 'mithril/bot-policy 'mithril/growth-policy
    'mithril/growth-action 'mithril/hermes-job 'mithril/repair-candidate
    'mithril/actor 'mithril/activity 'mithril/service 'mithril/resource 'rdf/node})

(def ^:private typed-node-tags
  {'owl/class "owl:Class"
   'owl/object-property "owl:ObjectProperty"
   'owl/datatype-property "owl:DatatypeProperty"
   'owl/restriction "owl:Restriction"
   'owl/all-disjoint-classes "owl:AllDisjointClasses"
   'owl/named-individual "owl:NamedIndividual"
   'shacl/node-shape "sh:NodeShape"
   'shacl/property-shape "sh:PropertyShape"
   'bpmn/process "bpmn:Process"
   'bpmn/start-event "bpmn:StartEvent"
   'bpmn/end-event "bpmn:EndEvent"
   'bpmn/exclusive-gateway "bpmn:ExclusiveGateway"
   'bpmn/service-task "bpmn:ServiceTask"
   'bpmn/sequence-flow "bpmn:SequenceFlow"})

