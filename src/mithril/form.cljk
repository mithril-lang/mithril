(ns mithril.form
  "Fail-closed Kotoba-shaped S-expression surface for Mithril (fenced data
  profile, mithril.form/v1).

  Forms are inert data. They lower to the same pinned JSON-LD document used by
  the compatibility reader; no form is evaluated and no host namespace is
  resolved.

  Named reader refusals (fail-closed, never silent; pinned by form_test):
   - ^-metadata                 :mithril.form/metadata
                                Metadata is :keyword value pairs inside the
                                tagged form; ^ attaches nothing at lower time.
   - wide / malformed integers  :mithril.form/i64-string,
                                :mithril.form/unsupported-numeric-literal
                                Integers are exactly representable JS numbers
                                in [-2^53, 2^53]; wider i64 spells decimal
                                strings (module i64! precedent).
   - #?/#?@ in the native       :mithril.form/reader-cond
     profile                    Admitted only under the (mithril/form:v1)
                                version marker with an explicit feature set;
                                resolved at read time, never by backends.
   - .cljc idioms the native    :mithril.form/unsupported-dispatch
     (kotoba) profile refuses   Reader evaluation (#=), discard (#_),
                                fn/var/regex shorthand (#(, #', #\", #js),
                                quote/syntax-quote/unquote (#', `, ~, ~@)
                                and deref (@). Ambient Clojure heads
                                (defmacro, require/use/import/load/eval) fail
                                unknown-tag like any unlisted tag: there is
                                no macro system, no host require, no eval.

  The data profile admits only .mith (this surface) and JSON-LD; it is never
  .cljc/.cljk/.clj/.cljs source and never pretends to be (Amu native admits
  only .kotoba; those extensions are :retired-source there)."
  (:require [cljs.reader :as reader]
            [clojure.string :as str]))

(def media-type "application/vnd.mithril.form")

(def language-version "mithril.form/v1")
;; v1 is Mithril form 1.0: additive-only within v1; a new top-level tag,
;; a new field on a tag, or a new type constructor is a major change (v2).

(def legacy-language-version "mithril.form/v0")
;; Absence of the version marker: every shipped corpus file, unchanged digest.

(def kotoba-profile-version 6)
;; guest-grammar profile-version this surface lowers to (lowering contract:
;; docs/lowering-contract.md).

(def version-marker "(mithril/form:v1)")

(def ^:private feature-vocabulary #{:mithril :js :rust :py :kotoba :default})
;; Closed reader-conditional features. A test is a keyword or a sequence of
;; keywords (any-match); :default always matches. First match wins.

(def ^:private safe-int-limit "9007199254740992")
;; 2^53: every integer in [-2^53, 2^53] is exactly representable as the JS
;; number cljs.reader produces; anything wider rounds and is refused by name.

(def ^:private safe-int-limit-hex "20000000000000")
;; Same bound for 0x integers (2^53 in hex).


