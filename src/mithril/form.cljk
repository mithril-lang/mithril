(defn- fail! [code detail]
  (throw (ex-info detail {:mithril/error code :detail detail})))

(defn source? [text]
  (boolean (re-find #"^(?:\s|;[^\n]*(?:\n|$))*\(" (or text ""))))

(defn- key-name [k]
  (when-not (keyword? k)
    (fail! :mithril.form/non-keyword-field "Mithril form fields must be keywords"))
  (or (get key-names k)
      (when-not (namespace k) (name k))
      (fail! :mithril.form/unknown-field (str "unknown namespaced field: " k))))

(declare lower-form)

(defn- lower-value [value]
  (cond
    (list? value) (lower-form value)
    (vector? value) (mapv lower-value value)
    (or (string? value) (integer? value) (boolean? value) (nil? value)) value
    :else (fail! :mithril.form/unsupported-value
                 (str "unsupported Mithril form value: " (pr-str value)))))

;; IRI-coerced terms whose values may also be integer or boolean literals
;; (sh:targetNode 7, sh:in [1 2], sh:hasValue true) are lowered as plain
;; native values: org-w3-json-ld-api ef6a81a coerces only STRINGS under
;; "@type" "@id" (JSON-LD 1.1 §5.3.2), so 7 expands to the literal it is.
;; (Earlier pins made it a relative IRI and the Form wrapped such values in
;; explicit value objects; the RDF -- and so every graph digest -- is the
;; same either way at this pin, checked by form_test.)

(defn- fields
  ([xs] (fields xs false))
  ([xs js-value-literal?]
   (when (odd? (count xs))
     (fail! :mithril.form/field-arity "Mithril forms require keyword/value pairs"))
   (let [pairs (partition 2 xs)
         names (map (comp key-name first) pairs)]
     (when-not (= (count names) (count (set names)))
       (fail! :mithril.form/duplicate-field "Mithril form fields must be unique"))
     (into {} (map (fn [[k v]]
                     (let [name (key-name k)]
                       [name (if (and js-value-literal? (= name "value") (number? v))
                               (if (js/Number.isFinite v) v
                                   (fail! :mithril.form/unsupported-value "Native JS numeric literals must be finite"))
                               (lower-value v))])) pairs)))))

(def ^:private path-tags
  "SHACL property path sub-syntax (SHACL §2.3.1). Positional, not keyword
  pairs: each argument is an IRI string or another path form."
  {'path/sequence nil
   'path/alternative "shAlternativePath"
   'path/inverse "shInversePath"
   'path/zero-or-more "shZeroOrMorePath"
   'path/one-or-more "shOneOrMorePath"
   'path/zero-or-one "shZeroOrOnePath"})

(def ^:private not-owl2-rl-types
  "OWL terms Mithril refuses to express: its ontologies declare the OWL 2 RL
  profile, and these are outside it."
  #{"owl:ReflexiveProperty" "http://www.w3.org/2002/07/owl#ReflexiveProperty"})

(defn- lower-path [p]
  (cond
    (string? p) {"@id" p}
    (and (list? p) (contains? path-tags (first p))) (lower-form p)
    :else (fail! :mithril.form/invalid-path
                 (str "a path is an IRI string or a path/... form: " (pr-str p)))))

(defn- lower-path-form [[tag & args]]
  (let [n (count args)]
    (if (contains? #{'path/sequence 'path/alternative} tag)
      (when (< n 2)
        (fail! :mithril.form/path-arity (str tag " takes at least two paths")))
      (when-not (= 1 n)
        (fail! :mithril.form/path-arity (str tag " takes exactly one path"))))
    (cond
      (= 'path/sequence tag) {"@list" (mapv lower-path args)}
      (= 'path/alternative tag) {"shAlternativePath" (mapv lower-path args)}
      :else {(get path-tags tag) (lower-path (first args))})))

(defn- lower-literal
  "(rdf/literal \"lexical\" [:datatype \"xsd:date\" | :language \"en\"]) -> a
  JSON-LD value object: for typed or language-tagged literals, which bare
  Form values (strings, integers, booleans) cannot state."
  [[_ lexical & opts]]
  (when-not (string? lexical)
    (fail! :mithril.form/invalid-literal "rdf/literal takes a lexical string first"))
  (when (odd? (count opts))
    (fail! :mithril.form/field-arity "rdf/literal options are keyword/value pairs"))
  (let [{:keys [datatype language] :as o} (apply hash-map opts)]
    (when-not (every? #{:datatype :language} (keys o))
      (fail! :mithril.form/unknown-field "rdf/literal accepts only :datatype or :language"))
    (when (and datatype language)
      (fail! :mithril.form/invalid-literal "a literal has a datatype or a language, not both"))
    (when-not (every? #(or (nil? %) (string? %)) [datatype language])
      (fail! :mithril.form/invalid-literal "rdf/literal :datatype / :language are strings"))
    (cond-> {"@value" lexical}
      datatype (assoc "@type" datatype)
      language (assoc "@language" language))))

(defn- merge-type
  "A typed tag's own type first, then any :rdf/type the body adds."
  [tag-type body-type]
  (let [extra (cond (nil? body-type) [] (vector? body-type) body-type :else [body-type])
        types (vec (distinct (cons tag-type extra)))]
    (if (= 1 (count types)) (first types) types)))

(declare lower-tagged)

(defn- rdf-id! [value blank?]
  (when-not (and (string? value)
                (not (re-find #"[\s<>\u0000-\u001f]" value))
                (or (and blank? (re-matches #"_:[A-Za-z0-9_.-]+" value))
                    (re-find #"^[A-Za-z][A-Za-z0-9+.-]*:" value)))
    (fail! :mithril.form/invalid-rdf-iri "RDF data requires an absolute IRI or admitted blank node"))
  value)

(defn- lower-rdf-data [[tag & args]]
  (let [children! (fn [children expected]
                    (when-not (every? #(and (list? %) (= expected (first %))) children)
                      (fail! :mithril.form/invalid-rdf-data (str tag " requires " expected " children")))
                    (mapv lower-form children))]
    (case tag
      rdf/dataset (vec (mapcat (fn [g] (if (get g "@id") [g] (get g "@graph")))
                              (children! args 'rdf/graph)))
      rdf/graph (let [[identity & nodes] args]
                  (when (empty? args) (fail! :mithril.form/invalid-rdf-data "rdf/graph needs a graph identity or nil"))
                  (cond-> {"@graph" (children! nodes 'rdf/description)}
                    identity (assoc "@id" (rdf-id! identity true))))
      rdf/description
      (let [[identity & properties] args
            _ (rdf-id! identity true)
            _ (children! properties 'rdf/property)]
        (reduce (fn [node [_ predicate & values]]
                  (let [predicate (rdf-id! predicate false)]
                    (when (contains? node predicate)
                      (fail! :mithril.form/invalid-rdf-data "duplicate RDF property"))
                    (assoc node predicate (mapv lower-form values)))) {"@id" identity} properties))
      rdf/property
      (let [[predicate & values] args]
        (rdf-id! predicate false)
        (when-not (and (seq values) (every? #(and (list? %) (contains? #{'rdf/iri 'rdf/literal} (first %))) values))
          (fail! :mithril.form/invalid-rdf-data "rdf/property needs explicit RDF terms"))
        (mapv lower-form values))
      rdf/iri (do (when-not (= 1 (count args))
                    (fail! :mithril.form/invalid-rdf-data "rdf/iri takes exactly one identity"))
                  {"@id" (rdf-id! (first args) true)}))))

(defn lower-form [form]
  (when-not (and (list? form) (symbol? (first form)))
    (fail! :mithril.form/invalid-form "Mithril source must be one tagged S-expression"))
  (cond
    (contains? #{'rdf/dataset 'rdf/graph 'rdf/description 'rdf/property 'rdf/iri} (first form))
    (lower-rdf-data form)
    (contains? path-tags (first form)) (lower-path-form form)
    (= 'rdf/literal (first form)) (lower-literal form)
    :else (lower-tagged form)))

(defn- lower-tagged [form]
  (let [tag (first form)
        ;; Only this typed literal's scalar value admits native finite doubles.
        ;; General fields, guest numeric datatypes and RDF/policy forms stay inert
        ;; and integer-only; the native backend still checks context/type/shape.
        body (fields (rest form) (and (= tag 'mithril/literal)
                                     (some #(= [:datatype "js-value"] (vec %)) (partition 2 (rest form)))))
        types (let [t (get body "@type")] (if (vector? t) t [t]))]
    (when-let [bad (some not-owl2-rl-types types)]
      (fail! :mithril.form/not-owl2-rl
             (str bad " is outside the OWL 2 RL profile Mithril ontologies declare")))
    (cond
      (contains? top-level-tags tag)
      (assoc body "@context" (cond
                                (= tag 'mithril/growth-decision)
                                "https://mithril.fund/context/growth-decision/v1"
                                (= tag 'mithril/jev-decision)
                                "https://mithril.fund/context/jev-decision/v2"
                                (= tag 'mithril/bot-checkpoint-semantic)
                                "https://mithril.fund/context/bot-checkpoint/v1"
                                (= tag 'mithril/twin-document)
                                "https://mithril.fund/context/twin/v1"
                                (= tag 'mithril/module)
                                "https://mithril.fund/context/module/v1"
                                (= tag 'mithril/native-js-module)
                                "https://mithril.fund/context/native-js-module/v1"
                                (= tag 'mithril/native-js-package)
                                "https://mithril.fund/context/native-js-package/v1"
                                (= tag 'mithril/native-js-esm-package)
                                "https://mithril.fund/context/native-js-esm-package/v1"
                                (= tag 'mithril/native-js-esm-entry-package)
                                "https://mithril.fund/context/native-js-esm-package/v2"
                                (= tag 'mithril/native-js-declarations)
                                "https://mithril.fund/context/native-js-declarations/v1"
                                (= tag 'mithril/native-js-declaration-module)
                                "https://mithril.fund/context/native-js-declaration-module/v1"
                                (= tag 'mithril/native-js-declaration-program)
                                "https://mithril.fund/context/native-js-declaration-program/v1"
                                (= tag 'mithril/native-js-declaration-composition)
                                "https://mithril.fund/context/native-js-declaration-composition/v1"
                                :else "https://mithril.fund/context/v1")
                  "@type" (get top-level-tags tag))

      (= 'mithril/task tag)
      (cond-> (-> body (dissoc "@id") (assoc "id" (get body "@id")))
        (contains? body "toolProfileDigest")
        (dissoc "toolProfileDigest")
        (contains? body "toolProfileDigest")
        (assoc "tool-profile-digest" (get body "toolProfileDigest")))

      (contains? nested-tags tag) body

      (contains? typed-node-tags tag)
      (assoc body "@type" (merge-type (get typed-node-tags tag) (get body "@type")))

      :else (fail! :mithril.form/unknown-tag (str "unknown Mithril form tag: " tag)))))

(defn- trivia-char? [ch]
  (or (= ch " ") (= ch "\t") (= ch "\n") (= ch "\r") (= ch ",")))

(defn- skip-trivia [text from]
  (let [n (count text)]
    (loop [i from]
      (if (>= i n) i
        (let [ch (.charAt text i)]
          (cond
            (= ch ";") (let [nl (.indexOf text "\n" i)]
                         (recur (if (neg? nl) n (inc nl))))
            (trivia-char? ch) (recur (inc i))
            :else i))))))

(defn- string-end
  "Index just past the closing quote at from, or nil when unterminated."
  [text from]
  (let [n (count text)]
    (loop [j (inc from)]
      (cond (>= j n) nil
            (= (.charAt text j) "\\") (recur (+ j 2))
            (= (.charAt text j) "\"") (inc j)
            :else (recur (inc j))))))

(defn- balanced-end
  "Index just past the closer matching the opener at from, or nil. Strings and
  comments inside are skipped, not interpreted."
  [text from]
  (let [n (count text)]
    (loop [j (inc from) depth 1]
      (if (>= j n) nil
        (let [ch (.charAt text j)]
          (cond
            (= ch "\"") (if-let [e (string-end text j)]
                          (recur e depth) nil)
            (= ch ";") (let [nl (.indexOf text "\n" j)]
                         (recur (if (neg? nl) n (inc nl)) depth))
            (or (= ch "(") (= ch "[") (= ch "{")) (recur (inc j) (inc depth))
            (or (= ch ")") (= ch "]") (= ch "}"))
            (let [d (dec depth)] (if (zero? d) (inc j) (recur (inc j) d)))
            :else (recur (inc j) depth)))))))

(defn- token-end [text from limit]
  (let [n (min limit (count text))]
    (loop [j from]
      (if (>= j n) j
        (let [ch (.charAt text j)]
          (if (or (trivia-char? ch)
                  (= ch "(") (= ch ")") (= ch "[") (= ch "]")
                  (= ch "{") (= ch "}") (= ch "\"") (= ch ";"))
            j (recur (inc j))))))))

(defn- split-top-forms
  "Source substrings of the top-level forms in text[from, limit). A #?/#?@
  conditional is one element, however deeply its clause list nests."
  [text from limit]
  (loop [i from acc []]
    (let [i (skip-trivia text i)]
      (if (>= i limit) acc
        (let [ch (.charAt text i)]
          (cond
            (and (= ch "#") (< (inc i) limit) (= "?" (.charAt text (inc i))))
            (let [splicing? (= "@" (.charAt text (+ i 2)))
                  open (skip-trivia text (+ i (if splicing? 3 2)))
                  e (balanced-end text open)]
              (when-not (and e (<= e limit))
                (fail! :mithril.feature/bad-clause "unbalanced conditional clause"))
              (recur e (conj acc (subs text i e))))
            (or (= ch "(") (= ch "[") (= ch "{"))
            (let [e (balanced-end text i)]
              (when-not (and e (<= e limit))
                (fail! :mithril.feature/bad-clause "unbalanced conditional clause"))
              (recur e (conj acc (subs text i e))))
            (= ch "\"")
            (let [e (string-end text i)]
              (when-not e (fail! :mithril.form/read-error "unterminated string"))
              (recur e (conj acc (subs text i e))))
            :else (let [e (token-end text i limit)]
                    (recur e (conj acc (subs text i e))))))))))

(defn- take-version-marker
  "Strip an optional leading (mithril/form:vN) marker. Returns [version rest].
  The marker is trivia: it never reaches the lowered document or the digest."
  [text]
  (let [n (count text)
        i (skip-trivia text 0)]
    (if (and (> n (+ i 14)) (= "(mithril/form:" (subs text i (+ i 14))))
      (let [close (.indexOf text ")" i)
            tag (when (pos? close) (subs text (inc i) close))]
        (if (= "mithril/form:v1" tag)
          [language-version (subs text (inc close))]
          (fail! :mithril.form/unknown-version
                 (str "unknown Mithril form version: " tag))))
      [legacy-language-version text])))

(def ^:private skipped-text-source
  "\"(?:[^\"\\\\]|\\\\[\\s\\S])*\"?|;[^\\n]*")
;; One string literal (to its closing quote, or to the end when unterminated)
;; or one comment (to the end of its line). Every surface scan skips these
;; with one native regex pass instead of a per-character loop.

(defn- find-conditional
  "Index of the first #? outside strings/comments, or nil."
  [text]
  (when-not (neg? (.indexOf text "#?"))
    (let [re (js/RegExp. (str skipped-text-source "|#\\?") "g")]
      (loop []
        (when-let [m (.exec re text)]
          (if (= "#?" (aget m 0)) (.-index m) (recur)))))))

(defn- feature-keywords
  "Keyword vector for one feature-test source; fails on closed-vocab violations."
  [src]
  (let [parsed (try (reader/read-string src)
                    (catch :default e
                      (fail! :mithril.feature/bad-clause
                             (str "malformed feature test: " src))))
        keywords (cond (keyword? parsed) [parsed]
                       (sequential? parsed) (vec parsed)
                       :else nil)]
    (when-not (and keywords (seq keywords) (every? keyword? keywords))
      (fail! :mithril.feature/bad-clause (str "malformed feature test: " src)))
    (doseq [k keywords]
      (when-not (contains? feature-vocabulary k)
        (fail! :mithril.feature/unknown-feature (str "unknown feature test: " k))))
    keywords))

(defn- conditional-replacement
  "Resolve the #? or #?@ conditional at hash-i to source text, or refuse.
  Clause list is (test form)*, first matching clause wins, :default matches.
  Returns [replacement close-end]."
  [text hash-i version features]
  (when-not (= version language-version)
    (fail! :mithril.form/reader-cond
           "reader conditionals (#?) require the (mithril/form:v1) version marker; the native profile refuses them"))
  (when (empty? features)
    (fail! :mithril.form/reader-cond
           "reader conditionals (#?) require an explicit feature set, e.g. {:features #{:js}}; the native profile refuses them"))
  (let [splicing? (= "@" (.charAt text (+ hash-i 2)))
        open (skip-trivia text (+ hash-i (if splicing? 3 2)))]
    (when-not (and (< open (count text)) (= "(" (.charAt text open)))
      (fail! :mithril.feature/bad-clause "reader conditional must be followed by a clause list"))
    (let [close-end (balanced-end text open)]
      (when-not close-end
        (fail! :mithril.feature/bad-clause "unbalanced reader conditional"))
      (let [elements (split-top-forms text (inc open) (dec close-end))]
        (when-not (and (seq elements) (even? (count elements)))
          (fail! :mithril.feature/bad-clause
                 "reader conditional requires feature/expression pairs"))
        (let [pairs (partition 2 elements)
              tests (mapv #(feature-keywords (first %)) pairs)
              match-idx (first (filter (fn [i]
                                         (let [ks (nth tests i)]
                                           (or (some #(= :default %) ks)
                                               (some features ks))))
                                       (range (count pairs))))]
          (when-not match-idx
            (fail! :mithril.feature/no-match
                   "no reader-conditional clause matches the selected feature set"))
          (let [form-src (second (nth pairs match-idx))]
            [(if splicing?
               (let [fs (skip-trivia form-src 0)]
                 (when-not (and (< fs (count form-src))
                               (contains? #{"[" "("} (.charAt form-src fs)))
                   (fail! :mithril.feature/splice-arity
                          "#?@ selected form must be a vector or list whose elements splice"))
                 (subs form-src (inc fs) (dec (count form-src))))
               form-src)
             close-end]))))))

(defn- expand-conditionals
  "Expand every #?/#?@ in text against features. Returns [text expanded?]."
  [text version features]
  (loop [src text expanded? false]
    (let [pos (find-conditional src)]
      (if-not pos [src expanded?]
        (let [[replacement close-end] (conditional-replacement src pos version features)]
          (recur (str (subs src 0 pos) replacement (subs src close-end))
                 true))))))

(defn- over-limit?
  "True when the magnitude digit string is strictly greater than limit."
  [digits limit]
  (or (> (count digits) (count limit))
      (and (= (count digits) (count limit))
           (pos? (compare digits limit)))))

(defn- check-numeric-token [token]
  (cond
    (re-matches #"^[+-]?0[xX][0-9a-fA-F]+$" token)
    (let [digits (str/upper-case (subs token (if (contains? #{"+" "-"} (subs token 0 1)) 3 2)))
          digits (loop [d digits]
                   (if (and (> (count d) 1) (= "0" (subs d 0 1))) (recur (subs d 1)) d))]
      (when (over-limit? digits safe-int-limit-hex)
        (fail! :mithril.form/i64-string
               (str "integer literal " token " is outside the safe range [-2^53, 2^53]; write i64 values as canonical decimal strings"))))
    (re-matches #"^[+-]?0[0-9]+$" token)
    (fail! :mithril.form/unsupported-numeric-literal
           "a leading zero is not an octal prefix in Mithril form")
    (re-matches #"^[0-9]+[rR][0-9A-Za-z]+$" token)
    (fail! :mithril.form/unsupported-numeric-literal
           (str "unsupported numeric literal: " token))
    (re-matches #"^[0-9]+N$" token)
    (fail! :mithril.form/unsupported-numeric-literal
           (str "unsupported numeric literal: " token))
    (re-matches #"^[+-]?[0-9]+$" token)
    (let [digits (cond-> token
                   (contains? #{"+" "-"} (subs token 0 1)) (subs 1))]
      (when (over-limit? digits safe-int-limit)
        (fail! :mithril.form/i64-string
               (str "integer literal " token " is outside the safe range [-2^53, 2^53]; write i64 values as canonical decimal strings"))))
    :else nil))

(def dispatch-idioms
  {"=" "reader evaluation (#=)"
   "_" "discard (#_)"
   "(" "fn shorthand (#()"
   "'" "var-quote (#')"
   "\"" "regex literal (#\"…\")"
   "j" "host literal (#js)"})

(def ^:private surface-suspect-source
  (str "(?:^|(?<=[ \\t\\n\\r,(\\[{]))"
       "(?:[\\^#'`~@]|[+-]?(?:0[0-9xX]|[0-9]+[rRN]|[0-9]{16}))"))
;; A token start (start of text, or after trivia or an opener, exactly as
;; trivia-char? and the readers see it) carrying a refused reader idiom or a
;; numeric literal that check-numeric-token may refuse: leading zero, hex,
;; radix, N suffix, or at least 16 digits (2^53 has 16; 15 digits are safe).

(defn- check-surface
  "Refuse ^, reader idioms, and wide/malformed integers outside strings and
  comments. Floats pass through: general fields already refuse them via
  unsupported-value, while a js-value literal keeps native doubles.
  Strings and comments are first masked to their opening character (so the
  token-start context of what follows them is unchanged), then one regex
  finds the few suspect token starts; ordinary source costs two native
  regex passes, not a per-character interpreted loop."
  [text]
  (let [masked (.replace text (js/RegExp. (str "(?=([\";]))(?:" skipped-text-source ")") "g")
                         "$1")
        re (js/RegExp. surface-suspect-source "g")]
    (loop []
      (when-let [m (.exec re masked)]
        (let [i (.-index m)
              ch (.charAt masked i)]
          (case ch
            "^" (fail! :mithril.form/metadata
                       "^-metadata is refused in the fenced data profile; the metadata spelling is :keyword value pairs inside the tagged form")
            "#" (let [nxt (.charAt masked (inc i))]
                  (fail! :mithril.form/unsupported-dispatch
                         (str "reader idiom " (or (get dispatch-idioms nxt) (str "#" nxt))
                              " is refused in the fenced data profile: no macros, no reader evaluation, no ambient reading")))
            "'" (fail! :mithril.form/unsupported-dispatch
                       "quote (') is refused in the fenced data profile")
            "`" (fail! :mithril.form/unsupported-dispatch
                       "syntax-quote (`) is refused in the fenced data profile")
            "~" (fail! :mithril.form/unsupported-dispatch
                       "unquote (~) is refused in the fenced data profile")
            "@" (fail! :mithril.form/unsupported-dispatch
                       "deref (@) is refused in the fenced data profile")
            (let [e (token-end masked i (count masked))]
              (check-numeric-token (subs masked i e))
              (set! (.-lastIndex re) e)
              (recur))))))))

(defn parse-with-meta
  "Read exactly one inert Mithril form and lower it to the JSON-LD document
  model. Wrapping in a vector makes trailing second forms observable.
  Returns {:document doc :version language-version :kotoba-profile 6
  :features #{...}}. The document never carries the version marker: dead
  digests stay dead. opts {:features #{:js ...}} is the opt-in that admits
  reader conditionals (with the (mithril/form:v1) marker); default is the
  native profile, which refuses them."
  ([text] (parse-with-meta text {}))
  ([text opts]
   (try
     (let [[version rest] (take-version-marker text)
           features (set (or (:features opts) []))
           [expanded expanded?] (expand-conditionals rest version features)
           _ (check-surface expanded)
           forms (reader/read-string (str "[" expanded "\n]"))]
       (cond
         (and expanded? (zero? (count forms)))
         (fail! :mithril.feature/empty-document "reader conditional resolved to zero top-level forms")
         (and expanded? (> (count forms) 1))
         (fail! :mithril.feature/multi-document "reader conditional resolved to more than one top-level form")
         (not= 1 (count forms))
         (fail! :mithril.form/form-count "Mithril source must contain exactly one form")
         :else {:document (lower-form (first forms))
                :version version
                :kotoba-profile kotoba-profile-version
                :features features}))
     (catch :default error
       (if (:mithril/error (ex-data error))
         (throw error)
         (fail! :mithril.form/read-error (or (.-message error) "invalid Mithril form")))))))

(defn parse
  "Read exactly one inert Mithril form and lower it to the JSON-LD document
  model. Wrapping in a vector makes trailing second forms observable."
  ([text] (parse text {}))
  ([text opts] (:document (parse-with-meta text opts))))
