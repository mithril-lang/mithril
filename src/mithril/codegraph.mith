(mithril/codegraph
  :id "https://mithril.fund/id/codegraph/mithril"
  :ontology "c362b0f569c0e8251d6b9769513c49be82827cfb2a6725764337f7bf4211e5eb"
  :imports [(mithril/import :library "https://mithril.fund/lib/codegraph/v1" :digest "sha256:13d0cc69544097c8d3d9221cf50c30b94618cf71d24a191af915e991086b2827")]
  :parser-profile "mithril.codegraph/extractor-v3-cljs-scopes"
  :extensions ["clj" "cljs" "cljc" "cljk" "mith" "mithril" "jsonld" "md" "markdown" "txt"]
  :pipeline ["extract" "resolve" "detect-communities" "project"]
  :queries ["search" "node" "callers" "callees" "impact" "path" "explore" "status" "rdf" "communities" "community" "catalog" "content" "neighbors"]
