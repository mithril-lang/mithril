    "HermesBpmnCodingSchedulerContract" "mith:HermesBpmnCodingSchedulerContract"
    "DesktopApplication" "mith:DesktopApplication"
    "Ontology" "owl:Ontology"
    "profile" {"@id" "mith:profile" "@type" "@id" "@container" "@set"}
    "subClassOf" {"@id" "rdfs:subClassOf" "@type" "@id"}
    "subPropertyOf" {"@id" "rdfs:subPropertyOf" "@type" "@id"}
    "domain" {"@id" "rdfs:domain" "@type" "@id"}
    "range" {"@id" "rdfs:range" "@type" "@id"}
    "equivalentClass" {"@id" "owl:equivalentClass" "@type" "@id"}
    "inverseOf" {"@id" "owl:inverseOf" "@type" "@id"}
    "targetClass" {"@id" "sh:targetClass" "@type" "@id"}
    "property" {"@id" "sh:property" "@container" "@set"}
    "propertyPath" {"@id" "sh:path" "@type" "@id"}
    "minCount" {"@id" "sh:minCount" "@type" "xsd:integer"}
    "maxCount" {"@id" "sh:maxCount" "@type" "xsd:integer"}
    "valueClass" {"@id" "sh:class" "@type" "@id"}
    "datatype" {"@id" "sh:datatype" "@type" "@id"}
    ;; SHACL Core beyond the terms above, and OWL 2 vocabulary. Every new term
    ;; is prefixed (sh... / owl...) so no bare key an existing document uses
    ;; changes meaning: a document without these terms expands to the same
    ;; RDF, so its graph digest is unchanged (test/fixtures/digest-baseline.edn).
    ;; IRI-valued terms coerce strings to IRIs ("@type" "@id"); literal-valued
    ;; ones take strings / integers / booleans / (rdf/literal ...) as literals;
    ;; "@list" terms turn a vector into an RDF list (rdf:first / rdf:rest).
    "shTargetNode" {"@id" "sh:targetNode" "@type" "@id"}
    "shTargetSubjectsOf" {"@id" "sh:targetSubjectsOf" "@type" "@id"}
    "shTargetObjectsOf" {"@id" "sh:targetObjectsOf" "@type" "@id"}
    "shDeactivated" {"@id" "sh:deactivated"}
    "shSeverity" {"@id" "sh:severity" "@type" "@id"}
    "shMessage" {"@id" "sh:message"}
    "shName" {"@id" "sh:name"}
    "shDescription" {"@id" "sh:description"}
    "shAlternativePath" {"@id" "sh:alternativePath" "@type" "@id" "@container" "@list"}
    "shInversePath" {"@id" "sh:inversePath" "@type" "@id"}
    "shZeroOrMorePath" {"@id" "sh:zeroOrMorePath" "@type" "@id"}
    "shOneOrMorePath" {"@id" "sh:oneOrMorePath" "@type" "@id"}
    "shZeroOrOnePath" {"@id" "sh:zeroOrOnePath" "@type" "@id"}
    "shNodeKind" {"@id" "sh:nodeKind" "@type" "@id"}
    "shMinExclusive" {"@id" "sh:minExclusive"}
    "shMinInclusive" {"@id" "sh:minInclusive"}
    "shMaxExclusive" {"@id" "sh:maxExclusive"}
    "shMaxInclusive" {"@id" "sh:maxInclusive"}
