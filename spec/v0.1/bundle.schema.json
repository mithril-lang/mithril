{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mithril-lang.github.io/mithril/dataset/spec/v0.1/bundle.schema.json",
  "title": "Mithril Dataset reference-v1 bundle",
  "type": "object",
  "properties": {
    "format": {
      "const": "mithril.computable-segments/reference-v1"
    },
    "tupleDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "canonicalGraphDigest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "emptyGraphs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "array",
            "prefixItems": [
              {
                "const": "I"
              },
              {
                "type": "string"
              }
            ],
            "items": false,
            "minItems": 2
          },
          {
            "type": "array",
            "prefixItems": [
              {
                "const": "B"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ],
            "items": false,
            "minItems": 2
          },
          {
            "type": "array",
            "prefixItems": [
              {
                "const": "L"
              },
              {
                "type": "string"
              },
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "items": false,
            "minItems": 4
          }
        ]
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "literal",
              "model"
            ]
          },
          "codec": {
            "enum": [
              "gzip",
              "zstd"
            ]
          },
          "rawBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "min": {
            "type": "string"
          },
          "max": {
            "type": "string"
          },
          "subjectRange": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "range"
                  },
                  "prefix": {
                    "type": "string"
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "kind",
                  "prefix",
                  "start",
                  "count"
                ],
                "additionalProperties": false
              }
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "string",
            "contentEncoding": "base64"
          }
        },
        "required": [
          "kind",
          "codec",
          "rawBytes",
          "count",
          "min",
          "max",
          "subjectRange",
          "digest",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "physicalDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "format",
    "tupleDigest",
    "canonicalGraphDigest",
    "emptyGraphs",
    "count",
    "segments",
    "physicalDigest"
  ],
  "additionalProperties": false
}
