(ns mithril.native-types-module-test
 (:require [cljs.test :refer [deftest is]] [mithril.native-js :as native] [mithril.module :as guest]
           ["node:fs" :as fs] ["node:os" :as os] ["node:path" :as path]
           ["node:child_process" :as child] ["node:crypto" :as crypto]))
(deftest whole-types-runtime-with-real-mithril-misc-and-volatile
 (let [text (fs/readFileSync "examples/native-js-types.mith" "utf8") artifact (native/compile-text text)
       dir (fs/mkdtempSync (path/join (os/tmpdir) "mithril-whole-types-"))
       file (path/join dir "types.mjs") misc (path/join dir "misc.mjs") volatile (path/join dir "volatile.mjs")]
  (try
   (is (= artifact (native/compile-text text)))
   (is (= :mithril.native-js/artifact-v1 (:format artifact)))
   (is (= "cosmokit.types" (:module artifact)))
   (is (= #{"globalThis" "Object" "ArrayBuffer" "Uint8Array" "Buffer" "String" "btoa" "atob" "parseInt" "Date" "RegExp" "Map" "Array" "Reflect" "Set" "isNullable" "isVolatile"} (set (:required-imports artifact))))
   (is (= #{"is" "Binary" "base64ToArrayBuffer" "arrayBufferToBase64" "hexToArrayBuffer" "arrayBufferToHex" "clone" "deepEqual"} (set (:exports artifact))))
   (is (try (guest/check-text text) false (catch :default _ true)))
   (is (= {"map-values" "5420bbe2a9932b27141280438674906d4d72c7941477690f37201a4eb1b72191"
           "misc" "b2e52089674875efa3b5a8c135e4fccd37b258c8d5d72adcfc05338f38c0a4fb"
           "array" "d2de5ed22d8b5afe5dea4c0125af71805573541a7156c55efc19b34672c26db8"
           "volatile" "a866812a56dfaba0fdcf682d478f3e4590e1d2b48820c273d51c22aaae6d1bd1"}
          (into {} (map (fn [n] [n (-> (crypto/createHash "sha256") (.update (:source (native/compile-text (fs/readFileSync (str "examples/native-js-" n ".mith") "utf8")))) (.digest "hex"))]) ["map-values" "misc" "array" "volatile"]))))
   (fs/writeFileSync file (:source artifact))
   (fs/writeFileSync misc (:source (native/compile-text (fs/readFileSync "examples/native-js-misc.mith" "utf8"))))
   (fs/writeFileSync volatile (:source (native/compile-text (fs/readFileSync "examples/native-js-volatile.mith" "utf8"))))
   (doseq [[mode files] [["baseline" ["test/fixtures/types-baseline.mjs" "test/fixtures/misc-baseline.mjs" "test/fixtures/volatile-baseline.mjs"]] ["candidate" [file misc volatile]]]]
    (let [args (clj->js (into ["--experimental-vm-modules" "test/fixtures/types-contract.mjs" mode] files))
          result (child/spawnSync js/process.execPath args #js {:encoding "utf8" :timeout 30000})]
     (is (= 0 (.-status result)) (str (.-stdout result) (.-stderr result)))))
   (finally (fs/rmSync dir #js {:recursive true :force true})))))
