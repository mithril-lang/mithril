(ns mithril.form-test
  (:require [cljs.test :refer [deftest is testing]]
            [mithril.app :as app]
            [mithril.form :as form]
            [mithril.compiler :as compiler]))

(deftest module-form-admits-inert-typed-nodes
  (let [doc (form/parse "(mithril/module :name \"example\" :exports [\"main\"] :functions [(mithril/function :name \"main\" :returns \"i64\" :body (mithril/call :name \"add\" :args [(mithril/local :name \"x\") (mithril/literal :value 1 :datatype \"i64\")]))])")
        f (first (get doc "functions"))
        call (get f "body")]
    (is (= "Module" (get doc "@type")))
    (is (= "https://mithril.fund/context/module/v1" (get doc "@context")))
    (is (= "Function" (get f "@type")))
    (is (= "Call" (get call "@type")))
    (is (= ["Local" "Literal"] (mapv #(get % "@type") (get call "args"))))
    (is (= 1 (get (second (get call "args")) "value")))))

(deftest module-form-preserves-contexts-and-refusals
  (doseq [[tag context] [["program" "v1"] ["growth-decision" "growth-decision/v1"]
                         ["jev-decision" "jev-decision/v2"] ["bot-checkpoint-semantic" "bot-checkpoint/v1"]
                         ["twin-document" "twin/v1"]]]
    (is (= (str "https://mithril.fund/context/" context)
           (get (form/parse (str "(mithril/" tag ")")) "@context"))))
  (doseq [[text expected] [["(mithril/module :host/eval \"x\")" :mithril.form/unknown-field]
                          ["(mithril/module :body (js/eval :source \"x\"))" :mithril.form/unknown-tag]
                          ["(mithril/module :name \"a\" :name \"b\")" :mithril.form/duplicate-field]
                          ["(mithril/module) (mithril/module)" :mithril.form/form-count]
                          ["(mithril/module :body alert)" :mithril.form/unsupported-value]]]
    (is (= expected (try (form/parse text) nil
                     (catch :default e (:mithril/error (ex-data e))))))))

(defn read-text [path] (.readFileSync (js/require "fs") path "utf8"))
(defn error-code [f] (try (f) nil (catch :default e (:mithril/error (ex-data e)))))

(deftest kotoba-form-and-jsonld-have-one-semantic-identity
  (let [library (compiler/compile-library-text
                  "lib/app/agent-loop-v1.mith"
                  (read-text "lib/app/agent-loop-v1.mith"))
        json-artifact (app/compile-text
                        "examples/mithril-app-agent.mith"
                        (read-text "examples/mithril-app-agent.mith") [library])
        form-artifact (app/compile-text
                        "examples/mithril-app-agent-form.mith"
                        (read-text "examples/mithril-app-agent-form.mith") [library])]
    (is (= json-artifact form-artifact))
    (is (= "sha256:fea2302f51b8915e341197e59c76dcff15a8b80775545cbbb5684d428e693fb1"
           (:graph-digest form-artifact)))))

(deftest owl-rdf-shacl-form-compiles-to-jsonld-rdf-dataset
  (let [artifact (compiler/compile-ontology-text
                   "ontology/semantic-core-v1.mith"
                   (read-text "ontology/semantic-core-v1.mith"))]
    (is (= "https://mithril.fund/artifact/ontology-v1" (:format artifact)))
    (is (= "application/vnd.mithril.form" (:media-type artifact)))
    (is (= "application/ld+json" (:jsonld-media-type artifact)))
    (is (= 5 (count (get-in artifact [:rdf-dataset "@graph"]))))
    (is (re-matches #"sha256:[0-9a-f]{64}" (:graph-digest artifact)))))

(deftest bpmn-agent-ontology-is-a-compiled-rdf-owl-shacl-artifact
  (let [artifact (compiler/compile-ontology-text
                  "ontology/bpmn-agent-v1.mith"
                  (read-text "ontology/bpmn-agent-v1.mith"))]
    (is (= "https://mithril.fund/artifact/ontology-v1" (:format artifact)))
    (is (= "sha256:b3f864a5b1c627e628be9767f1a6936b55dea44c565a20e3e0c20049855e3e8b"
           (:graph-digest artifact)))
    (is (= 6 (count (get-in artifact [:rdf-dataset "@graph"]))))))

(deftest form-reader-is-inert-and-fail-closed
  (testing "a second form is observable"
    (is (= :mithril.form/form-count
           (error-code #(compiler/parse-source
                          "(mithril/program :id \"https://mithril.fund/id/a\")\n(mithril/program :id \"https://mithril.fund/id/b\")")))))
  (testing "unknown tags cannot call host code"
    (is (= :mithril.form/unknown-tag
           (error-code #(compiler/parse-source "(js/eval :source \"alert(1)\")")))))
  (testing "duplicate fields are rejected"
    (is (= :mithril.form/duplicate-field
           (error-code #(compiler/parse-source "(mithril/app :name \"a\" :name \"b\")"))))))

(deftest language-version-marker-and-provenance
  (testing "absent marker parses as mithril.form/v0"
    (is (= "mithril.form/v0"
           (:version (form/parse-with-meta "(mithril/module :name \"x\")"))))
    (is (= 6 (:kotoba-profile (form/parse-with-meta "(mithril/module :name \"x\")")))))
  (testing "present marker parses as mithril.form/v1 and is trivia"
    (let [bare (form/parse "(mithril/program :id \"https://mithril.fund/id/p\")")
          marked (form/parse-with-meta "(mithril/form:v1)\n(mithril/program :id \"https://mithril.fund/id/p\")")]
      (is (= "mithril.form/v1" (:version marked)))
      (is (= bare (:document marked)))
      (is (= (compiler/graph-digest bare)
             (compiler/graph-digest (:document marked)))
          "the marker never moves the graph digest")))
  (testing "unknown versions refuse, never best-guess"
    (is (= :mithril.form/unknown-version
           (error-code #(form/parse "(mithril/form:v2) (mithril/module)")))))
  (testing "marker does not license a second form"
    (is (= :mithril.form/form-count
           (error-code #(form/parse "(mithril/form:v1) (mithril/module) (mithril/module)")))))
  (testing "marker with trivia around it still counts"
    (is (= "mithril.form/v1"
           (:version (form/parse-with-meta "; lead-in\n(mithril/form:v1) ; marker\n(mithril/module :name \"x\")"))))))

(deftest native-profile-reader-refusals
  ;; The native (default) profile refuses every ambient reader idiom by name.
  (doseq [[text expected] [["^:private (mithril/module :name \"x\")" :mithril.form/metadata]
                          ["(mithril/module :body ^x foo)" :mithril.form/metadata]
                          ["(mithril/module :body 'x)" :mithril.form/unsupported-dispatch]
                          ["(mithril/module :body `x)" :mithril.form/unsupported-dispatch]
                          ["(mithril/module :body ~x)" :mithril.form/unsupported-dispatch]
                          ["@x" :mithril.form/unsupported-dispatch]
                          ["(mithril/module :body #=x)" :mithril.form/unsupported-dispatch]
                          ["(mithril/module :body #(%1))" :mithril.form/unsupported-dispatch]
                          ["(mithril/module #_ :name :name \"x\")" :mithril.form/unsupported-dispatch]
                          ["(read-cond :js (mithril/module :name \"x\"))" :mithril.form/unknown-tag]
                          ["(mithril/form:v1) (mithril/module :name #? (:js \"j\" :default \"d\"))" :mithril.form/reader-cond]
                          ["(mithril/module :name #? (:js \"j\" :default \"d\"))" :mithril.form/reader-cond]]]
    (is (= expected (error-code #(form/parse text))) text))
  (testing "idiom text inside strings and comments is inert data"
    (is (= "a^b #? (~)"
           (get (form/parse "(mithril/module :name \"a^b #? (~)\")") "name")))
    (is (= "x" (get (form/parse "(mithril/module :name \"x\") ; ^:private #? foo") "name"))))
  (testing "opt-in features without the marker still refuse"
    (is (= :mithril.form/reader-cond
           (error-code #(form/parse "(mithril/module :name #? (:js \"j\" :default \"d\"))"
                                  {:features #{:js}}))))
  (testing "the marker without a feature set still refuses"
    (is (= :mithril.form/reader-cond
           (error-code #(form/parse "(mithril/form:v1) (mithril/module :name #? (:js \"j\" :default \"d\"))"
                                  {:features #{}})))))))

(deftest integer-width-and-numeric-literals
  (testing "every exactly representable integer parses"
    (is (= 9007199254740992 (get (form/parse "(mithril/module :score 9007199254740992)") "score")))
    (is (= -9007199254740992 (get (form/parse "(mithril/module :score -9007199254740992)") "score")))
    (is (= 255 (get (form/parse "(mithril/module :score 0xFF)") "score"))))
  (doseq [[text expected] [["(mithril/module :score 9007199254740993)" :mithril.form/i64-string]
                          ["(mithril/module :score -9007199254740993)" :mithril.form/i64-string]
                          ["(mithril/module :score 0x20000000000001)" :mithril.form/i64-string]
                          ["(mithril/module :score 0377)" :mithril.form/unsupported-numeric-literal]
                          ["(mithril/module :score 2r1010)" :mithril.form/unsupported-numeric-literal]
                          ["(mithril/module :score 0N)" :mithril.form/unsupported-numeric-literal]
                          ["(mithril/module :tags [9007199254740993])" :mithril.form/i64-string]
                          ["(mithril/module :name \"a\" ; note\n :score +0377)" :mithril.form/unsupported-numeric-literal]
                          ["(mithril/module :name \"a;\",:score 0377)" :mithril.form/unsupported-numeric-literal]]]
    (is (= expected (error-code #(form/parse text))) text))
  (testing "a js-value literal keeps the native double (existing shape)"
    (is (= 1.5 (get (form/parse "(mithril/literal :datatype \"js-value\" :value 1.5)") "value")))
    (is (= :mithril.form/unsupported-value
           (error-code #(form/parse "(mithril/module :score 1.5)")))))
  (testing "digits inside strings are data, never literals"
    (is (= "9007199254740993" (get (form/parse "(mithril/module :name \"9007199254740993\")") "name")))))

(deftest opt-in-reader-conditionals
  (testing "first match wins; :default is the fallthrough"
    (let [src "(mithril/form:v1) (mithril/module :name #? (:js \"j\" :default \"d\"))"]
      (is (= "j" (get (form/parse src {:features #{:js}}) "name")))
      (is (= "d" (get (form/parse src {:features #{:rust}}) "name")))))
  (testing "sequence tests match on any member"
    (let [src "(mithril/form:v1) (mithril/module :name #? ([:js :rust] \"x\" :default \"y\"))"]
      (is (= "x" (get (form/parse src {:features #{:rust :py}}) "name")))
      (is (= "y" (get (form/parse src {:features #{:py}}) "name")))))
  (testing "top-level and nested conditionals resolve at read time"
    (let [src "(mithril/form:v1) #? (:js (mithril/module :name \"j\") :default (mithril/module :name \"d\"))"]
      (is (= "j" (get (form/parse src {:features #{:js}}) "name")))
      (is (= "d" (get (form/parse src {:features #{:kotoba}}) "name"))))
    (let [src "(mithril/form:v1) (mithril/module :name #? (:js #? (:rust \"in\" :default \"j\") :default \"d\"))"]
      (is (= "in" (get (form/parse src {:features #{:js :rust}}) "name")))
      (is (= "j" (get (form/parse src {:features #{:js}}) "name")))))
  (testing "#?@ splices the selected vector's elements"
    (let [src "(mithril/form:v1) (mithril/module :name \"x\" :exports [ #?@ (:js [\"a\" \"b\"] :default [\"d\"]) ])"]
      (is (= ["a" "b"] (get (form/parse src {:features #{:js}}) "exports")))
      (is (= ["d"] (get (form/parse src {:features #{:py}}) "exports")))))
  (testing "clause and feature vocabulary failures are named"
    (doseq [[src features expected]
            [["(mithril/form:v1) (mithril/module :name #? (:js \"j\" :default))" #{:js} :mithril.feature/bad-clause]
             ["(mithril/form:v1) (mithril/module :name #? ())" #{:js} :mithril.feature/bad-clause]
             ["(mithril/form:v1) (mithril/module :name #? (:cobol \"j\" :default \"d\"))" #{:js} :mithril.feature/unknown-feature]
             ["(mithril/form:v1) (mithril/module :name #? (:js \"j\"))" #{:rust} :mithril.feature/no-match]
             ["(mithril/form:v1) (mithril/module :name #?@ (:js \"not-seq\" :default [\"d\"]))" #{:js} :mithril.feature/splice-arity]]]
      (is (= expected (error-code #(form/parse src {:features features}))) src)))
  (testing "a comment with no trailing newline inside #?( terminates as unbalanced"
    (doseq [src ["(mithril/form:v1) #?(:js \"x\" ;)"
                 "(mithril/form:v1) (mithril/module :name #?(:js \"x\" ;)"]]
      (is (= :mithril.feature/bad-clause
             (error-code #(form/parse src {:features #{:js}}))) src)))
  (testing "comments and strings inside a clause list are skipped, not read"
    (is (= "x" (get (form/parse "(mithril/form:v1) (mithril/module :name #?(:js \"x\" ; ) \"#?\"\n :default \"d\"))"
                                {:features #{:js}})
                    "name")))
    (is (= "#?(" (get (form/parse "(mithril/module :name \"#?(\") ; #?(:js\n") "name"))))
  (testing "top-level expansion to the wrong form count is named"
    (is (= :mithril.feature/multi-document
           (error-code #(form/parse "(mithril/form:v1) #?@ (:js [(mithril/module :name \"a\") (mithril/module :name \"b\")] :default (mithril/module :name \"d\"))"
                                 {:features #{:js}}))))
    (is (= :mithril.feature/empty-document
           (error-code #(form/parse "(mithril/form:v1) #?@ (:js [] :default (mithril/module :name \"d\"))"
                                  {:features #{:js}}))))))
