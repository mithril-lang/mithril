(ns mithril.form-test
  (:require [cljs.test :refer [deftest is testing]]
            [mithril.app :as app]
            [mithril.form :as form]
            [mithril.compiler :as compiler]))

(deftest module-form-admits-inert-typed-nodes
  (let [doc (form/parse "(mithril/module :name \"example\" :exports [\"main\"] :functions [(mithril/function :name \"main\" :returns \"i64\" :body (mithril/call :name \"add\" :args [(mithril/local :name \"x\") (mithril/literal :value 1 :datatype \"i64\")]))])")
        f (first (get doc "functions"))
        call (get f "body")]
    (is (= "Module" (get doc "@type")))
    (is (= "https://mithril.fund/context/module/v1" (get doc "@context")))
    (is (= "Function" (get f "@type")))
    (is (= "Call" (get call "@type")))
    (is (= ["Local" "Literal"] (mapv #(get % "@type") (get call "args"))))
    (is (= 1 (get (second (get call "args")) "value")))))

(deftest module-form-preserves-contexts-and-refusals
  (doseq [[tag context] [["program" "v1"] ["growth-decision" "growth-decision/v1"]
                         ["jev-decision" "jev-decision/v2"] ["bot-checkpoint-semantic" "bot-checkpoint/v1"]
                         ["twin-document" "twin/v1"]]]
    (is (= (str "https://mithril.fund/context/" context)
           (get (form/parse (str "(mithril/" tag ")")) "@context"))))
  (doseq [[text expected] [["(mithril/module :host/eval \"x\")" :mithril.form/unknown-field]
                          ["(mithril/module :body (js/eval :source \"x\"))" :mithril.form/unknown-tag]
                          ["(mithril/module :name \"a\" :name \"b\")" :mithril.form/duplicate-field]
                          ["(mithril/module) (mithril/module)" :mithril.form/form-count]
                          ["(mithril/module :body alert)" :mithril.form/unsupported-value]]]
    (is (= expected (try (form/parse text) nil
                     (catch :default e (:mithril/error (ex-data e))))))))

(defn read-text [path] (.readFileSync (js/require "fs") path "utf8"))
(defn error-code [f] (try (f) nil (catch :default e (:mithril/error (ex-data e)))))

(deftest kotoba-form-and-jsonld-have-one-semantic-identity
  (let [library (compiler/compile-library-text
                  "lib/app/agent-loop-v1.mith"
                  (read-text "lib/app/agent-loop-v1.mith"))
        json-artifact (app/compile-text
                        "examples/mithril-app-agent.mith"
                        (read-text "examples/mithril-app-agent.mith") [library])
        form-artifact (app/compile-text
                        "examples/mithril-app-agent-form.mith"
                        (read-text "examples/mithril-app-agent-form.mith") [library])]
    (is (= json-artifact form-artifact))
    (is (= "sha256:fea2302f51b8915e341197e59c76dcff15a8b80775545cbbb5684d428e693fb1"
           (:graph-digest form-artifact)))))

(deftest owl-rdf-shacl-form-compiles-to-jsonld-rdf-dataset
  (let [artifact (compiler/compile-ontology-text
                   "ontology/semantic-core-v1.mith"
                   (read-text "ontology/semantic-core-v1.mith"))]
    (is (= "https://mithril.fund/artifact/ontology-v1" (:format artifact)))
    (is (= "application/vnd.mithril.form" (:media-type artifact)))
    (is (= "application/ld+json" (:jsonld-media-type artifact)))
    (is (= 5 (count (get-in artifact [:rdf-dataset "@graph"]))))
    (is (re-matches #"sha256:[0-9a-f]{64}" (:graph-digest artifact)))))

(deftest bpmn-agent-ontology-is-a-compiled-rdf-owl-shacl-artifact
  (let [artifact (compiler/compile-ontology-text
                  "ontology/bpmn-agent-v1.mith"
                  (read-text "ontology/bpmn-agent-v1.mith"))]
    (is (= "https://mithril.fund/artifact/ontology-v1" (:format artifact)))
    (is (= "sha256:b3f864a5b1c627e628be9767f1a6936b55dea44c565a20e3e0c20049855e3e8b"
           (:graph-digest artifact)))
    (is (= 6 (count (get-in artifact [:rdf-dataset "@graph"]))))))

(deftest form-reader-is-inert-and-fail-closed
  (testing "a second form is observable"
    (is (= :mithril.form/form-count
           (error-code #(compiler/parse-source
                          "(mithril/program :id \"https://mithril.fund/id/a\")\n(mithril/program :id \"https://mithril.fund/id/b\")")))))
  (testing "unknown tags cannot call host code"
    (is (= :mithril.form/unknown-tag
           (error-code #(compiler/parse-source "(js/eval :source \"alert(1)\")")))))
  (testing "duplicate fields are rejected"
    (is (= :mithril.form/duplicate-field
           (error-code #(compiler/parse-source "(mithril/app :name \"a\" :name \"b\")"))))))
