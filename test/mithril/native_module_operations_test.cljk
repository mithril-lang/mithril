(ns mithril.native-module-operations-test
 (:require [cljs.test :refer [deftest is]] [mithril.native-js :as native]
           [mithril.form :as form] [mithril.module :as guest]
           [mithril.native-js-test :as helpers]
           ["node:fs" :as fs] ["node:os" :as os] ["node:path" :as path]
           ["node:child_process" :as child]))
(deftest module-operations-admit-checked-operands-and-refuse-malformed-and-guest-forms
 (let [meta {"@type" "HostImportMeta"}
       source (helpers/local "source")
       call {"@type" "HostDynamicImport" "source" source}
       doc #(helpers/document [] [(helpers/function "load" ["source" "options"] %)] ["load"])
       text (fs/readFileSync "examples/native-js-module-operations.mith" "utf8")]
  (is (= [] (:required-imports (native/compile-text text))))
  (is (= (native/compile-text text) (native/compile-document (form/parse text))))
  (doseq [[expr code] [[(assoc meta "raw" "url") :mithril.native-js/shape]
                       [{"@type" "HostDynamicImport"} :mithril.native-js/shape]
                       [(assoc call "raw" "payload") :mithril.native-js/shape]
                       [(assoc call "source" nil) :mithril.native-js/shape]
                       [(assoc call "options" nil) :mithril.native-js/shape]
                       [(assoc call "source" (helpers/local "missing")) :mithril.native-js/local]
                       [(assoc call "options" (helpers/local "missing")) :mithril.native-js/local]]]
   (is (= code (helpers/refusal (doc expr)))))
  (is (= :mithril.native-js/budget
         (helpers/refusal (doc (reduce (fn [expr _] {"@type" "HostDynamicImport" "source" expr}) source (range 65))))))
  (is (some? (try (guest/check-text text) nil (catch :default e (:mithril/error (ex-data e))))))))
(deftest actual-native-clis-preserve-module-meta-and-import-semantics
 (let [dir (fs/mkdtempSync (path/join (os/tmpdir) "mithril-module-operations-"))
       config (path/join dir "offline.edn") engine (aget (.-argv js/process) 1)]
  (try
   (fs/writeFileSync config "{:paths []}")
   (doseq [target ["js" "js-browser"] mode ["standalone" "esm" "library" "explicit-package"]]
    (let [out (path/join dir (str target "-" mode))
          file (if (= mode "esm") (path/join out "index.mjs") (str out ".mjs"))
          args (case mode
                 "explicit-package" ["-e" (str "(require '[mithril.native-package :as p] '[\"node:fs\" :as fs]) (fs/writeFileSync " (js/JSON.stringify file) " (:source (p/compile-text (fs/readFileSync \"examples/native-js-module-operations-package.mith\" \"utf8\") {\"native-js-module-operations.mith\" (fs/readFileSync \"examples/native-js-module-operations.mith\" \"utf8\")})))")]
                 "esm" ["bin/mithril-native-esm.cljk" "examples/native-js-module-operations-esm.mith" "--target" target "--output-directory" out]
                 "library" ["bin/mithril-native-package.cljk" "examples/native-js-module-operations-package.mith" "--target" target "--output" file]
                 ["bin/mithril-native-js.cljk" "examples/native-js-module-operations.mith" "--target" target "--output" file])
          result (child/spawnSync js/process.execPath (clj->js (concat [engine "--config" config "--classpath" "src"] args)) #js {:encoding "utf8" :timeout 30000})]
     (is (= 0 (.-status result)) (str (.-stdout result) (.-stderr result)))
     (let [result (child/spawnSync js/process.execPath #js ["test/fixtures/native-module-operations-contract.mjs" file mode] #js {:encoding "utf8" :timeout 30000})]
      (is (= 0 (.-status result)) (str (.-stdout result) (.-stderr result))))))
   (finally (fs/rmSync dir #js {:recursive true :force true})))))
