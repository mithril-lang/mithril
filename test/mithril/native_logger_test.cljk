(ns mithril.native-logger-test
 (:require [cljs.test :refer [deftest is]] [mithril.native-js :as native] [mithril.form :as form]
           [mithril.native-class-test :as c]
           ["node:fs" :as fs] ["node:os" :as os] ["node:path" :as path] ["node:child_process" :as child]))
(defn ret [v] {"@type" "HostReturn" "value" v})
(def cont {"@type" "HostContinue"})
(def brk {"@type" "HostBreak"})
(defn direct [body] (assoc (c/normal body) "statements" true))
(defn forof [body] {"@type" "HostForOf" "iterable" (c/local "values") "binding" "value" "body" body "result" c/undef})
(defn control [body] (assoc (direct body) "params" [(c/param "values")]))
(defn finallyx [body final] {"@type" "HostTryFinally" "body" body "finally" final})
(defn check-refused? [d] (try (native/check-document d) false (catch :default _ true)))
(deftest source-control-transfer-and-expression-refusals
 (let [returned (ret (c/local "value"))
       flow (control (forof (finallyx returned (c/call (c/grant "mark") (c/local "value")))))
       continued (control (c/seqx (forof (finallyx cont (c/call (c/grant "mark") (c/local "value")))) (c/lit 7)))
       broken (control (c/seqx (forof (finallyx brk (c/call (c/grant "mark") (c/local "value")))) (c/lit 8)))
       override (direct (finallyx (ret (c/lit 1)) (ret (c/lit 2))))
       while-flow (control {"@type" "Let" "bindings" [{"name" "i" "value" (c/lit 0) "mutable" true}]
                            "body" {"@type" "HostWhile" "condition" {"@type" "HostBinary" "operator" "<" "left" (c/local "i") "right" (c/lit 3)}
                                    "body" (c/seqx {"@type" "LocalSet" "name" "i" "value" {"@type" "HostBinary" "operator" "+" "left" (c/local "i") "right" (c/lit 1)}}
                                                   (finallyx {"@type" "If" "condition" {"@type" "HostBinary" "operator" "===" "left" (c/local "values") "right" (c/lit "return")}
                                                              "then" (ret (c/local "i")) "else" {"@type" "If" "condition" {"@type" "HostBinary" "operator" "===" "left" (c/local "values") "right" (c/lit "break")} "then" brk "else" cont}}
                                                             (c/call (c/grant "mark") (c/local "i")))) "result" (c/local "i")}})
       returned (ret (c/lit 1))
       malformed [(c/document returned []) (c/document cont []) (c/document brk [])
                  (c/document (c/normal returned) []) (c/document (direct cont) [])
                  (c/document (direct (c/arr returned)) [])
                  (c/document (direct (c/call returned)) [])
                  (c/document (direct {"@type" "Let" "bindings" [{"name" "x" "value" returned}] "body" c/undef}) [])
                  (c/document (assoc (direct c/undef) "params" [(assoc (c/param "x") "default" returned)]) [])
                  (c/document (direct (assoc (c/arrow c/undef) "params" [{"name" "x" "default" returned}])) [])
                  (c/document (control (forof (assoc (c/arrow cont) "statements" true))) [])
                  (c/document (control (forof (direct brk))) [])
                  (c/document (direct (c/klass nil returned nil [])) [])
                  (c/document (direct (c/klass nil nil nil [(assoc (c/meth "x" c/undef) "key" returned)])) [])
                  (c/document (c/klass nil nil nil [{"kind" "static-block" "body" returned}]) [])
                  (c/document (direct (c/arr (forof cont))) [])
                  (c/document (direct {"@type" "LocalFunction" "name" "f" "params" [] "body" c/undef "result" returned}) [])
                  (c/document (assoc returned "source" "JS") [])]
       dir (fs/mkdtempSync (path/join (os/tmpdir) "mithril-control-transfer-"))]
  (is (= (form/parse "(mithril/host-return :value (mithril/host-undefined))") (ret c/undef)))
  (is (every? check-refused? malformed))
  (try
   (fs/writeFileSync (path/join dir "artifacts.json") (js/JSON.stringify (clj->js {"return" (c/source flow ["mark"]) "continue" (c/source continued ["mark"]) "break" (c/source broken ["mark"]) "override" (c/source override []) "while" (c/source while-flow ["mark"])})))
   (let [r (child/spawnSync js/process.execPath (clj->js ["test/fixtures/native-control-transfer-contract.mjs" dir]) #js {:encoding "utf8" :timeout 30000})]
    (is (= 0 (.-status r)) (str (.-stdout r) (.-stderr r))) (print (.-stdout r)))
   (finally (fs/rmSync dir #js {:recursive true :force true})))))
(deftest complete-cordis-logger-source
 (let [text (fs/readFileSync "examples/native-js-cordis-logger.mith" "utf8") checked (native/check-text text)
       dir (fs/mkdtempSync (path/join (os/tmpdir) "mithril-whole-logger-"))]
  (is (= (native/compile-text text) (native/compile-document (form/parse text))))
  (is (= ["defaultFormatters" "Logger" "c16" "c256" "LoggerService"] (mapv :name (:exports checked))))
  (try
   (let [engine (.-MITHRIL_NATIVE_ENGINE js/process.env) config (path/join dir "offline.edn")]
    (fs/writeFileSync config "{:paths [\"src\"]}\n")
    (doseq [target ["js" "js-browser"] [cli input prefix] [["bin/mithril-native-js.cljk" "examples/native-js-cordis-logger.mith" "logger"] ["bin/mithril-native-js.cljk" "examples/native-js-cordis-utils.mith" "utils"] ["bin/mithril-native-package.cljk" "examples/native-js-cosmokit.mith" "cosmokit"]]]
     (let [r (child/spawnSync js/process.execPath (clj->js [engine "--config" config "-cp" "src" cli input "--target" target "--output" (path/join dir (str prefix "-" target ".mjs"))]) #js {:encoding "utf8" :timeout 30000})]
      (when-not (= 0 (.-status r)) (throw (js/Error. (str (.-stdout r) (.-stderr r))))))))
   (let [r (child/spawnSync js/process.execPath (clj->js ["test/fixtures/native-logger-contract.mjs" dir]) #js {:encoding "utf8" :timeout 30000})]
    (is (= 0 (.-status r)) (str (.-stdout r) (.-stderr r))) (print (.-stdout r)))
   (finally (fs/rmSync dir #js {:recursive true :force true})))))
