(ns mithril.native-classic-for-test
 (:require [cljs.test :refer [deftest is]] [mithril.native-js :as native] [mithril.form :as form]
           [mithril.native-class-test :as c]
           ["node:fs" :as fs] ["node:os" :as os] ["node:path" :as path] ["node:child_process" :as child]))
(def forx {"@type" "HostFor" "initializer" nil "condition" nil "update" nil "body" c/undef "result" c/undef})
(def updatex {"@type" "HostLocalUpdate" "name" "i" "operator" "++" "prefix" false})
(def init {"bindings" [{"name" "i" "value" (c/lit 0) "mutable" true}]})
(def loopx (assoc forx "initializer" init "condition" (c/lit false) "update" updatex))
(def brk {"@type" "HostBreak"})
(def cont {"@type" "HostContinue"})
(def ret {"@type" "HostReturn" "value" c/undef})
(defn source [v] (assoc (c/normal v) "statements" true))
(defn refused? [v] (try (native/check-document (c/document v [])) false (catch :default _ true)))
(deftest checked-for-local-update-and-own-control-scope
 (let [bad [(dissoc forx "update") (assoc forx "source" "raw JS")
            (assoc forx "initializer" {}) (assoc forx "initializer" {"bindings" []})
            (assoc forx "initializer" {"expression" c/undef "bindings" []})
            (assoc forx "initializer" {"bindings" '(nil)})
            (assoc forx "initializer" {"bindings" [{"name" "i" "value" c/undef "mutable" "yes"}]})
            (assoc forx "initializer" {"bindings" [{"name" "i" "value" c/undef "recursive" true}]})
            (assoc forx "initializer" {"bindings" [{"name" "i" "value" c/undef} {"name" "i" "value" c/undef}]})
            (assoc forx "initializer" {"bindings" [{"name" "i" "value" c/undef} {"name" "j" "value" c/undef "mutable" true}]})
            (assoc forx "initializer" {"bindings" (mapv (fn [i] {"name" (str "x" i) "value" c/undef}) (range 65))})
            (assoc loopx "result" (c/local "i"))
            {"@type" "Let" "bindings" [{"name" "i" "value" c/undef}] "body" loopx}
            (assoc loopx "initializer" {"bindings" [{"name" "i" "value" c/undef}]})
            updatex (assoc loopx "update" (assoc updatex "name" "missing"))
            (assoc loopx "update" (assoc updatex "operator" "+="))
            (assoc loopx "update" (assoc updatex "prefix" "false"))
            (assoc loopx "update" (assoc updatex "value" c/undef))
            (assoc forx "body" ret)
            (assoc forx "initializer" {"expression" brk})
            (assoc forx "condition" cont) (assoc forx "update" brk)
            (source (assoc forx "body" (source brk)))
            (source (assoc forx "body" (assoc (c/arrow cont) "statements" true)))
            (source (assoc forx "body" (c/klass "Nested" nil nil [{"kind" "static-block" "body" cont}])))
            (assoc (c/normal (assoc forx "body" {"@type" "HostAwait" "value" c/undef})) "async" true)
            (assoc (c/normal (assoc forx "body" {"@type" "HostYield" "value" c/undef})) "generator" true)
            (assoc (source (assoc forx "initializer" {"bindings" [{"name" "yield" "value" c/undef}]})) "generator" true)
            (assoc forx "body" (reduce (fn [v _] (assoc forx "body" v)) c/undef (range 65)))
            {"@type" "Sequence" "expressions" (vec (repeat 2048 forx))}]
       text (fs/readFileSync "examples/native-js-classic-for.mith" "utf8")]
  (is (= forx (form/parse "(mithril/host-for :initializer nil :condition nil :update nil :body (mithril/host-undefined) :result (mithril/host-undefined))")))
  (is (every? refused? bad))
  (is (= (native/compile-text text) (native/compile-document (form/parse text))))
  (is (and (not (refused? loopx)) (not (refused? (assoc forx "body" (c/seqx cont brk))))))))
(deftest native-classic-for-cli
 (let [dir (fs/mkdtempSync (path/join (os/tmpdir) "mithril-classic-for-"))]
  (try
   (let [engine (.-MITHRIL_NATIVE_ENGINE js/process.env) config (path/join dir "offline.edn")]
    (fs/writeFileSync config "{:paths [\"src\"]}\n")
    (doseq [target ["js" "js-browser"]
            [input output] [["native-js-classic-for.mith" (str "classic-for-" target)] ["native-js-schema-classic-for.mith" (str "schema-classic-for-" target)]]]
     (let [r (child/spawnSync js/process.execPath
              (clj->js [engine "--config" config "-cp" "src" "bin/mithril-native-js.cljk" (str "examples/" input) "--target" target "--output" (path/join dir (str output ".mjs"))])
              #js {:encoding "utf8" :timeout 30000})]
      (when-not (= 0 (.-status r)) (throw (js/Error. (str (.-stdout r) (.-stderr r))))))))
   (doseq [contract ["native-classic-for-contract.mjs" "schema-classic-for-contract.mjs"]]
    (let [r (child/spawnSync js/process.execPath (clj->js [(str "test/fixtures/" contract) dir]) #js {:encoding "utf8" :timeout 30000})]
    (is (= 0 (.-status r)) (str (.-stdout r) (.-stderr r))) (print (.-stdout r))))
   (finally (fs/rmSync dir #js {:recursive true :force true})))))
