(ns mithril.native-module-init-primitives (:require [mithril.native-js :as n] [mithril.form :as f] [mithril.module :as guest] ["node:fs" :as fs] ["node:crypto" :as crypto] ["node:child_process" :as child] ["node:os" :as os] ["node:path" :as path]))
(defn verify []
(def root "test/fixtures/module-init-")
(def dir (fs/mkdtempSync (path/join (os/tmpdir) "mithril-module-init-")))
(def candidate-path (path/join dir "init-candidate.mjs"))
(def nested-path (path/join dir "init-nested.mjs"))
(def doc (js->clj (js/JSON.parse (fs/readFileSync (str root "module.json") "utf8"))))
(def artifact (n/compile-document doc))
(when-not (try (guest/check-document doc) false (catch :default _ true)) (throw (js/Error. "Guest admitted native init")))
(when-not (= artifact (n/compile-document doc)) (throw (js/Error. "Non-deterministic init artifact")))
(defn refuses [x code] (try (n/check-document x) (throw (js/Error. "Malformed init admitted")) (catch :default e (when-not (= code (:mithril/error (ex-data e))) (throw e)))))
(refuses (assoc-in doc ["bindings" 1 "value"] {"@type" "FunctionRef" "name" "unknown"}) :mithril.native-js/function)
(refuses (assoc-in doc ["bindings" 1 "value"] {"@type" "Call" "name" "unknown" "args" []}) :mithril.native-js/function)
(refuses (assoc-in doc ["bindings" 1 "value"] {"@type" "FunctionRef" "name" "read" "extra" 0}) :mithril.native-js/shape)
(refuses (assoc-in doc ["bindings" 1 "value"] {"@type" "HostArgumentsLength"}) :mithril.native-js/scope)
(refuses (assoc-in doc ["bindings" 1 "value"] {"@type" "NativeLambda" "params" [] "body" {"@type" "HostArgumentsLength"}}) :mithril.native-js/scope)
(refuses (assoc-in doc ["bindings" 1 "value"] {"@type" "Local" "name" "late"}) :mithril.native-js/local)
(refuses (assoc-in doc ["bindings" 1 "value"] {"@type" "LocalSet" "name" "namespace" "value" {"@type" "FunctionRef" "name" "read"}}) :mithril.native-js/local)
(def literal (fn [v] {"@type" "Literal" "datatype" "js-value" "value" v}))
(def nested (assoc doc "bindings" [{"name" "thunk" "value" {"@type" "NativeLambda" "params" [] "body" {"@type" "FunctionRef" "name" "identity"}}}] "functions" [{"@type" "Function" "name" "identity" "params" [] "returns" "js-value" "body" (literal 1)}] "exports" [{"name" "thunk" "value" {"@type" "Local" "name" "thunk"}}]))
(def nested-artifact (n/compile-document nested))
(def inert (assoc nested "bindings" [{"name" "data" "value" (literal "function-ref identity")}] "exports" ["identity"]))
(def inert-source (:source (n/compile-document inert)))
(when-not (< (.indexOf inert-source "const __mithril_native_v1=") (.indexOf inert-source "const __mithril_native_f0=")) (throw (js/Error. "Literal data changed old function order")))
(def oversized (assoc nested "bindings" [{"name" "many" "value" {"@type" "Sequence" "expressions" (vec (repeat 4096 {"@type" "FunctionRef" "name" "identity"}))}}] "exports" ["identity"]))
(refuses oversized :mithril.native-js/budget)
(refuses (assoc nested "bindings" [{"name" "deep" "value" (nth (iterate (fn [x] {"@type" "NativeLambda" "params" [] "body" x}) {"@type" "FunctionRef" "name" "identity"}) 65)}]) :mithril.native-js/budget)
(fs/writeFileSync candidate-path (:source artifact))
(fs/writeFileSync nested-path (:source nested-artifact))
(let [r (child/spawnSync js/process.execPath
                         (clj->js ["--input-type=module" "-e"
                                   "import assert from 'node:assert/strict';const m=await import(process.argv[1]);const a=m.instantiateMithrilNative({observe(){},after(){}});assert.equal(a.thunk().name,'identity');assert.equal(a.thunk()(),1);console.log('Nested init reference closure passed.');"
                                   nested-path])
                         #js {:stdio "inherit"})]
  (when-not (= 0 (.-status r)) (throw (js/Error. "Nested reference failed"))))
(doseq [[name sha] (js->clj (js/JSON.parse (fs/readFileSync (str root "artifact-hashes.json") "utf8")))] (when-not (= sha (-> (crypto/createHash "sha256") (.update (:source (n/compile-text (fs/readFileSync (str "examples/native-js-" name ".mith") "utf8")))) (.digest "hex"))) (throw (js/Error. "Prior artifact changed"))))
(let [r (child/spawnSync js/process.execPath
                         (clj->js ["--experimental-vm-modules"
                                   "test/fixtures/module-init-contract.mjs" "candidate"
                                   candidate-path "test/fixtures/module-init-cases.json"
                                   "test/fixtures/module-init-expected.json"])
                         #js {:stdio "inherit"})]
  (when-not (= 0 (.-status r)) (throw (js/Error. "Module init runtime failed"))))
(println "3 admissions, 7 malformed/scope refusals, 2 budget refusals, six old hashes unchanged.")
)
