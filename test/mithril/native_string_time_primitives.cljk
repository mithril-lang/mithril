(ns mithril.native-string-time-primitives (:require [mithril.native-js :as n] [mithril.module :as guest] ["node:fs" :as fs] ["node:crypto" :as crypto] ["node:child_process" :as child]))
(defn lit [v] {"@type" "Literal" "datatype" "js-value" "value" v})
(defn local [s] {"@type" "Local" "name" s})
(defn regex [p f] {"@type" "HostRegExp" "pattern" p "flags" f})
(defn method [items] {"@type" "HostMethodItems" "object" (local "o") "key" (local "k") "items" items})
(defn fun [name params body] {"@type" "Function" "name" name "params" (mapv #(hash-map "name" % "datatype" "js-value") params) "returns" "js-value" "body" body})
(defn doc [body] {"@context" "https://mithril.fund/context/native-js-module/v1" "@type" "NativeJsModule" "name" "cosmokit.string_time_prereqs" "imports" [] "functions" [(fun "probe" ["o" "k" "a" "b"] body)] "exports" ["probe"]})
(defn verify [file runtime-file hashes-file]
(doseq [body [(regex "" "") (regex "[_-][a-z]" "g") (method []) (method [{"spread" (local "a")}]) {"@type" "HostUnary" "operator" "+" "value" (local "a")}]] (n/compile-document (doc body)))
(doseq [op ["<=" "*" "/"]] (n/compile-document (doc {"@type" "HostBinary" "operator" op "left" (local "a") "right" (local "b")})))
(def malformed [(assoc (regex "a" "") "extra" true) (dissoc (regex "a" "") "flags") (regex 1 "") (regex "a" ["g"]) (regex "[" "") (regex "\\" "") (regex "a" "gg") (regex "a" "uv") (regex "a" "z") (assoc (method []) "extra" true) (dissoc (method []) "items") (method "raw") (method ["raw"]) (method [{}]) (method [{"value" (lit 1) "spread" (local "a")}]) (method [{"spread" (local "missing")}]) (method [{"value" (lit 1) "extra" 2}]) (method [{"spread" "raw"}])])
(doseq [body malformed] (when-not (try (n/compile-document (doc body)) false (catch :default _ true)) (throw (js/Error. "Malformed string/time form admitted"))))
(doseq [d [(doc (regex (apply str (repeat 4097 "a")) "")) (doc (method (vec (repeat 65 {"value" (lit 1)})))) (doc (method (vec (repeat 64 {"value" {"@type" "HostArray" "items" (vec (repeat 64 (lit 0)))}})))) (doc (reduce (fn [x _] {"@type" "HostUnary" "operator" "+" "value" x}) (lit 0) (range 65)))]]
 (when-not (= :mithril.native-js/budget (try (n/compile-document d) nil (catch :default e (:mithril/error (ex-data e))))) (throw (js/Error. "String/time shared budget bypassed"))))
(doseq [body ["(mithril/host-regexp :pattern \"a\" :flags \"g\")" "(mithril/host-method-items :object (mithril/literal :datatype \"js-value\" :value nil) :key (mithril/literal :datatype \"js-value\" :value \"m\") :items [])"]]
 (n/compile-text (str "(mithril/native-js-module :name \"form.string_time\" :imports [] :functions [(mithril/function :name \"probe\" :params [] :returns \"js-value\" :body " body ")] :exports [\"probe\"])")))
(def functions (into (mapv (fn [[name p f]] (fun name [] (regex p f))) [["regex" "[_-][a-z]" "g"] ["property" "^[a-z_$][\\w$]*$" "i"] ["numeric" "\\d+(?:\\.\\d+)?" ""] ["escaped" "/\n\r\u2028\u2029" ""] ["attack" "a/;globalThis.__mithril_injected=1;//" ""] ["empty" "" ""] ["unicode" "[\\p{ASCII}&&\\p{Letter}]" "v"] ["flags" "a" "ydgimsu"]])
 [(fun "method" ["o" "k" "a" "b"] (method [{"value" (lit 0)} {"spread" (local "a")} {"value" (lit 1)} {"spread" (local "b")} {"value" (lit 2)}])) (fun "none" ["o" "k"] (method []))
 (fun "counted" ["o" "k"] (method [{"spread" {"@type" "HostArray" "items" [{"@type" "HostArgumentsLength"}]}}]))
 (fun "chars" ["o" "a"] (assoc (method [{"spread" (local "a")}]) "key" (lit "fromCharCode")))
 (fun "le" ["a" "b"] {"@type" "HostBinary" "operator" "<=" "left" (local "a") "right" (local "b")})
 (fun "mul" ["a" "b"] {"@type" "HostBinary" "operator" "*" "left" (local "a") "right" (local "b")})
 (fun "div" ["a" "b"] {"@type" "HostBinary" "operator" "/" "left" (local "a") "right" (local "b")})
 (fun "plus" ["a"] {"@type" "HostUnary" "operator" "+" "value" (local "a")})]))
(let [d (assoc (doc (lit 0)) "functions" functions "exports" (mapv #(get % "name") functions)) a (n/compile-document d)]
 (when-not (= a (n/compile-document d)) (throw (js/Error. "Non-deterministic compile")))
 (fs/writeFileSync file (:source a))
 (let [r (child/spawnSync js/process.execPath #js [runtime-file file] #js {:stdio "inherit" :timeout 30000})] (when-not (= 0 (.-status r)) (js/process.exit 1))))
(def hashes (js->clj (js/JSON.parse (fs/readFileSync hashes-file "utf8"))))
(doseq [[name sha] hashes] (when-not (= sha (-> (crypto/createHash "sha256") (.update (:source (n/compile-text (fs/readFileSync (str "examples/native-js-" name ".mith") "utf8")))) (.digest "hex"))) (throw (js/Error. (str "Prior artifact changed: " name)))))
(println "8 admissions / 18 malformed refusals / 4 budget refusals / 2 Form tags; 5 artifact hashes unchanged.")

)
