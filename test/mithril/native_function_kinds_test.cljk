(ns mithril.native-function-kinds-test
 (:require [cljs.test :refer [deftest is]] [mithril.native-js :as native] [mithril.form :as form]
           ["node:fs" :as fs] ["node:os" :as os] ["node:path" :as path] ["node:child_process" :as child]))
(defn lit [x] {"@type" "Literal" "datatype" "js-value" "value" x})
(defn local [x] {"@type" "Local" "name" x})
(defn grant [x] {"@type" "HostImport" "name" x})
(def this {"@type" "HostThis"})
(def nt {"@type" "HostNewTarget"})
(def argc {"@type" "HostArgumentsLength"})
(defn arr [& xs] {"@type" "HostArray" "items" (vec xs)})
(def base {"@type" "NativeFunction" "name" "__mithril_native_v1"
           "params" [{"name" "value" "datatype" "js-value" "default" argc}] "rest" "tail"
           "body" {"@type" "Sequence" "expressions" [{"@type" "HostInvoke" "function" (grant "mark") "args" [this]}
                                                      (arr this nt argc (local "value") (local "tail") (local "__mithril_native_v1"))]}})
(defn doc [x imports]
 {"@context" "https://mithril.fund/context/native-js-module/v1" "@type" "NativeJsModule" "name" "function.kinds"
  "imports" imports "functions" [] "exports" [{"name" "value" "value" x}]})
(deftest native-function-kinds-and-complete-constructor-classifier
 (let [text (fs/readFileSync "examples/native-js-is-constructor.mith" "utf8")
       bad [(doc (assoc base "generator" 1) ["mark"])
            (doc (assoc base "async" nil) ["mark"])
            (doc (assoc base "generator" true "source" "raw JS") ["mark"])
            (doc (assoc base "async" true "params" [{"name" "x" "datatype" "js-value" "default" (local "missing")}]) ["mark"])
            (doc (assoc base "async" true "generator" true "rest" "return") ["mark"])
            (doc (assoc base "async" true "generator" true "name" "yield") ["mark"])
            (doc (assoc base "generator" true "rest" "value") ["mark"])
            (doc (assoc base "generator" true "body" {"@type" "HostSuperCall" "items" []}) ["mark"])
            (doc (assoc base "async" true "body" {"@type" "HostAwait" "value" (lit 0)}) ["mark"])
            (doc (assoc base "generator" true "body" {"@type" "HostYield" "value" (lit 0)}) ["mark"])]
       artifacts (into {} (for [[name flags] [["normal" {}] ["generator" {"generator" true}] ["async" {"async" true}] ["asyncGenerator" {"async" true "generator" true}]]]
                           [name (:source (native/compile-document (doc (merge base flags) ["mark"]))) ]))
       artifacts (into artifacts (for [[name flags] [["returnNormal" {}] ["returnGenerator" {"generator" true}] ["returnAsync" {"async" true}] ["returnAsyncGenerator" {"async" true "generator" true}]]]
                                [name (:source (native/compile-document (doc (merge base flags {"body" {"@type" "HostInvoke" "function" (grant "mark") "args" []}}) ["mark"]))) ]))
       artifacts (assoc artifacts "classifier" (:source (native/compile-text text)))
       dir (fs/mkdtempSync (path/join (os/tmpdir) "mithril-function-kinds-"))]
  (is (and (= (native/compile-text text) (native/compile-document (form/parse text)))
           (= (:source (native/compile-document (doc base ["mark"])))
              (:source (native/compile-document (doc (assoc base "async" false "generator" false) ["mark"]))))))
  (is (every? (fn [d] (try (native/check-document d) false (catch :default _ true))) bad))
  (try
   (fs/writeFileSync (path/join dir "artifacts.json") (js/JSON.stringify (clj->js artifacts)))
   (let [engine (.-MITHRIL_NATIVE_ENGINE js/process.env) config (path/join dir "offline.edn")]
    (fs/writeFileSync config "{:paths [\"src\"]}\n")
    (doseq [target ["js" "js-browser"]]
     (let [r (child/spawnSync js/process.execPath
              (clj->js [engine "--config" config "-cp" "src" "bin/mithril-native-js.cljk" "examples/native-js-is-constructor.mith" "--target" target "--output" (path/join dir (str target ".mjs"))])
              #js {:encoding "utf8" :timeout 30000})]
      (when-not (= 0 (.-status r)) (throw (js/Error. (str (.-stdout r) (.-stderr r))))))))
   (let [r (child/spawnSync js/process.execPath (clj->js ["test/fixtures/native-function-kinds-contract.mjs" dir]) #js {:encoding "utf8" :timeout 30000})]
    (is (= 0 (.-status r)) (str (.-stdout r) (.-stderr r))) (print (.-stdout r)))
   (finally (fs/rmSync dir #js {:recursive true :force true})))))
