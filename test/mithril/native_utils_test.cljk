(ns mithril.native-utils-test
 (:require [cljs.test :refer [deftest is]] [mithril.native-js :as native] [mithril.form :as form]
           ["node:fs" :as fs] ["node:os" :as os] ["node:path" :as path] ["node:child_process" :as child]))
(defn lit [x] {"@type" "Literal" "datatype" "js-value" "value" x})
(defn local [x] {"@type" "Local" "name" x})
(defn arr [& xs] {"@type" "HostArray" "items" (vec xs)})
(defn rec [name value body mutable?] {"@type" "Let" "bindings" [{"name" name "value" value "recursive" true "mutable" mutable?}] "body" body})
(defn arrow [body] {"@type" "NativeLambda" "params" [] "body" body "statements" true})
(defn normal [body] {"@type" "NativeFunction" "name" nil "params" [] "rest" nil "body" body "statements" true})
(defn doc [x] {"@context" "https://mithril.fund/context/native-js-module/v1" "@type" "NativeJsModule" "name" "recursive.control" "imports" [] "functions" [] "exports" [{"name" "value" "value" x}]})
(defn source [x] (:source (native/compile-document (doc x))))
(defn call [f & xs] {"@type" "HostInvoke" "function" f "args" (vec xs)})
(deftest recursive-tdz-and-complete-cordis-utils
 (let [text (fs/readFileSync "examples/native-js-cordis-utils.mith" "utf8")
       self (rec "__mithril_native_v1" (arrow (local "__mithril_native_v1")) (local "__mithril_native_v1") false)
       early (normal (rec "proxy" (call (arrow (local "proxy"))) (local "proxy") false))
       assign (normal (rec "proxy" {"@type" "LocalSet" "name" "proxy" "value" (lit 2)} (local "proxy") true))
       closure (rec "f" (normal (local "f")) (local "f") false)
       mixed (normal (rec "x" (arrow (local "x")) (arr (local "x") (call (local "x"))) false))
       bad [(doc (assoc-in self ["bindings" 0 "recursive"] 1))
            (doc (assoc-in self ["bindings" 0 "mutable"] nil))
            (doc (assoc-in self ["bindings" 0 "recursive"] false))
            (doc (rec "x" (arrow (local "later")) (local "x") false))
            (doc (rec "x" (arrow {"@type" "LocalSet" "name" "x" "value" (lit 2)}) (local "x") false))
            (doc (assoc (arrow (lit 0)) "statements" "true"))
            (doc (assoc (normal (lit 0)) "statements" 1))
            (doc (assoc-in self ["bindings" 0 "source"] "raw JS"))]
       artifacts {"self" (source self) "early" (source early) "assign" (source assign) "closure" (source closure) "mixed" (source mixed)}
       dir (fs/mkdtempSync (path/join (os/tmpdir) "mithril-utils-"))]
  (is (= (native/compile-text text) (native/compile-document (form/parse text))))
  (is (every? (fn [d] (try (native/check-document d) false (catch :default _ true))) bad))
  (try
   (fs/writeFileSync (path/join dir "artifacts.json") (js/JSON.stringify (clj->js artifacts)))
   (let [engine (.-MITHRIL_NATIVE_ENGINE js/process.env) config (path/join dir "offline.edn")]
    (fs/writeFileSync config "{:paths [\"src\"]}\n")
    (doseq [target ["js" "js-browser"]]
     (doseq [[cli input name] [["bin/mithril-native-js.cljk" "examples/native-js-cordis-utils.mith" "utils"] ["bin/mithril-native-package.cljk" "examples/native-js-cosmokit.mith" "cosmokit"]]]
      (let [r (child/spawnSync js/process.execPath (clj->js [engine "--config" config "-cp" "src" cli input "--target" target "--output" (path/join dir (str name "-" target ".mjs"))]) #js {:encoding "utf8" :timeout 30000})]
       (when-not (= 0 (.-status r)) (throw (js/Error. (str (.-stdout r) (.-stderr r)))))))))
   (let [r (child/spawnSync js/process.execPath (clj->js ["test/fixtures/native-utils-contract.mjs" dir]) #js {:encoding "utf8" :timeout 30000})]
    (is (= 0 (.-status r)) (str (.-stdout r) (.-stderr r))) (print (.-stdout r)))
   (finally (fs/rmSync dir #js {:recursive true :force true})))))
