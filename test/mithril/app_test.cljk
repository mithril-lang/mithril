(ns mithril.app-test
  (:require [cljs.test :refer [deftest is testing]]
            [clojure.string :as str]
            [mithril.app :as app]
            [mithril.compiler :as compiler]
            [mithril.execution :as execution]
            [oak.semantic :as oak]))

(defn read-text [path] (.readFileSync (js/require "fs") path "utf8"))
(defn fixture []
  (let [library (compiler/compile-library-text "lib/app/agent-loop-v1.mith" (read-text "lib/app/agent-loop-v1.mith"))
        source (compiler/parse-json (read-text "examples/mithril-app-agent.mith"))]
    {:library library :source source}))
(defn error-code [f] (try (f) nil (catch :default e (:mithril/error (ex-data e)))))

(deftest app-agent-compiles-to-bounded-run
  (let [{:keys [library source]} (fixture)
        artifact (app/compile-document "examples/mithril-app-agent.mith" source [library])
        run (app/prepare-run artifact)]
    (is (= app/app-format (:format artifact)))
    (is (= 6 (count (:steps run))))
    (is (= 6 (get-in run [:budget :max-steps])))
    (is (= #{:reasoner :query :validator :compiler :tester :deployer :governor}
           (set (keys (get-in artifact [:app-ir :operations])))))
    (is (= [:render/static-document :deploy/self-contained-url] (:effects run)))))

(deftest app-agent-refuses-open-ended-programs
  (let [{:keys [library source]} (fixture)]
    (testing "unknown template"
      (is (= :mithril/unknown-template
             (error-code #(app/compile-document "x.mith" (assoc-in source ["app" "template"] "https://example.com/free") [library])))))
    (testing "unbounded loop"
      (is (= :mithril/invalid-budget
             (error-code #(app/compile-document "x.mith" (assoc-in source ["loop" "maxSteps"] 99) [library])))))
    (testing "unknown effect"
      (is (= :mithril/unexported-operation
             (error-code #(app/compile-document "x.mith" (assoc-in source ["loop" "deployer"] "https://example.com/deploy") [library])))))))

(deftest semantic-run-executes-reasoning-query-and-validation
  (let [{:keys [library source]} (fixture)
        artifact (app/compile-document "examples/mithril-app-agent.mith" source [library])
        run (execution/execute artifact)
        [infer query validate] (:receipts run)]
    (is (= :executed (:status run)))
    (is (pos? (get-in infer [:metrics :derived-triples]))
        "the OWL step must add an entailed application type")
    (is (= 1 (get-in query [:metrics :rows]))
        "SPARQL must read the entailed type and asserted template")
    (is (zero? (get-in validate [:metrics :violations])))
    (is (= (:output-digest infer)
           (execution/digest
            (oak/materialize
             :owl2-rl
             #{(oak/triple :mithril/DashboardApplication :rdfs/subClassOf :mithril/Application)
               (oak/triple
                (keyword "mithril.instance" (subs (:graph-digest artifact) 7 19))
                :rdf/type :mithril/DashboardApplication)
               (oak/triple
                (keyword "mithril.instance" (subs (:graph-digest artifact) 7 19))
                :mithril/template "https://mithril.fund/id/template/dashboard")
               (oak/triple
                (keyword "mithril.instance" (subs (:graph-digest artifact) 7 19))
                :mithril/dataShape "https://mithril.fund/id/shape/metric-cards")})))
        "receipt output digest is computed from the actual entailed graph")
    (is (not= (:input-digest infer) (:output-digest infer)))))

(deftest semantic-run-refuses-the-named-shacl-violation
  (let [{:keys [library source]} (fixture)
        artifact (app/compile-document "examples/mithril-app-agent.mith" source [library])
        broken (assoc-in artifact [:app-ir :app :headline] 7)]
    (try
      (execution/execute broken)
      (is false "expected SHACL refusal")
      (catch :default error
        (is (= :mithril.execution/shacl-violation (:mithril/error (ex-data error))))
        (is (= [{:code :shacl/datatype :path :headline :expected :string}]
               (get-in (ex-data error) [:report :errors])))))))

(deftest bounded-report-rows-retain-source-order-and-semantic-validation
  (let [{:keys [library source]} (fixture)
        report (-> source
                   (assoc-in ["app" "template"] "https://mithril.fund/id/template/report")
                   (assoc-in ["app" "dataShape"] "https://mithril.fund/id/shape/claim-list")
                   (assoc-in ["app" "reportRows"] ["Inheritance" "Validation" "Refactor"]))
        artifact (app/compile-document "report.mith" report [library])]
    (is (= ["Inheritance" "Validation" "Refactor"] (get-in artifact [:app-ir :app :report-rows])))
    (is (= :executed (:status (execution/execute artifact))))
    (is (not= (:graph-digest artifact)
              (:graph-digest (app/compile-document "report.mith" (assoc-in report ["app" "reportRows"] ["Refactor" "Validation" "Inheritance"]) [library]))))
    (doseq [rows [[] [""] [7] (vec (repeat 21 "row")) [(apply str (repeat 201 "x"))]]]
      (is (some? (error-code #(app/compile-document "report.mith" (assoc-in report ["app" "reportRows"] rows) [library])))))
    (is (= :mithril/invalid-report-rows
           (error-code #(app/compile-document "report.mith" (assoc-in source ["app" "reportRows"] ["row"]) [library]))))))

(deftest report-rows-parse-from-mithril-form
  (let [{:keys [library]} (fixture)
        text (-> (read-text "examples/mithril-app-agent-form.mith")
                 (str/replace "template/dashboard" "template/report")
                 (str/replace "shape/metric-cards" "shape/claim-list")
                 (str/replace ":data-shape" ":report-rows [\"Inheritance\" \"Validation\" \"Refactor\"]\n    :data-shape"))
        artifact (app/compile-text "report.mith" text [library])]
    (is (= ["Inheritance" "Validation" "Refactor"] (get-in artifact [:app-ir :app :report-rows])))
    (is (= :executed (:status (execution/execute artifact))))))
