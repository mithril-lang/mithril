(ns mithril.native-reflect-test
 (:require [cljs.test :refer [deftest is]] [mithril.native-js :as native] [mithril.form :as form]
           [mithril.native-class-test :as c]
           ["node:fs" :as fs] ["node:os" :as os] ["node:path" :as path] ["node:child_process" :as child]))
(defn assignment [operator]
 {"@type" "HostLogicalAssign" "operator" operator "object" (c/call (c/grant "object"))
  "key" (c/call (c/grant "key")) "value" (c/call (c/grant "value"))})
(deftest native-property-logical-assignment
 (let [base (assignment "??=")
       bad [(assoc base "operator" "+=") (assoc base "operator" nil) (assoc base "source" "raw JS")
            (dissoc base "object") (assoc base "key" (c/local "missing"))
            (assoc base "value" (c/local "missing"))]
       dir (fs/mkdtempSync (path/join (os/tmpdir) "mithril-logical-assign-"))]
  (is (= (form/parse "(mithril/host-logical-assign :operator \"??=\" :object (mithril/host-invoke :function (mithril/host-import :name \"object\") :args []) :key (mithril/host-invoke :function (mithril/host-import :name \"key\") :args []) :value (mithril/host-invoke :function (mithril/host-import :name \"value\") :args []))") base))
  (is (every? (fn [x] (try (native/check-document (c/document x ["object" "key" "value"])) false (catch :default _ true))) bad))
  (try
   (fs/writeFileSync (path/join dir "artifacts.json") (js/JSON.stringify (clj->js (into {} (for [operator ["??=" "||=" "&&="]] [operator (c/source (c/normal (assignment operator)) ["object" "key" "value"])])))))
   (let [r (child/spawnSync js/process.execPath (clj->js ["test/fixtures/native-logical-assign-contract.mjs" dir]) #js {:encoding "utf8" :timeout 30000})]
    (is (= 0 (.-status r)) (str (.-stdout r) (.-stderr r))) (print (.-stdout r)))
   (finally (fs/rmSync dir #js {:recursive true :force true})))))
(deftest complete-cordis-reflect-source
 (let [text (fs/readFileSync "examples/native-js-cordis-reflect.mith" "utf8") checked (native/check-text text)
       dir (fs/mkdtempSync (path/join (os/tmpdir) "mithril-whole-reflect-"))]
  (is (= (native/compile-text text) (native/compile-document (form/parse text))))
  (is (= ["ReflectService"] (mapv :name (:exports checked))))
  (try
   (let [engine (.-MITHRIL_NATIVE_ENGINE js/process.env) config (path/join dir "offline.edn")]
    (fs/writeFileSync config "{:paths [\"src\"]}\n")
    (doseq [target ["js" "js-browser"] [cli input prefix] [["bin/mithril-native-js.cljk" "examples/native-js-cordis-reflect.mith" "reflect"] ["bin/mithril-native-js.cljk" "examples/native-js-cordis-utils.mith" "utils"] ["bin/mithril-native-package.cljk" "examples/native-js-cosmokit.mith" "cosmokit"]]]
     (let [r (child/spawnSync js/process.execPath (clj->js [engine "--config" config "-cp" "src" cli input "--target" target "--output" (path/join dir (str prefix "-" target ".mjs"))]) #js {:encoding "utf8" :timeout 30000})]
      (when-not (= 0 (.-status r)) (throw (js/Error. (str (.-stdout r) (.-stderr r))))))))
   (let [r (child/spawnSync js/process.execPath (clj->js ["test/fixtures/native-reflect-contract.mjs" dir]) #js {:encoding "utf8" :timeout 30000})]
    (is (= 0 (.-status r)) (str (.-stdout r) (.-stderr r))) (print (.-stdout r)))
   (finally (fs/rmSync dir #js {:recursive true :force true})))))
