# workspace-spend-v1 POSITIVE example. Validated together with the
# workspace-ops-v1 shapes: `mithril reason` must exit 0 (CONFORMS).
# One full spend chain (SupplierAccount -> Agreement -> Commitment /
# Renewal; UsageRecord -> CostLine -> Allocation; Invoice -> Payment),
# detection + proposed remediation, a portfolio item of each usable
# kind, and CsfLabels referencing all six canonical NIST CSF v2 functions
# and all three subject types without optional taxonomy metadata.
# Labels use containing named-graph scope, not ops:workspace assertions;
# the remaining entity workspace links are unchanged. References use
# canonical function IRIs or opaque example.org IRIs.
# Fictitious data only: no secrets, instrument values, contract text
# or PII.
<https://example.org/wspend/ws> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://mithril.fund/ns/workspace-ops/v1#Workspace> .
<https://example.org/wspend/ws> <https://mithril.fund/ns/workspace-ops/v1#workspaceId> "wspend-example" .
<https://example.org/wspend/ws> <https://mithril.fund/ns/workspace-ops/v1#workspaceKind> "organization" .
<https://example.org/wspend/ws> <https://mithril.fund/ns/workspace-ops/v1#billingAccountRef> "billing-ref-example-0001" .
<https://example.org/wspend/party> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://mithril.fund/ns/workspace-ops/v1#Party> .
<https://example.org/wspend/party> <https://mithril.fund/ns/workspace-ops/v1#name> "Example Vendor Ltd" .
<https://example.org/wspend/party> <https://mithril.fund/ns/workspace-ops/v1#partyKind> "organization" .
<https://example.org/wspend/party> <https://mithril.fund/ns/workspace-ops/v1#workspace> <https://example.org/wspend/ws> .
<https://example.org/wspend/agr> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://mithril.fund/ns/workspace-ops/v1#Agreement> .
<https://example.org/wspend/agr> <https://mithril.fund/ns/workspace-ops/v1#name> "Example vendor agreement" .
<https://example.org/wspend/agr> <https://mithril.fund/ns/workspace-ops/v1#workspace> <https://example.org/wspend/ws> .
<https://example.org/wspend/obl> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://mithril.fund/ns/workspace-ops/v1#Obligation> .
<https://example.org/wspend/obl> <https://mithril.fund/ns/workspace-ops/v1#name> "Uptime commitment" .
