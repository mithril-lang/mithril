(ns compile-declarations
 (:require [clojure.walk :as walk] [mithril.form :as form] [mithril.native-package :as package]
           [mithril.native-declarations :as declarations] [mithril.native-declaration-emit :as emit]
           [mithril.module :as guest] [mithril.native-esm :as esm] ["node:fs" :as fs] ["node:child_process" :as child]))
(defn ensure [p label] (when-not p (throw (js/Error. label))))
(defn refused [f label] (ensure (try (f) false (catch :default _ true)) label))
(def text (fs/readFileSync "examples/native-js-cosmokit.mith" "utf8"))
(def runtime-doc (form/parse text))
(def sources (into {} (map #(vector (get % "source") (fs/readFileSync (str "examples/" (get % "source")) "utf8")) (get runtime-doc "modules"))))
(def runtime (package/check-text text sources))
(defn source-form [value]
 (cond
  (map? value) (let [esm? (contains? #{"NativeJsEsmPackage" "NativeJsDeclarations"} (get value "@type"))
                     fields (if esm? (dissoc value "@context" "@type") (dissoc value "@context"))]
                 (str (case (get value "@type") "NativeJsEsmPackage" "(mithril/native-js-esm-package " "NativeJsDeclarations" "(mithril/native-js-declarations " "(rdf/node ")
                      (apply str (map (fn [[k v]] (str ":" (case k "@type" "type" k) " " (source-form v) " ")) fields)) ")"))
  (vector? value) (str "[" (apply str (interpose " " (map source-form value))) "]")
  :else (pr-str value)))
(def esm-text (fs/readFileSync "examples/native-js-cosmokit-esm.mith" "utf8"))
(def esm-doc (form/parse esm-text))
(def esm-sources (into {} (map #(vector % (fs/readFileSync (str "examples/" %) "utf8")) (esm/source-basenames esm-text))))
(def esm-runtime (esm/check-text esm-text esm-sources))
(def declaration-text (fs/readFileSync "examples/native-js-cosmokit-declarations.mith" "utf8"))
(def doc (declarations/parse-text declaration-text))
(def artifact (emit/compile-document doc runtime))
(ensure (= 40 (count (:exports artifact))) "Wrong runtime export count")
(ensure (= #{"Dict" "Get" "Extract" "MaybeArray" "Promisify" "Awaitable" "Intersect" "camelize" "hyphenate" "VolatileSnapshot" "Volatile"} (set (:type-exports artifact))) "Wrong type export bindings")
(ensure (= "native-js-cosmokit.mith" (declarations/runtime-basename declaration-text)) "Wrong runtime read plan")
(ensure (= artifact (emit/compile-text declaration-text runtime)) "Non-deterministic declarations")
(refused #(guest/check-text declaration-text) "Guest admitted declaration context")
(def esm-declaration-text (fs/readFileSync "examples/native-js-cosmokit-esm-declarations.mith" "utf8"))
(def esm-declaration-doc (declarations/parse-text esm-declaration-text))
(def esm-artifact (emit/compile-text esm-declaration-text esm-runtime))
(ensure (= (assoc artifact :runtime-source "native-js-cosmokit-esm.mith") esm-artifact) "Native ESM declaration artifact differs from full checked legacy types")
(ensure (= (assoc doc "runtime-source" "native-js-cosmokit-esm.mith") esm-declaration-doc) "Native ESM declaration AST differs from original complete types")
(doseq [bad-runtime [(assoc esm-runtime :format :unchecked) (assoc esm-runtime :name "wrong") (update esm-runtime :exports pop)]]
 (refused #(emit/compile-document esm-declaration-doc bad-runtime) "Native ESM mismatched runtime admitted"))
(def kw {"op" "keyword" "name" "string"})
(def raw {"op" "raw" "source" "globalThis.attack()"})
(defn alias [name datatype] {"kind" "alias" "name" name "exported" false "type-params" [] "datatype" datatype})
(defn with-type [datatype] (update doc "declarations" conj (alias "PrivateControl" datatype)))
(doseq [bad [(assoc doc "unknown" true) (assoc doc "@context" "wrong") (assoc doc "name" "wrong")
             (assoc doc "runtime-source" "../secret.mith")
             (update-in doc ["ambient-types" 0] assoc "min" -1)
             (update doc "ambient-types" conj (first (get doc "ambient-types")))
             (update doc "ambient-values" conj "globalThis")
             (update-in doc ["declarations" 0] assoc "body" "arbitrary JS")
             (update-in doc ["declarations" 0] assoc "name" "x; injected")
             (update-in doc ["declarations" 0] assoc "exported" false)
             (update doc "declarations" conj (first (filter #(= "alias" (get % "kind")) (get doc "declarations"))))
             (with-type raw) (with-type (assoc kw "source" "arbitrary TS"))
             (with-type {"op" "name" "name" "Missing" "args" []})
             (with-type {"op" "name" "name" "Promise" "args" []})
             (with-type {"op" "name" "name" "Letter.LowerToUpper" "args" []})
             (with-type {"op" "typeof" "name" "Missing"})
             (with-type {"op" "typeof" "name" "Letter"})
             (with-type {"op" "infer" "name" "X" "constraint" nil})
             (with-type {"op" "conditional" "test" kw "extends" {"op" "infer" "name" "X" "constraint" nil} "then" kw "else" {"op" "name" "name" "X" "args" []}})
             (with-type {"op" "mapped" "name" "K" "keys" {"op" "name" "name" "K" "args" []} "remap" nil "readonly" false "optional" false "value" kw})
             (with-type {"op" "predicate" "name" "value" "datatype" kw})
             (with-type {"op" "readonly" "datatype" kw})
             (with-type {"op" "literal" "value" js/NaN})
             (with-type (nth (iterate #(hash-map "op" "array" "item" %) kw) 65))]]
 (refused #(emit/compile-document bad runtime) "Invalid declaration AST admitted"))
(def invalid-signature (get-in doc ["declarations" 0]))
(doseq [bad [(assoc-in invalid-signature ["params" 0 "optional"] true)
             (assoc-in invalid-signature ["params" 0 "rest"] true)
             (assoc-in invalid-signature ["params" 0 "name"] "return")
             (assoc invalid-signature "returns" {"op" "predicate" "name" "missing" "datatype" kw})]]
 (refused #(emit/compile-document (assoc-in doc ["declarations" 0] bad) runtime) "Invalid signature admitted"))
(def default-bad (assoc (alias "PrivateControl" kw) "type-params" [{"name" "A" "constraint" nil "default" {"op" "name" "name" "B" "args" []}} {"name" "B" "constraint" nil "default" kw}]))
(refused #(emit/compile-document (update doc "declarations" conj default-bad) runtime) "Future default generic admitted")
(def nodes (atom 0))
(walk/postwalk #(do (when (and (map? %) (contains? % "op")) (swap! nodes inc)) %) doc)
(ensure (> @nodes 400) "Full original declaration AST missing")
(def engine (.-MITHRIL_DECLARATIONS_ENGINE js/process.env))
(def compiler (.-MITHRIL_DECLARATIONS_TYPESCRIPT js/process.env))
(def type-roots (.-MITHRIL_DECLARATIONS_TYPE_ROOTS js/process.env))
(ensure (and engine compiler type-roots) "Pinned declaration toolchains required")
(defn run [args]
 (let [r (child/spawnSync js/process.execPath (clj->js args) #js {:encoding "utf8" :timeout 240000})]
  (ensure (= 0 (.-status r)) (str (.-stdout r) (.-stderr r))) (print (.-stdout r))))
(run ["test/qualification/native-js-declarations/controls/cordis-type-contract.mjs" compiler type-roots])
(def toy-leaf "(mithril/native-js-module :name \"toy\" :imports [] :functions [(mithril/function :name \"echo\" :params [(rdf/node :name \"value\" :datatype \"js-value\")] :returns \"js-value\" :body (mithril/local :name \"value\"))] :exports [\"echo\"])" )
(def toy-runtime (package/check-text "(mithril/native-js-package :name \"toy\" :imports [] :modules [(rdf/node :name \"toy\" :source \"toy.mith\" :links [])] :reexports [\"toy\"])" {"toy.mith" toy-leaf}))
(def toy-declarations [{"kind" "function" "name" "echo" "exported" true "type-params" [{"name" "T" "constraint" nil "default" kw}]
 "params" [{"name" "value" "optional" false "rest" false "datatype" {"op" "name" "name" "T" "args" []}}] "returns" {"op" "name" "name" "T" "args" []}}
 {"kind" "alias" "name" "Item" "exported" true "type-params" [{"name" "T" "constraint" nil "default" nil}]
 "datatype" {"op" "conditional" "test" {"op" "name" "name" "T" "args" []} "extends" {"op" "array" "item" {"op" "infer" "name" "U" "constraint" nil}} "then" {"op" "name" "name" "U" "args" []} "else" kw}}
 {"kind" "namespace" "name" "Scope" "exported" false "declarations" [(alias "Hidden" {"op" "literal" "value" "private"}) {"kind" "namespace" "name" "Child" "exported" true "declarations" [(assoc (alias "Visible" {"op" "name" "name" "Hidden" "args" []}) "exported" true)]}]}
 (assoc (alias "Visible" {"op" "name" "name" "Scope.Child.Visible" "args" []}) "exported" true)])
(def toy-doc (assoc doc "name" "toy" "runtime-source" "toy-package.mith" "ambient-types" [] "ambient-values" [] "declarations" toy-declarations))
(def named-item {"op" "named-tuple-item" "name" "config" "optional" false "datatype" {"op" "name" "name" "T" "args" []}})
(def spread {"op" "conditional" "test" {"op" "keyword" "name" "undefined"} "extends" {"op" "name" "name" "T" "args" []}
             "then" {"op" "tuple" "items" [(assoc named-item "optional" true)]} "else" {"op" "tuple" "items" [named-item]}})
(def named-doc (assoc toy-doc "runtime-source" "toy-package.mith" "declarations"
 [{"kind" "alias" "name" "Spread" "exported" false "type-params" [{"name" "T" "constraint" nil "default" nil}] "datatype" spread}
  {"kind" "function" "name" "echo" "exported" true "type-params" [{"name" "T" "constraint" nil "default" nil}]
   "params" [{"name" "args" "optional" false "rest" true "datatype" {"op" "name" "name" "Spread" "args" [{"op" "name" "name" "T" "args" []}]}}]
   "returns" {"op" "name" "name" "T" "args" []}}]))
(def named-text (source-form named-doc))
(ensure (= named-doc (declarations/parse-text named-text)) "Named tuple source roundtrip differs")
(def named-artifact (emit/compile-text named-text toy-runtime))
(doseq [bad [(assoc named-item "source" "raw TS") (assoc named-item "name" "x]; injected")
             (assoc named-item "optional" "true") (assoc named-item "datatype" {"op" "name" "name" "Missing" "args" []})]]
 (refused #(emit/compile-document (assoc-in named-doc ["declarations" 0 "datatype" "then" "items" 0] bad) toy-runtime) "Bad named tuple item admitted"))
(refused #(emit/compile-document (assoc-in named-doc ["declarations" 0 "datatype" "then"] named-item) toy-runtime) "Named tuple item outside tuple admitted")
(doseq [items [[(assoc named-item "optional" true) named-item] [(assoc named-item "optional" true) kw]
              (vec (repeat 129 named-item))]]
 (refused #(emit/compile-document (assoc-in named-doc ["declarations" 0 "datatype" "then" "items"] items) toy-runtime) "Bad tuple order/budget admitted"))
(refused #(emit/compile-document (assoc-in named-doc ["declarations" 0 "datatype" "then"]
           (nth (iterate (fn [t] {"op" "tuple" "items" [(assoc named-item "datatype" t)]}) kw) 33)) toy-runtime)
         "Named tuple wrappers did not charge depth")
(println "Named tuple admission:9 shape/scope/order/collection/depth refusals; no standalone named-item or source delegation.")
(def toy-artifact (emit/compile-document toy-doc toy-runtime))
(ensure (= ["echo"] (:exports toy-artifact)) "Generic runtime declaration shape changed")
(def dir (fs/mkdtempSync "/tmp/mithril-declarations-control-"))
(try
 (fs/writeFileSync (str dir "/generic.d.mts") (:source toy-artifact))
 (fs/writeFileSync (str dir "/offline.edn") "{:paths [\"src\"]}\n")
 (run [engine "--config" (str dir "/offline.edn") "-cp" "src" "test/qualification/native-class-declarations/controls/compile.cljk"])
 (run [engine "--config" (str dir "/offline.edn") "-cp" "src" "test/qualification/native-interface-signatures/controls/compile.cljk"])
 (run [engine "--config" (str dir "/offline.edn") "-cp" "src" "test/qualification/native-declaration-merging/controls/compile.cljk"])
 (run [engine "--config" (str dir "/offline.edn") "-cp" "src" "test/qualification/native-declaration-program/controls/compile.cljk"])
 (run [engine "--config" (str dir "/offline.edn") "-cp" "src" "test/qualification/native-module-augmentation/controls/compile.cljk"])
 (run [engine "--config" (str dir "/offline.edn") "-cp" "src" "test/qualification/native-erased-enums/controls/compile.cljk"])
 (doseq [target ["js" "js-browser"]]
  (let [output (str dir "/" target ".d.mts") library (str dir "/" target ".mjs") config (str dir "/offline.edn")]
   (run [engine "--config" config "-cp" "src" "bin/mithril-native-package.cljk" "examples/native-js-cosmokit.mith" "--target" target "--output" library])
   (run [engine "--config" config "-cp" "src" "bin/mithril-native-declarations.cljk" "examples/native-js-cosmokit-declarations.mith" "--target" target "--output" output])
   (ensure (= (:source artifact) (fs/readFileSync output "utf8")) "CLI differed from checked declaration artifact")
   (run ["test/qualification/native-js-declarations/controls/type-contract.mjs" "test/fixtures/cosmokit-declarations/index.d.ts" output compiler type-roots (str dir "/generic.d.mts")])
   (run ["--experimental-vm-modules" "test/fixtures/cosmokit-package/contract.mjs" "test/fixtures/cosmokit-package/index.js" library])
   (let [folder (str dir "/esm-" target) output (str folder "/index.d.mts")]
    (run [engine "--config" config "-cp" "src" "bin/mithril-native-esm.cljk" "examples/native-js-cosmokit-esm.mith" "--target" target "--output-directory" folder])
    (run [engine "--config" config "-cp" "src" "bin/mithril-native-declarations.cljk" "examples/native-js-cosmokit-esm-declarations.mith" "--target" target "--output" output])
    (ensure (= (:source artifact) (fs/readFileSync output "utf8")) "Actual ESM declaration CLI differs from complete legacy types")
    (run ["test/qualification/native-js-declarations/controls/type-contract.mjs" "test/fixtures/cosmokit-declarations/index.d.ts" output compiler type-roots (str dir "/generic.d.mts")])
    (run ["--experimental-vm-modules" "test/fixtures/cosmokit-package/contract.mjs" "test/fixtures/cosmokit-package/index.js" (str folder "/index.mjs") "--native-esm"]))))
 (let [fixture (str dir "/named-tuple") config (str dir "/offline.edn")
       old-runtime "(mithril/native-js-package :name \"toy\" :imports [] :modules [(rdf/node :name \"toy\" :source \"toy.mith\" :links [])] :reexports [\"toy\"])"
       new-runtime "(mithril/native-js-esm-package :name \"toy\" :imports [] :modules [(rdf/node :name \"toy\" :source \"toy.mith\" :links [] :dependencies [])] :reexports [\"toy\"])" ]
  (fs/mkdirSync fixture)
  (fs/writeFileSync (str fixture "/toy.mith") toy-leaf)
  (fs/writeFileSync (str fixture "/types.mith") named-text)
  (doseq [[profile runtime-text] [["old" old-runtime] ["esm" new-runtime]] target ["js" "js-browser"]]
   (fs/writeFileSync (str fixture "/toy-package.mith") runtime-text)
   (let [output (str dir "/named-" profile "-" target ".d.mts")]
    (run [engine "--config" config "-cp" "src" "bin/mithril-native-declarations.cljk" (str fixture "/types.mith") "--target" target "--output" output])
    (ensure (= (:source named-artifact) (fs/readFileSync output "utf8")) "Named tuple CLI bytes differ")
    (run ["test/qualification/native-js-declarations/controls/named-tuple-contract.mjs" output compiler type-roots]))))
 (let [sentinel (str dir "/sentinel.d.mts") config (str dir "/offline.edn")]
  (fs/writeFileSync sentinel "preserve-existing-declarations")
  (doseq [target ["amu" "js"]]
   (let [r (child/spawnSync js/process.execPath (clj->js [engine "--config" config "-cp" "src" "bin/mithril-native-declarations.cljk" "missing.mith" "--target" target "--output" sentinel]) #js {:encoding "utf8" :timeout 60000})]
    (ensure (= 65 (.-status r)) "Invalid declaration CLI input did not refuse")
    (ensure (= "preserve-existing-declarations" (fs/readFileSync sentinel "utf8")) "Refusal overwrote declaration output"))))
 (let [fixture (str dir "/esm-refusals") config (str dir "/offline.edn") sentinel (str dir "/esm-refusal.d.mts")]
  (fs/mkdirSync fixture)
  (doseq [[name text] esm-sources] (fs/writeFileSync (str fixture "/" name) text))
  (fs/writeFileSync (str fixture "/native-js-cosmokit-esm.mith") esm-text)
  (fs/writeFileSync (str fixture "/types.mith") esm-declaration-text)
  (fs/writeFileSync sentinel "preserve-existing-esm-types")
  (let [reject! (fn [target code]
                 (let [r (child/spawnSync js/process.execPath (clj->js [engine "--config" config "-cp" "src" "bin/mithril-native-declarations.cljk" (str fixture "/types.mith") "--target" target "--output" sentinel]) #js {:encoding "utf8" :timeout 60000})]
                  (ensure (= 65 (.-status r)) "Invalid native ESM declaration CLI input admitted")
                  (ensure (re-find (re-pattern (str "REFUSE\t" code "\t")) (.-stderr r)) (str "Wrong native ESM refusal: " (.-stderr r)))
                  (ensure (= "preserve-existing-esm-types" (fs/readFileSync sentinel "utf8")) "Native ESM refusal overwrote output")))]
   (reject! "amu" "native-declarations-target")
   (doseq [[bad code] [[(assoc esm-doc "name" "wrong") "runtime"] [(assoc esm-doc "extra" "raw JS") "source"]
                      [(assoc-in esm-doc ["modules" 0 "source"] "../outside.mith") "source"]
                      [(update esm-doc "modules" conj (first (get esm-doc "modules"))) "source"]
                      [(assoc esm-doc "@type" "UnknownRuntime") "runtime"]]]
    (ensure (= (if (= "NativeJsEsmPackage" (get bad "@type")) bad (dissoc bad "@context")) (form/parse (source-form bad))) "Invalid runtime fixture did not roundtrip as actual inert Mithril data")
    (fs/writeFileSync (str fixture "/native-js-cosmokit-esm.mith") (source-form bad))
    (reject! "js" code))
   (fs/writeFileSync (str fixture "/native-js-cosmokit-esm.mith") esm-text)
   (let [leaf (first (keys esm-sources)) file (str fixture "/" leaf)]
    (fs/unlinkSync file) (fs/symlinkSync "absent.mith" file) (reject! "js" "source")
    (fs/unlinkSync file) (fs/writeFileSync file (get esm-sources leaf)))
   (fs/unlinkSync (str fixture "/native-js-cosmokit-esm.mith"))
   (fs/symlinkSync "absent.mith" (str fixture "/native-js-cosmokit-esm.mith")) (reject! "js" "source")
   (println "Native ESM declarations: complete446type nodes/exact49publicnames/40values/11typebindings, old byte-identical types, actual two-profile/two-target runtime and strict type oracles;3runtime-identity/surface and8actualCLI refusals with output preservation.")))
 (println (str "Full declaration AST qualification: " @nodes " type nodes, scope/arity/shape/visibility/infer/budget refusals, both actual CLI targets and runtime/type consumer oracles; no source delegation."))
 (finally (fs/rmSync dir #js {:recursive true :force true})))
