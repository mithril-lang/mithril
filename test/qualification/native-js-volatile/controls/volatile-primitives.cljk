(ns volatile-primitives (:require [mithril.native-js :as n] [mithril.form :as form] ["node:fs" :as fs] ["node:child_process" :as child]))
(defn lit [v] {"@type" "Literal" "datatype" "js-value" "value" v})
(defn local [v] {"@type" "Local" "name" v})
(def undef {"@type" "HostUndefined"})
(defn seqe [& xs] {"@type" "Sequence" "expressions" (vec xs)})
(defn invoke [v args] {"@type" "HostInvoke" "function" v "args" args})
(defn assign [name value] {"@type" "LocalSet" "name" name "value" value})
(defn throwe [value] {"@type" "HostThrow" "value" value})
(defn finallye [body cleanup] {"@type" "HostTryFinally" "body" body "finally" cleanup})
(defn letvar [name value body] {"@type" "Let" "bindings" [{"name" name "value" value "mutable" true}] "body" body})
(defn fun [name params body] {"@type" "Function" "name" name "params" (mapv #(if (string? %) {"name" % "datatype" "js-value"} %) params) "returns" "js-value" "body" body})
(defn doc [body] {"@context" "https://mithril.fund/context/native-js-module/v1" "@type" "NativeJsModule" "name" "volatile.primitives" "imports" [] "functions" [(fun "probe" ["a" "b"] body)] "exports" ["probe"]})
(def recursive {"@type" "LocalFunction" "name" "visit" "params" ["item"] "body" {"@type" "If" "condition" (local "item") "then" (invoke (local "visit") [(lit false)]) "else" (local "a")} "result" (local "visit")})
(def positives [(letvar "state" (local "a") (assign "state" (local "b"))) (throwe (local "a")) (finallye (local "a") (local "b")) {"@type" "HostBinary" "operator" "in" "left" (local "a") "right" (local "b")} recursive])
(doseq [p positives] (n/compile-document (doc p)))
(n/compile-document (assoc (doc (local "shared")) "bindings" [{"name" "shared" "value" (lit 1)}]))
(n/compile-document (assoc (doc (local "a")) "functions" [(fun "probe" [{"name" "a" "datatype" "js-value" "default" (lit 7)}] (local "a"))]))
(def negatives [(assign "a" (lit 0)) (assign "missing" (lit 0)) (assoc (first positives) "bindings" [{"name" "state" "value" (lit 0) "mutable" "yes"}]) (assoc (second positives) "extra" true) (assoc (nth positives 2) "catch" (lit 0)) (assoc (nth positives 3) "operator" "in;evil") (assoc recursive "params" ["item" "item"]) (assoc recursive "body" (local "missing")) (local "visit") (assoc recursive "name" "return")])
(doseq [p negatives] (when-not (try (n/compile-document (doc p)) false (catch :default _ true)) (throw (js/Error. "Malformed volatile primitive admitted"))))
(doseq [d [(assoc (doc (lit 0)) "bindings" [{"name" "shared" "value" (local "shared")}]) (assoc (doc (lit 0)) "bindings" [{"name" "probe" "value" (lit 0)}]) (assoc (doc (lit 0)) "bindings" [{"name" "x" "value" (lit 0)} {"name" "x" "value" (lit 0)}]) (assoc (doc (lit 0)) "bindings" [{"name" "x" "value" (lit 0) "mutable" 1}]) (assoc (doc (lit 0)) "functions" [(fun "probe" [{"name" "a" "datatype" "js-value" "default" (local "missing")}] (local "a"))])]]
 (when-not (try (n/compile-document d) false (catch :default _ true)) (throw (js/Error. "Malformed native binding/default admitted"))))
(doseq [p [(reduce (fn [x _] (finallye x undef)) (lit 0) (range 65)) (letvar "x" (lit 0) {"@type" "HostArray" "items" (vec (repeat 4096 (lit 0)))})]]
 (when-not (= :mithril.native-js/budget (try (n/compile-document (doc p)) nil (catch :default e (:mithril/error (ex-data e))))) (throw (js/Error. "Shared source budget bypassed"))))
(doseq [[tag fields] [["local-set" ":name \"x\" :value (mithril/host-undefined)"] ["host-throw" ":value (mithril/host-undefined)"] ["host-try-finally" ":body (mithril/host-undefined) :finally (mithril/host-undefined)"] ["local-function" ":name \"visit\" :params [] :body (mithril/host-undefined) :result (mithril/local :name \"visit\")"]]]
 (let [parsed (form/parse (str "(mithril/" tag " " fields ")"))] (when-not (map? parsed) (throw (js/Error. "Missing Form tag")))))
(def functions [(fun "mutable" ["a"] (letvar "state" (local "a") {"@type" "HostObject" "entries" [{"key" (lit "get") "infer_name" true "value" {"@type" "NativeLambda" "params" [] "body" (local "state")}} {"key" (lit "set") "infer_name" true "value" {"@type" "NativeLambda" "params" ["value"] "body" (seqe (assign "state" (local "value")) undef)}}]}))
 (fun "throwValue" ["a"] (throwe (local "a"))) (fun "cleanup" ["body" "cleanup"] (finallye (invoke (local "body") []) (invoke (local "cleanup") [])))
 (fun "has" ["a" "b"] {"@type" "HostBinary" "operator" "in" "left" (local "a") "right" (local "b")})
 (fun "recursive" ["a"] recursive)
 (fun "defaults" ["factory" {"name" "value" "datatype" "js-value" "default" (invoke (local "factory") [])} "tail"] {"@type" "HostArray" "items" [(local "value") (local "tail")]})
 (fun "tdz" [{"name" "a" "datatype" "js-value" "default" (local "b")} "b"] (local "a"))
 (fun "moduleGet" [] (local "shared")) (fun "moduleSet" ["a"] (assign "shared" (local "a")))
 (fun "shadow" ["shared"] {"@type" "NativeLambda" "params" ["shared"] "body" (local "shared")})])
(let [artifact (n/compile-document (assoc (doc (lit 0)) "bindings" [{"name" "shared" "value" (lit 9) "mutable" true}] "functions" functions "exports" (mapv #(get % "name") functions)))]
 (fs/writeFileSync "/tmp/volatile-primitives.mjs" (:source artifact))
 (let [r (child/spawnSync js/process.execPath #js ["/opt/volatile-controls/volatile-primitives-runtime.mjs" "/tmp/volatile-primitives.mjs"] #js {:stdio "inherit" :timeout 30000})] (when-not (= 0 (.-status r)) (js/process.exit 1))))
(println "7 admissions / 15 malformed refusals / 2 budget refusals / 4 Form tags passed.")
