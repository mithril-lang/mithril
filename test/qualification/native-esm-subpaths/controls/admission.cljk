(ns multi-entry-controls (:require [mithril.native-esm :as esm] [mithril.form :as form] [mithril.native-declaration-program :as program] ["node:fs" :as fs]))
(defn ensure [p label] (when-not p (throw (js/Error. label))))
(defn data-form [v] (cond (map? v) (cons 'rdf/node (mapcat (fn [[k x]] [(keyword k) (data-form x)]) v)) (vector? v) (mapv data-form v) :else v))
(defn text [tag v] (pr-str (cons tag (mapcat (fn [[k x]] [(keyword k) (data-form x)]) v))))
(def shared (pr-str '(mithril/native-js-module :name "entry.shared" :imports [] :functions [(mithril/function :name "inc" :params [(rdf/node :name "n" :datatype "js-value")] :returns "js-value" :body (mithril/host-binary :operator "+" :left (mithril/local :name "n") :right (mithril/literal :datatype "js-value" :value 1)))] :exports [(rdf/node :name "inc" :function "inc")])))
(defn forward [name] (pr-str (list 'mithril/native-js-module :name name :imports ["inc"] :functions [] :exports [(list 'rdf/node :name "inc" :value (list 'mithril/host-import :name "inc"))])))
(def failure (pr-str '(mithril/native-js-module :name "entry.failure" :imports [] :functions [] :bindings [(rdf/node :name "fail" :mutable false :value (mithril/host-throw :value (mithril/literal :datatype "js-value" :value "subpath evaluated")))] :exports [])))
(def sources {"shared.mith" shared "root.mith" (forward "entry.root") "sub.mith" (forward "entry.sub") "failure.mith" failure})
(defn native [name source] {"name" name "source" source "dependencies" ["entry.shared"] "links" [{"import" "inc" "module" "entry.shared" "export" "inc"}]})
(def doc {"name" "entry.package" "imports" [] "modules" [(native "entry.root" "root.mith") (native "entry.sub" "sub.mith") {"name" "entry.shared" "source" "shared.mith" "dependencies" [] "links" []} {"name" "entry.failure" "source" "failure.mith" "dependencies" [] "links" []}] "reexports" ["entry.root"] "subpath-roots" ["entry.sub" "entry.failure"]})
(def manifest (text 'mithril/native-js-esm-entry-package doc))
(def result (esm/compile-text manifest sources))
(ensure (= :mithril.native-esm/artifact-v2 (:format result)) "Explicit v2 artifact")
(ensure (= ["inc"] (:exports result)) "Original root export surface retained")
(ensure (= #{"entry.sub" "entry.failure"} (set (keys (:subpath-files result)))) "Actual subpath routes")
(ensure (= (sort (keys sources)) (sort (esm/source-basenames manifest))) "Exact source plan")
(defn refuse [v code]
 (ensure (= code (try (esm/check-text (text 'mithril/native-js-esm-entry-package v) sources) :admitted (catch :default e (:mithril/error (ex-data e))))) "Exact entry root refusal"))
(refuse (assoc doc "subpath-roots" []) :mithril.native-package/shape)
(refuse (assoc doc "subpath-roots" ["entry.sub" "entry.sub"]) :mithril.native-package/duplicate)
(refuse (assoc doc "subpath-roots" ["unknown"]) :mithril.native-package/link)
(refuse (assoc doc "subpath-roots" ["entry.sub"]) :mithril.native-package/link)
(refuse (assoc doc "subpath-roots" ["../sub"]) :mithril.native-package/name)
(refuse (assoc doc "subpath-roots" (vec (repeat 65 "entry.sub"))) :mithril.native-package/budget)
(ensure (= :mithril.native-package/link (try (esm/check-text (text 'mithril/native-js-esm-package (dissoc doc "subpath-roots")) sources) :admitted (catch :default e (:mithril/error (ex-data e))))) "Unchanged v1 unreachable refusal")
(def dir (.-MITHRIL_SUBPATH_FIXTURES js/process.env))
(when-not dir (throw (js/Error. "Qualification fixture directory required")))
(doseq [[file bytes] (assoc sources "manifest.mith" manifest)] (fs/writeFileSync (str dir "/" file) bytes))
(fs/writeFileSync (str dir "/expected.json") (js/JSON.stringify (clj->js (dissoc result :files))))

(refuse (assoc doc "externals" [{"name" "node.fs" "specifier" "node:fs" "exports" []}] "subpath-roots" ["entry.sub" "entry.failure" "node.fs"]) :mithril.native-package/link)
(ensure (= :mithril.native-esm/source (try (esm/source-basenames (text 'mithril/native-js-esm-package doc)) :admitted (catch :default e (:mithril/error (ex-data e))))) "Version one cannot admit new fields")
(let [parsed (form/parse manifest)]
 (ensure (= :mithril.native-package/context (try (esm/check-document (assoc parsed "@context" "https://mithril.fund/context/native-js-esm-package/v1") sources) :admitted (catch :default e (:mithril/error (ex-data e))))) "Version context separation"))
(let [base (assoc doc "modules" [(native "entry.root" "root.mith") {"name" "entry.shared" "source" "shared.mith" "dependencies" [] "links" []}] "subpath-roots" ["entry.root"])
      owned (select-keys sources ["root.mith" "shared.mith"])
      old (esm/compile-text (text 'mithril/native-js-esm-package (dissoc base "subpath-roots")) owned)
      new (esm/compile-text (text 'mithril/native-js-esm-entry-package base) owned)]
 (ensure (= (:files old) (:files new)) "Unchanged actual v1 output bytes with a root publication alias"))
(fs/writeFileSync (str dir "/invalid-runtime.mith") (text 'mithril/native-js-esm-entry-package (assoc doc "subpath-roots" ["unknown"])))
(fs/writeFileSync (str dir "/old-extra-runtime.mith") (text 'mithril/native-js-esm-package doc))
(println "Independent ESM subpaths: original root surface, actual source routes, unchanged v1 artifacts and ten exact refusals.")

(def signature {"kind" "function" "name" "inc" "exported" true "type-params" [] "params" [{"name" "n" "datatype" {"op" "keyword" "name" "number"} "optional" false "rest" false}] "returns" {"op" "keyword" "name" "number"}})
(def documents (mapv (fn [name] {"name" name "runtime" name "ambient-types" [] "ambient-values" [] "imports" []
 "declarations" (if (= name "entry.shared") [signature] [])
 "reexports" (if (contains? #{"entry.root" "entry.sub"} name) [{"module" "entry.shared" "type-only" false "names" [{"import" "inc" "export" "inc"}]}] [])}) ["entry.root" "entry.shared" "entry.sub" "entry.failure"]))
(def type-sources (into {} (map-indexed (fn [i d] [(str "types-" i ".mith") (text 'mithril/native-js-declaration-module d)]) documents)))
(def type-plan (text 'mithril/native-js-declaration-program {"name" "entry.package" "runtime-source" "manifest.mith" "entry" "entry.root" "externals" [] "modules" (mapv (fn [i d] {"name" (get d "name") "source" (str "types-" i ".mith")}) (range) documents)}))
(def typed (program/compile-text type-plan type-sources (esm/check-text manifest sources)))
(ensure (= ["inc"] (:exports typed)) "Independent subpath declaration program root")
(doseq [[file bytes] (assoc type-sources "program.mith" type-plan)] (fs/writeFileSync (str dir "/" file) bytes))

(fs/writeFileSync (str dir "/single-types.mith") (text 'mithril/native-js-declarations {"name" "entry.package" "runtime-source" "manifest.mith" "ambient-types" [] "ambient-values" [] "declarations" [signature]}))
