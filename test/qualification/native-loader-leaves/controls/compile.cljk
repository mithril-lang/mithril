(ns compile-loader-leaves
 (:require [mithril.native-declaration-program :as program] [mithril.native-esm :as esm]
           ["node:fs" :as fs] ["node:os" :as os] ["node:child_process" :as child]))
(defn ensure [p text] (when-not p (throw (js/Error. text))))
(def engine (.-MITHRIL_DECLARATIONS_ENGINE js/process.env))
(def compiler (.-MITHRIL_DECLARATIONS_TYPESCRIPT js/process.env))
(def type-roots (.-MITHRIL_DECLARATIONS_TYPE_ROOTS js/process.env))
(defn run [args]
 (let [r (child/spawnSync js/process.execPath (clj->js args) #js {:encoding "utf8" :timeout 240000 :maxBuffer 4194304})]
  (ensure (= 0 (.-status r)) (str (.-stdout r) (.-stderr r)))
  (print (.-stdout r)) (.-stdout r)))
(defn example [name] (fs/readFileSync (str "examples/" name) "utf8"))
(def text (example "native-js-loader-leaves-program.mith"))
(def plan (program/read-plan text))
(def runtime-text (example (:runtime-source plan)))
(def runtime-sources (into {} (map #(vector % (example %)) (esm/source-basenames runtime-text))))
(def runtime (esm/check-text runtime-text runtime-sources))
(def sources (into {} (map #(vector % (example %)) (:sources plan))))
(def artifact (program/compile-text text sources runtime))
(ensure (= ["equalExceptVolatile" "evaluate" "interpolate" "isJsExpr"] (:exports artifact)) "Loader leaves runtime exports")
(ensure (= ["JsExpr"] (:type-exports artifact)) "Loader leaves full public type export")
(def dir (fs/mkdtempSync (str (os/tmpdir) "/mithril-loader-leaves-")))
(def config (str dir "/offline.edn"))
(fs/writeFileSync config (str "{:paths [" (js/JSON.stringify (fs/realpathSync "src")) "]}"))
(try
 (doseq [target ["js" "js-browser"]]
  (let [sdk (str dir "/" target) types (str sdk "-types") core (str dir "/" target "-core-types") schema (str dir "/" target "-schema") schema-types (str schema "-types")]
   (fs/writeFileSync (str sdk ".json") (run [engine "--config" config "-cp" "src" "bin/mithril-native-esm.cljk" "examples/native-js-loader-leaves-esm.mith" "--target" target "--output-directory" sdk]))
   (run [engine "--config" config "-cp" "src" "bin/mithril-native-declaration-program.cljk" "examples/native-js-loader-leaves-program.mith" "--target" target "--output-directory" types])
   (doseq [[file source] (:files artifact)]
    (ensure (= source (fs/readFileSync (str types "/" file) "utf8")) "Loader declaration CLI byte mismatch")
    (ensure (not (fs/existsSync (str sdk "/" file))) "Runtime/type file collision")
    (fs/copyFileSync (str types "/" file) (str sdk "/" file)))
   (fs/writeFileSync (str core ".json") (run [engine "--config" config "-cp" "src" "bin/mithril-native-declaration-program.cljk" "examples/native-js-cordis-complete-type-program.mith" "--target" target "--output-directory" core]))
   (run [engine "--config" config "-cp" "src" "bin/mithril-native-esm.cljk" "examples/native-js-schemastery-esm.mith" "--target" target "--output-directory" schema])
   (run [engine "--config" config "-cp" "src" "bin/mithril-native-declaration-program.cljk" "examples/native-js-schemastery-program.mith" "--target" target "--output-directory" schema-types])
   (doseq [file (.filter (fs/readdirSync schema-types) #(re-matches #"[A-Za-z0-9_-]+\.d\.mts" %))]
    (ensure (not (fs/existsSync (str schema "/" file))) "Schema runtime/type collision")
    (fs/copyFileSync (str schema-types "/" file) (str schema "/" file)))
   (run ["test/qualification/native-loader-leaves/controls/types.mjs" sdk core schema compiler type-roots])
   (run ["test/qualification/native-loader-leaves/controls/runtime.mjs" sdk schema compiler])))
 (println "Loader leaves qualification: complete utils/diff source with own CosmoKit, full original public declarations with actual Cordis and Schema type graphs, both actual CLI targets and paired source/runtime oracle.")
 (finally (fs/rmSync dir #js {:recursive true :force true})))
