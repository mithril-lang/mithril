  ],
  [
    "format template hint",
    "(()=>{const ev=[],k={toString(){ev.push('toString');return {[Symbol.toPrimitive](h){ev.push(h);return 'X'}}}};return [api.formatProperty(k),ev]})()"
  ],
  [
