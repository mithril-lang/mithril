    "(()=>{const s='XMLHttp-Foo_bar'.repeat(200);return [api.paramCase(s).length,api.snakeCase(s).length,api.paramCase(s).slice(0,45),api.snakeCase(s).slice(-45)]})()"
  ],
  [
    "format string keys",
    "['','foo','Foo','$x','_x','a0','0a','a-b','a.b','é','日本語','a\\n','a\"b','a\\\\b','a\\u2028b'].map(s=>api.formatProperty(s))"
  ],
  [
