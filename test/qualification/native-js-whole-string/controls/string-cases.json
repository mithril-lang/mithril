[
  [
    "exports",
    "Object.keys(api).sort()"
  ],
  [
    "function metadata",
    "Object.entries(api).map(([k,f])=>[k,f.name,f.length,Object.hasOwn(f,'prototype'),Object.getPrototypeOf(f)===Function.prototype])"
  ],
  [
    "alias identity",
    "(()=>{api.camelCase.marker={};return [api.camelize===api.camelCase,api.hyphenate===api.paramCase,api.camelize.marker===api.camelCase.marker,api.camelize.prototype===api.camelCase.prototype]})()"
  ],
  [
    "constructibility",
    "Object.entries(api).map(([k,f])=>{const x=new f('a');return [k,Object.getPrototypeOf(x)===f.prototype,x.constructor===f]})"
  ],
  [
    "capitalize ascii",
    "['','foo','FOO',' foo','1foo','\\nabc'].map(s=>api.capitalize(s))"
  ],
  [
    "uncapitalize ascii",
