(ns compile-values-sdk
  (:require [mithril.native-esm :as esm] [mithril.native-declarations :as declarations] [mithril.native-declaration-program :as program]
            ["node:fs" :as fs] ["node:os" :as os] ["node:child_process" :as child]))
(defn ensure [p message] (when-not p (throw (js/Error. message))))
(def engine (.-MITHRIL_DECLARATIONS_ENGINE js/process.env))
(def compiler (.-MITHRIL_DECLARATIONS_TYPESCRIPT js/process.env))
(def runtime-text (fs/readFileSync "examples/native-js-values-esm.mith" "utf8"))
(def runtime-sources (into {} (map #(vector % (fs/readFileSync (str "examples/" %) "utf8")) (esm/source-basenames runtime-text))))
(def runtime (esm/check-text runtime-text runtime-sources))
(def artifact (esm/compile-text runtime-text runtime-sources))
(def text (fs/readFileSync "examples/native-js-values-program.mith" "utf8"))
(def plan (program/read-plan text))
(def sources (into {} (map #(vector % (fs/readFileSync (str "examples/" %) "utf8")) (:sources plan))))
(def types (program/compile-text text sources runtime))
(ensure (= 2 (count (:module-files artifact))) "Complete original Values runtime")
(ensure (= 2 (count (:module-files types))) "Complete original Values declarations")
(ensure (= #{"assertNever" "snapshotJsonValue" "isJsonValue" "deepEqualJson" "deepFreeze" "WeakMapWithValues" "PartialArguments"} (set (:exports artifact)) (set (:exports types))) "Original public runtime values")
(ensure (= #{"JsonValue" "LengthReadOptions" "PartialArguments" "WeakMapWithValues"} (set (:type-exports types))) "Original public types")

(def marker-doc (declarations/parse-text (fs/readFileSync "examples/native-js-values-partial-json-complete-types.mith" "utf8")))
(def marker-path ["declarations" 1 "members" 0])
(def refusals (atom 0))
(defn refused [candidate expected]
 (let [actual (try (declarations/check-module-program [candidate (declarations/parse-text (get sources "native-js-values-index-complete-types.mith"))] [] runtime "values.index") nil
                   (catch :default error (:mithril/error (ex-data error))))]
  (ensure (= expected actual) (str "Exact private-brand refusal: " expected " received " actual)))
 (swap! refusals inc))
(doseq [field ["name" "key" "visibility" "static" "readonly" "optional" "datatype"]]
 (refused (assoc-in marker-doc (conj marker-path field) "injected") :mithril.native-declarations/shape))
(refused (update-in marker-doc ["declarations" 1 "members"] conj {"kind" "private-brand"}) :mithril.native-declarations/duplicate)
(println (str "Private declaration marker: " @refusals " exact-code extra-field/duplicate refusals; fixed #private syntax."))

(def dir (fs/mkdtempSync (str (os/tmpdir) "/mithril-values-sdk-")))
(def config (str dir "/offline.edn"))
(fs/writeFileSync config (str "{:paths [" (js/JSON.stringify (fs/realpathSync "src")) "]}"))
(defn run [args]
  (let [r (child/spawnSync js/process.execPath (clj->js args) #js {:encoding "utf8" :timeout 240000 :maxBuffer 4194304})]
    (ensure (= 0 (.-status r)) (str (.-stdout r) (.-stderr r))) (print (.-stdout r)) (.-stdout r)))
(try
  (doseq [target ["js" "js-browser"]]
    (let [output (str dir "/" target) typed (str output "-types")]
      (fs/writeFileSync (str output ".log")
        (run [engine "--config" config "-cp" "src" "bin/mithril-native-esm.cljk"
              "examples/native-js-values-esm.mith" "--target" target "--output-directory" output]))
      (doseq [[file bytes] (:files artifact)] (ensure (= bytes (fs/readFileSync (str output "/" file) "utf8")) "Exact Values runtime CLI bytes"))
      (fs/writeFileSync (str typed ".log")
        (run [engine "--config" config "-cp" "src" "bin/mithril-native-declaration-program.cljk"
              "examples/native-js-values-program.mith" "--target" target "--output-directory" typed]))
      (doseq [[file bytes] (:files types)] (ensure (= bytes (fs/readFileSync (str typed "/" file) "utf8")) "Exact Values declaration CLI bytes"))
      (run ["test/qualification/native-values-sdk/controls/check.mjs" compiler output typed (.-MITHRIL_DECLARATIONS_TYPE_ROOTS js/process.env)])))
  (finally (fs/rmSync dir #js {:recursive true :force true})))
