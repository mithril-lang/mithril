(ns compile-class-declarations
 (:require [clojure.string :as str] [mithril.form :as form] [mithril.native-declarations :as declarations]
           [mithril.native-declaration-emit :as emit] [mithril.native-esm :as esm]
           ["node:fs" :as fs] ["node:child_process" :as child]))
(defn ensure [p label] (when-not p (throw (js/Error. label))))
(defn refused [f label] (ensure (try (f) false (catch :default _ true)) label))
(defn run [args]
 (let [r (child/spawnSync js/process.execPath (clj->js args) #js {:encoding "utf8" :timeout 240000})]
  (ensure (= 0 (.-status r)) (str (.-stdout r) (.-stderr r))) (print (.-stdout r)) (.-stdout r)))
(def engine (.-MITHRIL_DECLARATIONS_ENGINE js/process.env))
(def compiler (.-MITHRIL_DECLARATIONS_TYPESCRIPT js/process.env))
(def type-roots (.-MITHRIL_DECLARATIONS_TYPE_ROOTS js/process.env))
(def root-text (fs/readFileSync "examples/native-js-cordis-service-utils-esm.mith" "utf8"))
(def sources (into {} (map #(vector % (fs/readFileSync (str "examples/" %) "utf8")) (esm/source-basenames root-text))))
(def runtime (esm/check-text root-text sources))
(def text (fs/readFileSync "examples/native-js-cordis-service-utils-declarations.mith" "utf8"))
(def doc (declarations/parse-text text))
(def artifact (emit/compile-text text runtime))
(ensure (= 12 (count (:exports artifact))) "Wrong complete Service/Utils runtime surface")
(ensure (= #{"Service" "DisposableList" "Tracker"} (set (:type-exports artifact))) "Wrong complete Service/Utils type surface")
(ensure (= artifact (emit/compile-document doc runtime)) "Class declaration source/model mismatch")
(defn kw [name] {"op" "keyword" "name" name})
(defn ref [name] {"op" "name" "name" name "args" []})
(def service (first (get doc "declarations")))
(defn replace-service [s] (assoc-in doc ["declarations" 0] s))
(def unique {"op" "unique-symbol"})
(def self {"op" "this"})
(defn alias [name t] {"kind" "alias" "name" name "exported" true "type-params" [] "datatype" t})
(defn method [name result]
 {"kind" "method" "key" {"kind" "name" "name" name} "visibility" "public" "static" false "abstract" false "optional" false "type-params" [] "params" [] "returns" result})
(defn klass [name members]
 {"kind" "class" "name" name "exported" false "abstract" false "type-params" [] "extends" nil "implements" [] "members" members})
(def control (klass "SelfClass" [(method "self" self)
                                  {"kind" "getter" "key" {"kind" "name" "name" "length"} "visibility" "public" "static" false "datatype" (kw "number")}
                                  {"kind" "opaque" "key" {"kind" "name" "name" "brand"} "visibility" "private" "static" false}]))
(def control-child (assoc (klass "SelfChild" []) "extends" (ref "SelfClass")))
(def protected-base (klass "ProtectedBase" [{"kind" "property" "key" {"kind" "name" "name" "token"} "visibility" "protected" "static" true "readonly" true "optional" false "datatype" unique}]))
(def protected-child (assoc (klass "ProtectedChild" [{"kind" "property" "key" {"kind" "name" "name" "copy"} "visibility" "public" "static" true "readonly" true "optional" false "datatype" {"op" "typeof" "name" "ProtectedBase.token"}}]) "extends" (ref "ProtectedBase")))
(def abstract-class (assoc (klass "AbstractClass" [(assoc (method "read" (kw "string")) "abstract" true)]) "abstract" true))
(def private-class (klass "PrivateClass" [{"kind" "constructor" "visibility" "private" "params" []}]))
(def protected-class (klass "ProtectedClass" [{"kind" "constructor" "visibility" "protected" "params" []}]))
(def overload-class (klass "Overloads" [(assoc (method "choose" (kw "string")) "params" [{"name" "value" "optional" false "rest" false "datatype" (kw "string")}])
                                      (assoc (method "choose" (kw "number")) "params" [{"name" "value" "optional" false "rest" false "datatype" (kw "number")}])]))
(defn generic-class [name variance members]
 (assoc (klass name members) "type-params" [{"name" "T" "constraint" nil "default" nil "variance" variance}]))
(def input-class (generic-class "InputClass" "in" [(assoc (method "accept" (kw "void")) "params" [{"name" "value" "optional" false "rest" false "datatype" (ref "T")}])]))
(def invariant-class (generic-class "InvariantClass" "in-out" [{"kind" "property" "key" {"kind" "name" "name" "value"} "visibility" "public" "static" false "readonly" false "optional" false "datatype" (ref "T")}]))
(defn generic-alias [name target]
 (assoc (alias name {"op" "name" "name" target "args" [(ref "T")]}) "type-params" [{"name" "T" "constraint" nil "default" nil}]))
(def interface-self {"kind" "interface" "name" "InterfaceSelf" "exported" false "type-params" [] "members" [{"kind" "property" "name" "root" "optional" false "readonly" true "datatype" self}]})
(def has-length {"kind" "interface" "name" "HasLength" "exported" false "type-params" [] "members" [{"kind" "property" "name" "length" "optional" false "readonly" true "datatype" (kw "number")}]})
(def implemented (assoc (klass "Implemented" []) "extends" (ref "SelfChild") "implements" [(ref "HasLength")]))
(def guard-class (klass "GuardClass" [(method "guard" {"op" "predicate" "name" "this" "datatype" {"op" "intersection" "items" [self {"op" "object" "members" [{"kind" "property" "name" "ready" "optional" false "readonly" true "datatype" {"op" "literal" "value" true}}]}]}})]))
(def control-doc (update doc "declarations" into
 [control control-child protected-base protected-child abstract-class private-class protected-class overload-class input-class invariant-class interface-self has-length implemented guard-class
  (alias "SelfClassType" (ref "SelfClass")) (alias "SelfChildType" (ref "SelfChild"))
  (alias "SelfConstructor" {"op" "typeof" "name" "SelfClass"})
  (alias "AbstractConstructor" {"op" "typeof" "name" "AbstractClass"})
  (alias "PrivateConstructor" {"op" "typeof" "name" "PrivateClass"})
  (alias "ProtectedConstructor" {"op" "typeof" "name" "ProtectedClass"})
  (alias "OverloadsType" (ref "Overloads"))
  (alias "ProtectedCopy" {"op" "typeof" "name" "ProtectedChild.copy"})
  (generic-alias "InputType" "InputClass") (generic-alias "InvariantType" "InvariantClass")
  (alias "InterfaceSelfType" (ref "InterfaceSelf")) (alias "ImplementedType" (ref "Implemented")) (alias "GuardType" (ref "GuardClass"))
  (assoc (klass "ServiceChild" []) "extends" (ref "Service")) (alias "InheritedConfig" {"op" "typeof" "name" "ServiceChild.config"})
  {"kind" "const" "name" "UniqueToken" "exported" false "datatype" unique} (alias "UniqueTokenType" {"op" "typeof" "name" "UniqueToken"})]))
(def control-artifact (emit/compile-document control-doc runtime))
(def refusals
 [(replace-service (assoc service "body" "raw TS"))
  (replace-service (assoc service "abstract" "true"))
  (replace-service (assoc-in service ["type-params" 0 "variance"] "sideways"))
  (replace-service (assoc-in service ["type-params" 0 "extra"] true))
  (replace-service (assoc service "extends" {"op" "raw" "source" "anything"}))
  (replace-service (assoc service "extends" (ref "Missing")))
  (replace-service (assoc service "extends" (ref "Tracker")))
  (replace-service (assoc service "extends" (ref "Service")))
  (replace-service (assoc service "implements" [(ref "Missing")]))
  (replace-service (assoc-in service ["members" 0 "visibility"] "internal"))
  (replace-service (assoc-in service ["members" 0 "static"] "yes"))
  (replace-service (assoc-in service ["members" 0 "key"] {"kind" "raw" "name" "raw JS"}))
  (replace-service (assoc-in service ["members" 1 "readonly"] false))
  (replace-service (assoc-in service ["members" 1 "static"] false))
  (replace-service (assoc-in service ["members" 1 "optional"] true))
  (replace-service (update service "members" conj (first (get service "members"))))
  (replace-service (update service "members" conj (assoc (method "bad" self) "static" true)))
  (replace-service (update service "members" conj (assoc (method "bad" (ref "T")) "static" true)))
  (replace-service (update service "members" conj (assoc (method "bad" (kw "void")) "abstract" true "static" true)))
  (replace-service (update service "members" conj (assoc (method "bad" (kw "void")) "abstract" true "visibility" "private")))
  (replace-service (assoc service "abstract" false "members" [(assoc (method "bad" (kw "void")) "abstract" true)]))
  (replace-service (update service "members" conj {"kind" "opaque" "key" {"kind" "name" "name" "untyped"} "visibility" "public" "static" false}))
  (replace-service (update service "members" conj (assoc (method "computed" (kw "void")) "key" {"kind" "computed" "name" "Missing.token"})))
  (replace-service (update service "members" conj (assoc (method "computed" (kw "void")) "key" {"kind" "computed" "name" "x]; injection"})))
  (replace-service (assoc service "members" (vec (repeat 257 (first (get service "members"))))))
  (replace-service (assoc-in service ["members" 0 "datatype"] (nth (iterate #(hash-map "op" "array" "item" %) (kw "number")) 65)))
  (update doc "declarations" conj (alias "BadSelf" self))
  (update doc "declarations" conj (alias "BadUnique" unique))
  (update doc "declarations" conj {"kind" "const" "name" "badUniqueArray" "exported" false "datatype" {"op" "array" "item" unique}})
  (update doc "declarations" conj {"kind" "const" "name" "badUniqueObject" "exported" false "datatype" {"op" "object" "members" [{"kind" "property" "name" "x" "optional" false "readonly" true "datatype" unique}]}})
  (update doc "declarations" into [(assoc control "name" "CycleA" "extends" (ref "CycleB")) (assoc control "name" "CycleB" "extends" (ref "CycleA"))])
  (update doc "declarations" into [protected-base (alias "PrivateQuery" {"op" "typeof" "name" "ProtectedBase.token"})])
  (update doc "declarations" into [(assoc-in protected-base ["members" 0 "visibility"] "private") protected-child])
  (update doc "declarations" into [control (alias "InstanceNotStatic" {"op" "typeof" "name" "SelfClass.self"})])
  (update doc "declarations" into [(assoc control "members" [(assoc (method "guard" {"op" "predicate" "name" "this" "datatype" (ref "SelfClass")}) "static" true)])])])
(def extra-refusals
 [(replace-service (update service "members" conj (assoc (method "shadow" {"op" "typeof" "name" "Service.config"}) "params" [{"name" "Service" "optional" false "rest" false "datatype" (kw "number")}])))
  (update doc "declarations" (fn [ds] (mapv #(if (= "symbols" (get % "name")) (assoc % "datatype" {"op" "typeof" "name" "symbols"}) %) ds)))])
(def all-refusals (into refusals extra-refusals))
(doseq [bad all-refusals] (refused #(emit/compile-document bad runtime) "Bad class/type declaration admitted"))
(println (str "Class declarations:" (count all-refusals) " shape/scope/visibility/heritage/overload/variance/unique/this/budget refusals."))
(def dir (fs/mkdtempSync "/tmp/mithril-class-types-"))
(try
 (fs/writeFileSync (str dir "/offline.edn") "{:paths [\"src\"]}\n")
 (fs/writeFileSync (str dir "/controls.d.mts") (:source control-artifact))
 (doseq [target ["js" "js-browser"]]
  (let [folder (str dir "/" target) output (str folder "/index.d.mts") config (str dir "/offline.edn")]
   (fs/writeFileSync (str folder ".json") (run [engine "--config" config "-cp" "src" "bin/mithril-native-esm.cljk" "examples/native-js-cordis-service-utils-esm.mith" "--target" target "--output-directory" folder]))
   (run [engine "--config" config "-cp" "src" "bin/mithril-native-declarations.cljk" "examples/native-js-cordis-service-utils-declarations.mith" "--target" target "--output" output])
   (ensure (= (:source artifact) (fs/readFileSync output "utf8")) "Class declaration CLI differs from checked artifact")
   (run ["test/qualification/native-class-declarations/controls/type-contract.mjs" output compiler type-roots (str dir "/controls.d.mts") (str folder "/index.mjs") (str folder ".json")])))
 (finally (fs/rmSync dir #js {:recursive true :force true})))
