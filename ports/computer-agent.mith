(mithril/agent-harness
  :id "https://mithril.fund/port/deepseek/computer-v1"
  :goal "Inspect the available desktop applications, then finish after the host confirms the observation."
  :max-steps 3 :max-calls 1 :confidence-floor 6000 :finish-facts ["apps-observed"]
  :plugins [(mithril/plugin :id "computer" :requires []
    :tools [(mithril/tool :id "observe-apps" :operation "computer/list-apps"
             :requires [] :provides ["apps-observed"])])])
