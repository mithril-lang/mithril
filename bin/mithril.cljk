(ns mithril.cli
  (:require [mithril.compiler :as compiler]
            [mithril.bot :as bot]
            [mithril.desktop :as desktop]
            [mithril.hermes-fleet :as fleet]
            [mithril.reason-cli :as reason-cli]
            [mithril.codegraph-cli :as codegraph-cli]
            [mithril.language :as language]
            [mithril.twin-sim :as twin]
            [mithril.web :as web]))

(defn- usage! []
  (println "usage:")
  (println "  mithril compile <program.mith|program.mithril>")
  (println "  mithril compile-language")
  (println "  mithril compile-trace <program.mith|program.mithril>")
  (println "  mithril compile-ontology <ontology.mith|ontology.mithril>")
  (println "  mithril compile-library <library.mith|library.mithril>")
  (println "  mithril compile-bot <profile.mith|profile.mithril>")
  (println "  mithril compile-desktop <app.mith|app.mithril>")
  (println "  mithril compile-hermes-profile <profile.mith|profile.mithril>")
  (println "  mithril emit-desktop <app.mith|app.mithril>")
  (println "  mithril compile-web <app.mith|app.mithril> <library.mith>...")
  (println "  mithril request <app.mith|app.mithril> <library.mith> <METHOD> <PATH>")
  (println "  mithril twin <twin-service.mith> <service> <METHOD> <PATH> [body]")
  (println "  mithril reason <ontology.mith> <data.(mith|nq|nt|jsonld)> [--query-type <iri>] [--save-mith <result.mith>] [--json]")
  (println "  mithril codegraph <compile|index|query|reason|verify|evidence|serve|ui|web> [repository-root] [JSON request|--rebuild]")
  (js/process.exit 2))

(defn- keyword-string [x]
  (if-let [ns (namespace x)] (str ns "/" (name x)) (name x)))

(defn- json-safe [x]
  (cond
    (keyword? x) (keyword-string x)
    (map? x) (into {} (map (fn [[k v]] [(if (keyword? k) (keyword-string k) k)
                                         (json-safe v)]) x))
    (vector? x) (mapv json-safe x)
    (set? x) (mapv json-safe (sort-by pr-str x))
    :else x))

(defn- read-text [path]
  (.readFileSync (js/require "fs") path "utf8"))

(defn- compile-library [path]
  (compiler/compile-library-text path (read-text path)))

(defn- compile-web [path library-paths]
  (compiler/compile-web-text path
                             (read-text path)
                             (mapv compile-library library-paths)))

(defn- print-json [value]
  (println (.stringify js/JSON (clj->js (json-safe value)) nil 2)))

(let [[command path & args] *command-line-args*]
  (try
    (let [kernel (language/load!)]
      (language/admit-entrypoint! kernel command)
      (case command
        "compile-language"
        (if (and (nil? path) (empty? args)) (print-json kernel) (usage!))

        "compile"
        (if (and path (empty? args))
          (print-json (language/compile-program kernel path (read-text path)))
          (usage!))

        "compile-trace"
        (if (and path (empty? args))
          (print-json (language/run-compiler kernel path (read-text path)))
          (usage!))

        "compile-ontology"
        (if (and path (empty? args))
          (print-json (compiler/compile-ontology-text path (read-text path)))
          (usage!))

        "compile-library"
        (if (and path (empty? args))
          (print-json (compile-library path))
          (usage!))

        "compile-bot"
        (if (and path (empty? args))
          (print-json (bot/compile-text path (read-text path)))
          (usage!))

        "compile-desktop"
        (if (and path (empty? args))
          (print-json (desktop/compile-text path (read-text path)))
          (usage!))

        "compile-hermes-profile"
        (if (and path (empty? args))
          (print-json (fleet/compile-text path (read-text path)))
          (usage!))

        "emit-desktop"
        (if (and path (empty? args))
          (print (desktop/emit-plugin (desktop/compile-text path (read-text path))))
          (usage!))

        "compile-web"
        (if (and path (seq args))
          (print-json (compile-web path args))
          (usage!))

        "reason"
        (reason-cli/run! path args)

        "codegraph"
        (codegraph-cli/run! path args)

        "request"
        (let [[library-path method request-path & extra] args]
          (if (and path library-path method request-path (empty? extra))
            (print-json (web/dispatch (compile-web path [library-path])
                                      {:method method :path request-path}))
            (usage!)))

        "twin"
        (let [[service method request-path body & extra] args]
          (if (and path service method request-path (empty? extra))
            (print-json (twin/invoke (compiler/parse-source (read-text path))
                                     (cond-> {:service service
                                              :method method
                                              :path request-path}
                                       body (assoc :body body))))
            (usage!)))

        (usage!)))
    (catch :default e
      (println (str "REFUSE\t" (or (some-> e ex-data :mithril/error name) "compile-error")
                    "\t" (.-message e)))
      (js/process.exit 1))))
