(ns mithril.native-package-cli
 (:require [mithril.native-package :as package] ["node:fs" :as fs] ["node:path" :as path]))
(let [[source flag target out-flag output & extra] *command-line-args*]
 (when-not (and source (= flag "--target") (= out-flag "--output") output (empty? extra))
  (js/console.error "usage: mithril-native-package <package.mith> --target js|js-browser --output <library.mjs>")
  (js/process.exit 64))
 (when-not (contains? #{"js" "js-browser"} target)
  (js/console.error "REFUSE\tnative-package-target\tNative packages require target js or js-browser")
  (js/process.exit 65))
 (try
  (let [text (fs/readFileSync source "utf8") names (package/source-basenames text)
        directory (path/dirname (path/resolve source))
        sources (into {} (map (fn [name]
                               (let [file (path/join directory name) stat (fs/lstatSync file)]
                                (when-not (and (.isFile stat) (not (.isSymbolicLink stat)) (<= (.-size stat) 1048576))
                                 (throw (ex-info "Expected bounded regular Mithril source" {:mithril/error :mithril.native-package/source})))
                                [name (fs/readFileSync file "utf8")])) names))
        result (package/compile-library-text text sources)]
   ;; Complete manifest, graph and leaf admission precedes the first write.
   (fs/writeFileSync output (:source result))
   (println (js/JSON.stringify (clj->js (assoc (dissoc result :source) :target target :output output)))))
  (catch :default e
   (js/console.error (str "REFUSE\t" (or (some-> e ex-data :mithril/error name) "compile-error") "\t" (.-message e)))
   (js/process.exit 65))))
