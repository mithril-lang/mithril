#!/usr/bin/env kbb
(ns mithril.agent-cli
  (:require [mithril.generated-runner :as runner] [mithril.patch :as patch]))
(let [[mode task-file manifest directory hy model-dir adapter output & extra] *command-line-args*
      fs (js/require "node:fs") controller (js/AbortController.)
      abort! (fn [] (.abort controller))]
  (when-not (and (contains? #{"generate" "resume" "reconcile"} mode)
                task-file manifest directory hy model-dir adapter output (empty? extra))
    (println "usage: mithril-agent generate|resume|reconcile task.json kernel-manifest session-dir hy model-dir adapter-root output.json")
    (js/process.exit 2))
  (.on js/process "SIGINT" abort!)
  (.on js/process "SIGTERM" abort!)
  (-> (runner/run! {:mode mode :task (patch/read-task (.readFileSync fs task-file "utf8"))
                    :manifest manifest :directory directory :hy hy :model-dir model-dir :adapter adapter :output output
                    :kind (or (.-MITHRIL_GENERATOR_KIND js/process.env) "clef") :signal (.-signal controller)
                    :profile-file (.-MITHRIL_AGENT_PROFILE js/process.env)})
      (.then (fn [{:keys [receipt]}]
               (println (pr-str {:status (:status receipt) :receipt output :wall-ms (:wall-ms receipt)}))
               (when (= "refused" (:status receipt)) (set! (.-exitCode js/process) 1))))
      (.catch (fn [e] (.write (.-stderr js/process) (str e "\n")) (set! (.-exitCode js/process) 1)))
      (.finally (fn [] (.off js/process "SIGINT" abort!) (.off js/process "SIGTERM" abort!)))))
