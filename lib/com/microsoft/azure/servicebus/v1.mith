(mithril/component
  :id "https://mithril.fund/lib/com/microsoft/azure/servicebus/v1"
  :domain "com.microsoft.azure.servicebus"
  :version 1
  :provides ["queue"]
  :requires ["fund.mithril.authz" "fund.mithril.quota" "fund.mithril.fault"]
  :exports [(mithril/export
              :symbol "https://mithril.fund/lib/com/microsoft/azure/servicebus/v1/store/send"
              :kind "mith:store"
              :label "record a Service Bus send without delivering it"
              :confidence-floor 6000)])
