(ns fund.mithril.lib.interop (:export [library-id library-iri accepts request]))
(defn library-id [] :string "fund.mithril.lib.interop")
(defn library-iri [] :string "https://mithril.fund/lib/fund.mithril.lib.interop")
(defn accepts [member :string] :i64 (if (= (string-compare member "plugins") 0) 1 (if (= (string-compare member "resolve-library") 0) 1 0)))
(defn request [member :string arguments-json :string] :string
  (if (= (accepts member) 1)
    (string-concat "{\"operation\":\"library-call\",\"libraryId\":\"fund.mithril.lib.interop\",\"member\":\""
      (string-concat member (string-concat "\",\"arguments\":" (string-concat arguments-json "}"))))
    "{\"operation\":\"invalid-library-member\"}"))
