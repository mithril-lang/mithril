(ns fund.mithril.lib.siso.msdl (:export [library-id library-iri accepts request]))
(defn library-id [] :string "fund.mithril.lib.siso.msdl")
(defn library-iri [] :string "https://mithril.fund/lib/fund.mithril.lib.siso.msdl")
(defn accepts [member :string] :i64 (if (= (string-compare member "msdl-import") 0) 1 (if (= (string-compare member "msdl-project") 0) 1 0)))
(defn request [member :string arguments-json :string] :string
  (if (= (accepts member) 1)
    (string-concat "{\"operation\":\"library-call\",\"libraryId\":\"fund.mithril.lib.siso.msdl\",\"member\":\""
      (string-concat member (string-concat "\",\"arguments\":" (string-concat arguments-json "}"))))
    "{\"operation\":\"invalid-library-member\"}"))
