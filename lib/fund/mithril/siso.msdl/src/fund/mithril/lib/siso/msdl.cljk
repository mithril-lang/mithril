(ns fund.mithril.lib.siso.msdl
  (:refer-clojure :exclude [resolve])
  (:require [fund.mithril.lib.interop :as host]))
(def library-id "fund.mithril.lib.siso.msdl")
(def operations #{"msdl-import" "msdl-project"})
(defn resolve [transport] (host/resolve-library transport library-id))
(defn invoke! [transport member arguments]
  (host/invoke-library transport library-id operations member arguments))
